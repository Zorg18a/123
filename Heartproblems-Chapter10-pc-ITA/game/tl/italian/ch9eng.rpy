    a "È per il tuo bene, [mc]. Non sono una persona di cui puoi innamorarti, mi dispiace."

# game/ch9eng.rpy:583
translate italian ch9afterlose_e83f56ba:

    # mc "But, everything we've done, was it all for nothing?"
    mc "Ma tutto quello che abbiamo fatto è stato inutile?"

# game/ch9eng.rpy:584
translate italian ch9afterlose_9d94ef06:

    # a "I think there was a misunderstanding on your part, I..."
    a "Penso che ci sia stato un malinteso da parte tua, io..."

# game/ch9eng.rpy:585
translate italian ch9afterlose_0ecee7f6:

    # a "I wasn't trying to make you love me, and that was obvious!"
    a "Non stavo cercando di farmi amare da te, e questo era ovvio!"

# game/ch9eng.rpy:586
translate italian ch9afterlose_462083da:

    # a "I thought you understood that."
    a "Pensavo che avessi capito."

# game/ch9eng.rpy:587
translate italian ch9afterlose_c0d266cc:

    # a "If I let this continue, it'll only hurt you more. Find someone your age who can love you like I can't."
    a "Se lascio che questo continui, ti farà solo più male. Trova qualcuno della tua età che sappia amarti come non so fare io."

# game/ch9eng.rpy:588
translate italian ch9afterlose_f87bce6e:

    # mc "[arelay!cl] [a], no—"
    mc "[arelay!cl] [a], no—"

# game/ch9eng.rpy:589
translate italian ch9afterlose_7eacbc28:

    # a "We agreed I'd always be your [arelat] no matter what, and that will never change."
    a "Avevamo concordato che sarei sempre stato il tuo [arelat], qualunque cosa accadesse, e questo non cambierà mai."

# game/ch9eng.rpy:591
translate italian ch9afterlose_5af60f61:

    # centered "{size=+25}You ruined it."
    centered "{size=+25}L'hai rovinato."

# game/ch9eng.rpy:592
translate italian ch9afterlose_5da613c6:

    # centered "{size=+25}Think more carefully before speaking next time."
    centered "{size=+25}La prossima volta pensaci più attentamente prima di parlare."

# game/ch9eng.rpy:595
translate italian ch9afterlose_2dafe6e3:

    # mc "(Did I really say something like that last night?)"
    mc "(Ho davvero detto una cosa del genere ieri sera?)"

# game/ch9eng.rpy:596
translate italian ch9afterlose_7f2a88f7:

    # mc "(And what the hell do I say now?)"
    mc "(E adesso cosa diavolo dico?)"

# game/ch9eng.rpy:600
translate italian ch9bforelose_a20cefa7:

    # "..."
    "..."

# game/ch9eng.rpy:603
translate italian ch9bforelose_49968553:

    # mc "{i}I want a kiss!"
    mc "{i}Voglio un bacio!"

# game/ch9eng.rpy:604
translate italian ch9bforelose_09db9eaf:

    # a "Huh?"
    a "Cosa?"

# game/ch9eng.rpy:605
translate italian ch9bforelose_06c732f3:

    # mc "My good morning kiss. I demand my daily kiss."
    mc "Il mio bacio del buongiorno. Esigo il mio bacio quotidiano."

# game/ch9eng.rpy:607
translate italian ch9bforelose_770ed5e8:

    # a "Oh, ha-ha... Of course."
    a "Oh, ah-ah... Certo."

# game/ch9eng.rpy:608
translate italian ch9bforelose_7961f66a:

    # a "A quick one."
    a "Una veloce."

# game/ch9eng.rpy:611
translate italian ch9bforelose_087c3479:

    # a "*Hmmn*..."
    a " * Hmmm * ..."

# game/ch9eng.rpy:614
translate italian ch9bforelose_2825d45a:

    # a "*Smooch* There you go."
    a " * Smooch * Ecco fatto."

# game/ch9eng.rpy:617
translate italian ch9bforelose_b2beb584:

    # a "Now go get ready, you're going to the beach with the girls and [d], right?"
    a "Ora preparati, vai in spiaggia con le ragazze e [d], giusto?"

# game/ch9eng.rpy:618
translate italian ch9bforelose_9140a479:

    # mc "Are you going?"
    mc "Vai?"

# game/ch9eng.rpy:619
translate italian ch9bforelose_d4746ad5:

    # a "I don't think so."
    a "Non credo proprio."

# game/ch9eng.rpy:620
translate italian ch9bforelose_9489b5c8:

    # mc "If you don't go, neither will I."
    mc "Se non ci vai tu, non ci andrò neanche io."

# game/ch9eng.rpy:621
translate italian ch9bforelose_7e728bc8:

    # a "[mc], you know how things are with [d] and me."
    a "[mc], sai come vanno le cose tra me e [d]."

# game/ch9eng.rpy:622
translate italian ch9bforelose_0cf5f0b0:

    # a "I’d rather avoid a fight for everyone’s sake."
    a "Preferirei evitare di litigare per il bene di tutti."

# game/ch9eng.rpy:623
translate italian ch9bforelose_41d29b76:

    # a "Remember what happened on the yacht?"
    a "Ricordi cosa è successo sullo yacht?"

# game/ch9eng.rpy:624
translate italian ch9bforelose_43038ec2:

    # a "I ruined everyone's afternoon."
    a "Ho rovinato il pomeriggio a tutti."

# game/ch9eng.rpy:625
translate italian ch9bforelose_ab99f7be:

    # mc "{i}{size=-2}It was [drelat] [d] who ruined it by forcing you to dance with him."
    mc "{i}{size=-2}È stato [drelat] [d] a rovinare tutto costringendoti a ballare con lui."

# game/ch9eng.rpy:626
translate italian ch9bforelose_86ffa2ff:

    # mc "Besides, we went out for dinner yesterday, and everything went fine, didn't it?"
    mc "Inoltre, ieri siamo usciti a cena ed è andato tutto bene, non è vero?"

# game/ch9eng.rpy:627
translate italian ch9bforelose_4f0ea6ae:

    # a "Yeah, but... you know, honey... things are still complicated."
    a "Sì, ma... sai, tesoro... le cose sono ancora complicate."

# game/ch9eng.rpy:629
translate italian ch9bforelose_334c831a:

    # mc "If you're not going, then I'll stay here with you."
    mc "Se non te ne vai, resterò qui con te."

# game/ch9eng.rpy:630
translate italian ch9bforelose_f72f777d:

    # a "No, [mc], you're not skipping a day at the beach just to stay with me."
    a "No, [mc], non salterai un giorno in spiaggia solo per stare con me."

# game/ch9eng.rpy:631
translate italian ch9bforelose_5aca6dde:

    # mc "It's not like staying with you means being bored."
    mc "Non è che stare con te significhi annoiarsi."

# game/ch9eng.rpy:633
translate italian ch9bforelose_de8afafe:

    # mc "I'm sure we'll have a good time alone at home."
    mc "Sono sicuro che ci divertiremo molto a casa, da soli."

# game/ch9eng.rpy:636
translate italian ch9bforelose_1b24e2c2:

    # mc "{i}{size=-5}I can't wait for everyone to leave..."
    mc "{i}{size=-5}Non vedo l'ora che tutti se ne vadano..."

# game/ch9eng.rpy:637
translate italian ch9bforelose_698e2e8e:

    # a "Stop, honey..."
    a "Fermati, tesoro..."

# game/ch9eng.rpy:639
translate italian ch9bforelose_413cbecb:

    # a "So that's your plan..."
    a "Quindi questo è il tuo piano..."

# game/ch9eng.rpy:640
translate italian ch9bforelose_534c623d:

    # mc "Yes, it's my master plan."
    mc "Sì, è il mio piano generale."

# game/ch9eng.rpy:641
translate italian ch9bforelose_4560b14d:

    # a "Well, if you stay, there'll be none of that."
    a "Beh, se resti, non ci sarà niente di tutto questo."

# game/ch9eng.rpy:642
translate italian ch9bforelose_71253346:

    # mc "None of what?"
    mc "Niente di tutto ciò?"

# game/ch9eng.rpy:643
translate italian ch9bforelose_0d0b383d:

    # a "You know what."
    a "Sai cosa?"

# game/ch9eng.rpy:644
translate italian ch9bforelose_b462047f:

    # mc "Aww..."
    mc "Ohhh..."

# game/ch9eng.rpy:646
translate italian ch9bforelose_62949dc7:

    # mc "I don't care."
    mc "Non mi interessa."

# game/ch9eng.rpy:647
translate italian ch9bforelose_3b37746e:

    # a "You're not getting your way, [mc]. I know what you're thinking."
    a "Non stai ottenendo ciò che vuoi, [mc]. So cosa stai pensando."

# game/ch9eng.rpy:648
translate italian ch9bforelose_aa19fc6a:

    # a "Go to the beach, sweetheart. I don't want you missing out because of me."
    a "Vai in spiaggia, tesoro. Non voglio che tu ti perda qualcosa per colpa mia."

# game/ch9eng.rpy:649
translate italian ch9bforelose_25ddef77:

    # mc "I don't want to leave you here alone."
    mc "Non voglio lasciarti qui da solo."

# game/ch9eng.rpy:650
translate italian ch9bforelose_360a5b6d:

    # a "It doesn't matter, love. If you don’t go, I’ll feel like some kind of villain."
    a "Non importa, amore. Se non te ne vai, mi sentirò una specie di cattivo."

# game/ch9eng.rpy:651
translate italian ch9bforelose_065fd7eb:

    # a "I don't want [d] thinking I'm turning you all against him or something."
    a "Non voglio che [d] pensi che vi sto mettendo tutti contro di lui o qualcosa del genere."

# game/ch9eng.rpy:652
translate italian ch9bforelose_ccce457f:

    # mc "Then come with us."
    mc "Allora vieni con noi."

# game/ch9eng.rpy:656
translate italian ch9bforelose_4e0f98ef:

    # "Let's see... there's nothing here!"
    "Vediamo... qui non c'è niente!"

# game/ch9eng.rpy:657
translate italian ch9bforelose_52c61a25:

    # s "[arelatks!cl], don't we have any ice cubes?"
    s "[arelatks!cl], non abbiamo cubetti di ghiaccio?"

# game/ch9eng.rpy:658
translate italian ch9bforelose_cd6d4361:

    # a "What do you need ice for?"
    a "A cosa ti serve il ghiaccio?"

# game/ch9eng.rpy:659
translate italian ch9bforelose_5cee6406:

    # s "For [drelatks]'s beers. He said we needed ice."
    s "Per le birre di [drelatks]. Ha detto che ci serviva del ghiaccio."

# game/ch9eng.rpy:660
translate italian ch9bforelose_860499a9:

    # s "Here they are, only five cubes left, but I guess that'll do."
    s "Eccoli qui, ne sono rimasti solo cinque, ma credo che bastino."

# game/ch9eng.rpy:662
translate italian ch9bforelose_3651c055:

    # s "And what are you two doing, just standing there watching?"
    s "E voi due cosa fate, ve ne state lì a guardare?"

# game/ch9eng.rpy:663
translate italian ch9bforelose_17fca4cc:

    # s "Come on, get ready!"
    s "Forza, preparati!"

# game/ch9eng.rpy:664
translate italian ch9bforelose_a57d2bcd:

    # s "[mc], put on some shorts, and [arelatks], put on a swimsuit, because we're heading to the beach."
    s "[mc], mettiti degli shorts e [arelatks], mettiti un costume da bagno, perché andiamo in spiaggia."

# game/ch9eng.rpy:665
translate italian ch9bforelose_a0f10e5d:

    # a "Sweetheart, I think I have a bit of a headache and—"
    a "Tesoro, credo di avere un po' di mal di testa e..."

# game/ch9eng.rpy:667
translate italian ch9bforelose_f7386571:

    # s "Oh, [arelatks], don’t tell me you’re not coming with us again."
    s "Oh, [arelatks], non dirmi che non verrai più con noi."

# game/ch9eng.rpy:668
translate italian ch9bforelose_18dd7ffd:

    # s "Even [mc] is going."
    s "Anche [mc] ci va."

# game/ch9eng.rpy:669
translate italian ch9bforelose_fdf4fa6a:

    # s "Whatever, we're leaving. Anyone who wants to come, get ready fast."
    s "Comunque, ce ne andiamo. Chiunque voglia venire, si prepari in fretta."

# game/ch9eng.rpy:671
translate italian ch9bforelose_4c6c67db:

    # s "Where's the beer?"
    s "Dov'è la birra?"

# game/ch9eng.rpy:672
translate italian ch9bforelose_549bc5e9:

    # a "At the bottom."
    a "In basso."

# game/ch9eng.rpy:673
translate italian ch9bforelose_4d1227f0:

    # s "At the bottom where?"
    s "In fondo dove?"

# game/ch9eng.rpy:675
translate italian ch9bforelose_2f3b04a5:

    # s "I couldn’t find your beers, but I brought juice, [drelatks]!"
    s "Non sono riuscito a trovare le tue birre, ma ho portato del succo, [drelatks]!"

# game/ch9eng.rpy:676
translate italian ch9bforelose_d4a495c2:

    # d "They should be there!"
    d "Dovrebbero essere lì!"

# game/ch9eng.rpy:677
translate italian ch9bforelose_b0d1c0c9:

    # s "Well, they're not!"
    s "Beh, non lo sono!"

# game/ch9eng.rpy:681
translate italian ch9bforelose_f4b071f1:

    # a "She looks so cute in her sun hat."
    a "È così carina con il suo cappello da sole."

# game/ch9eng.rpy:682
translate italian ch9bforelose_55bc40fd:

    # mc "Yeah, haha."
    mc "Sì, ahah."

# game/ch9eng.rpy:683
translate italian ch9bforelose_bcce5f81:

    # mc "Come on, [a], we’ll have a great time."
    mc "Forza [a], ci divertiremo un mondo."

# game/ch9eng.rpy:686
translate italian ch9bforelose_149ad4d3:

    # d "See, they were here! I told you, they were at the bottom of the fridge!"
    d "Vedi, erano qui! Te l'avevo detto, erano in fondo al frigo!"

# game/ch9eng.rpy:688
translate italian ch9bforelose_d8c9e312:

    # d "And those beers and juices won't fit in that tiny cooler!"
    d "E quelle birre e quei succhi non entreranno in quella piccola borsa frigo!"

# game/ch9eng.rpy:689
translate italian ch9bforelose_7951de38:

    # s "Where’s the big cooler?!"
    s "Dov'è il grande frigorifero?!"

# game/ch9eng.rpy:690
translate italian ch9bforelose_6368c80d:

    # d "In the garage, I already told you!"
    d "Nel garage, te l'ho già detto!"

# game/ch9eng.rpy:691
translate italian ch9bforelose_2ea71d90:

    # s "The only one in the garage was this one!"
    s "L'unica nel garage era questa!"

# game/ch9eng.rpy:693
translate italian ch9bforelose_0c9f6098:

    # d "Sweetheart, didn’t the girls tell you we're going to the beach?"
    d "Tesoro, le ragazze non ti hanno detto che andiamo in spiaggia?"

# game/ch9eng.rpy:694
translate italian ch9bforelose_048b25dc:

    # a "No, they told me, it’s just that I have a bit of a headache and don’t feel well in general."
    a "No, mi hanno detto, è solo che ho un po' di mal di testa e in generale non mi sento bene."

# game/ch9eng.rpy:695
translate italian ch9bforelose_af0a2cc8:

    # d "Love, we're all going. You're not staying home alone, are you?"
    d "Amore, ce ne andiamo tutti. Non resterai a casa da solo, vero?"

# game/ch9eng.rpy:697
translate italian ch9bforelose_f33f474e:

    # d "You have to come with us, [a]."
    d "Devi venire con noi, [a]."

# game/ch9eng.rpy:698
translate italian ch9bforelose_d8e01656:

    # d "What happened last time on the yacht... nothing like that will happen again."
    d "Ciò che è accaduto l'ultima volta sullo yacht... non accadrà mai più."

# game/ch9eng.rpy:699
translate italian ch9bforelose_16a776a2:

    # d "I'm committed to making sure everyone has a good time."
    d "Il mio impegno è garantire che tutti si divertano."

# game/ch9eng.rpy:700
translate italian ch9bforelose_cda95ed8:

    # a "[d], no. That’s not it."
    a "[d], no. Non è questo."

# game/ch9eng.rpy:701
translate italian ch9bforelose_9c1f9882:

    # d "I'm serious, love. Plus, it would be good for the girls, and for [mc]."
    d "Dico sul serio, tesoro. Inoltre, farebbe bene alle ragazze e a [mc]."

# game/ch9eng.rpy:702
translate italian ch9bforelose_1b65f83f:

    # d "I want to give them a happy memory of all of us together."
    d "Voglio lasciare loro un ricordo felice di tutti noi insieme."

# game/ch9eng.rpy:703
translate italian ch9bforelose_b9775b58:

    # d "What do you say, love?"
    d "Che ne dici, amore?"

# game/ch9eng.rpy:706
translate italian ch9bforelose_bcb0eefd:

    # mc "It's not the same without you, [arelat] [a]."
    mc "Non è la stessa cosa senza di te, [arelat] [a]."

# game/ch9eng.rpy:707
translate italian ch9bforelose_bec77bc1:

    # d "Exactly."
    d "Esattamente."

# game/ch9eng.rpy:708
translate italian ch9bforelose_f3817ca6:

    # mc "Imagine this: a little umbrella, a couple of juices, and chatting about anything..."
    mc "Immagina questo: un piccolo ombrello, un paio di succhi di frutta e chiacchiere su qualsiasi cosa..."

# game/ch9eng.rpy:709
translate italian ch9bforelose_7029af93:

    # mc "Or sunbathing at the beach, with sunscreen! Let’s not forget the sunscreen, please, haha."
    mc "Oppure prendere il sole in spiaggia, con la crema solare! Non dimentichiamo la crema solare, per favore, haha."

# game/ch9eng.rpy:710
translate italian ch9bforelose_eabd876b:

    # mc "Doesn't that sound nice?"
    mc "Non ti sembra una buona idea?"

# game/ch9eng.rpy:712
translate italian ch9bforelose_181faef3:

    # a "Alright, you convinced me, *giggles*."
    a "Va bene, mi hai convinto, * ridacchia * ."

# game/ch9eng.rpy:713
translate italian ch9bforelose_a469d750:

    # a "I’ll take an ibuprofen and get ready."
    a "Prenderò un ibuprofene e mi preparerò."

# game/ch9eng.rpy:714
translate italian ch9bforelose_969aad02:

    # d "I’m so glad, dear. We’re going to have a great time, you’ll see."
    d "Sono così felice, cara. Ci divertiremo un mondo, vedrai."

