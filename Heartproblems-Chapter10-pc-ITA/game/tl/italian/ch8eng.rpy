    # a "*Exhales*"
    a "*Espira*"

# game/ch8eng.rpy:9273
translate italian ch8stasda_96d5ed0c:

    # "{size=+10}{color=#82C200}Instructor:{/color}{/size} And lunch break is at ten and one o'clock depending on the sector you're working in, but with me it's at that time."
    "{size=+10}{color=#82C200}Istruttore:{/color}{/size} E la pausa pranzo è alle dieci e all'una a seconda del settore in cui lavori, ma con me è a quell'ora."

# game/ch8eng.rpy:9274
translate italian ch8stasda_6d2fb909:

    # "{size=+10}{color=#82C200}Instructor:{/color}{/size} You can come here or go wherever you want, you'll have thirty minutes and then you'll have to go back to your posts."
    "{size=+10}{color=#82C200}Istruttore:{/color}{/size} Puoi venire qui o andare dove vuoi, avrai trenta minuti e poi dovrai tornare ai tuoi posti."

# game/ch8eng.rpy:9275
translate italian ch8stasda_6be82cd3:

    # "{size=+10}{color=#82C200}Instructor:{/color}{/size} Any questions?"
    "{size=+10}{color=#82C200}Istruttore:{/color}{/size} Hai qualche domanda?"

# game/ch8eng.rpy:9277
translate italian ch8stasda_428adb4b:

    # "Sorry, where can I check the bus routes again?"
    "Non ho capito, dove posso controllare nuovamente i percorsi degli autobus?"

# game/ch8eng.rpy:9278
translate italian ch8stasda_d06c1511:

    # "{size=+10}{color=#82C200}Instructor:{/color}{/size} There's a big sign in human resources where you can check that out."
    "{size=+10}{color=#82C200}Istruttore:{/color}{/size} C'è un grande cartello nelle risorse umane dove puoi verificarlo."

# game/ch8eng.rpy:9279
translate italian ch8stasda_54c640a2:

    # "Thank you."
    "Grazie."

# game/ch8eng.rpy:9280
translate italian ch8stasda_a1a5fc51:

    # "{size=+10}{color=#82C200}Instructor:{/color}{/size} Alright, I'll leave for now while the urine tests finish. You can go to the bathroom and do whatever you want."
    "{size=+10}{color=#82C200}Istruttore:{/color}{/size} Va bene, per ora me ne vado mentre finiscono i test delle urine. Puoi andare in bagno e fare quello che vuoi."

# game/ch8eng.rpy:9283
translate italian ch8stasda_6e867714:

    # mc "(Ugh, waiting again...)"
    mc "(Ugh, aspetto ancora...)"

# game/ch8eng.rpy:9284
translate italian ch8stasda_b8a7705e:

    # "*Beep*"
    "*Bip*"

# game/ch8eng.rpy:9302
translate italian ch8hasd_7c8708bd:

    # mc "(Oh.)"
    mc "(OH.)"

# game/ch8eng.rpy:9326
translate italian ch8hasd_0c301f25:

    # "{size=+10}{color=#82C200}Instructor:{/color}{/size} And when the trailers arrive, the forklift drivers will do the rest."
    "{size=+10}{color=#82C200}Istruttore:{/color}{/size} E quando arrivano i rimorchi, i conducenti dei carrelli elevatori faranno il resto."

# game/ch8eng.rpy:9327
translate italian ch8hasd_bbbeab03:

    # "{size=+10}{color=#82C200}Instructor:{/color}{/size} Any more questions?"
    "{size=+10}{color=#82C200}Istruttore:{/color}{/size} Altre domande?"

# game/ch8eng.rpy:9328
translate italian ch8hasd_43c60ff1:

    # "{size=+10}{color=#82C200}Instructor:{/color}{/size} Great."
    "{size=+10}{color=#82C200}Istruttore:{/color}{/size} Fantastico."

# game/ch8eng.rpy:9330
translate italian ch8hasd_f064e68f:

    # "{size=+10}{color=#82C200}Instructor:{/color}{/size} It's hard work but there are opportunities for growth."
    "{size=+10}{color=#82C200}Istruttore:{/color}{/size} È un lavoro duro ma ci sono opportunità di crescita."

# game/ch8eng.rpy:9331
translate italian ch8hasd_de795613:

    # "{size=+10}{color=#82C200}Instructor:{/color}{/size} We're a new warehouse and we're short-staffed in almost all areas, so if you put in effort and learn, you could get a promotion."
    "{size=+10}{color=#82C200}Istruttore:{/color}{/size} Siamo un nuovo magazzino e siamo a corto di personale in quasi tutte le aree, quindi se ti impegni e impari, potresti ottenere una promozione."

# game/ch8eng.rpy:9332
translate italian ch8hasd_8d21abe2:

    # "{size=+10}{color=#82C200}Instructor:{/color}{/size} It's up to you."
    "{size=+10}{color=#82C200}Istruttore:{/color}{/size} Dipende da te."

# game/ch8eng.rpy:9334
translate italian ch8hasd_037ac442:

    # "{size=+10}{color=#82C200}Instructor:{/color}{/size} That's all for today. It's almost time to leave."
    "{size=+10}{color=#82C200}Istruttore:{/color}{/size} Per oggi è tutto. È quasi ora di partire."

# game/ch8eng.rpy:9335
translate italian ch8hasd_13a01dac:

    # "{size=+10}{color=#82C200}Instructor:{/color}{/size} You'll be leaving on the morning schedule today, and tomorrow you'll start on the second schedule."
    "{size=+10}{color=#82C200}Istruttore:{/color}{/size} Oggi partirai con il programma mattutino e domani inizierai con il secondo programma."

# game/ch8eng.rpy:9336
translate italian ch8hasd_b9ec18b5:

    # "{size=+10}{color=#82C200}Instructor:{/color}{/size} By the way, today is also a paid day, so you'll receive your full paycheck on payday."
    "{size=+10}{color=#82C200}Istruttore:{/color}{/size} A proposito, oggi è anche un giorno retribuito, quindi riceverai l'intero stipendio il giorno dello stipendio."

# game/ch8eng.rpy:9337
translate italian ch8hasd_2c2d1b38:

    # "{size=+10}{color=#82C200}Instructor:{/color}{/size} Have a good afternoon, see you tomorrow."
    "{size=+10}{color=#82C200}Istruttore:{/color}{/size} Buon pomeriggio, a domani."

# game/ch8eng.rpy:9343
translate italian ch8hasd_fbd15729:

    # d "Hey, [mc], how did it go?"
    d "Ehi, [mc], com'è andata?"

# game/ch8eng.rpy:9345
translate italian ch8hasd_c16e4743:

    # mc "Good, today we saw some slides on a projector and they gave us a tour of the place."
    mc "Bene, oggi abbiamo visto delle diapositive su un proiettore e ci hanno fatto fare un giro del posto."

# game/ch8eng.rpy:9346
translate italian ch8hasd_f890b0bd:

    # mc "I only worked half a day."
    mc "Ho lavorato solo mezza giornata."

# game/ch8eng.rpy:9347
translate italian ch8hasd_91cf1182:

    # d "I see, so tomorrow the real work begins."
    d "Capisco, quindi domani inizia il vero lavoro."

# game/ch8eng.rpy:9348
translate italian ch8hasd_caf64924:

    # mc "Yes, tomorrow I'll start working later."
    mc "Sì, domani comincerò a lavorare più tardi."

# game/ch8eng.rpy:9349
translate italian ch8hasd_3deed7ed:

    # d "Really?"
    d "Veramente?"

# game/ch8eng.rpy:9350
translate italian ch8hasd_63aab3fd:

    # mc "I'll work from seven in the morning to seven in the evening, but then I'll have three days off."
    mc "Lavorerò dalle sette del mattino alle sette di sera, ma poi avrò tre giorni liberi."

# game/ch8eng.rpy:9351
translate italian ch8hasd_21bf17a8:

    # d "That's a lot of hours."
    d "Sono un sacco di ore."

# game/ch8eng.rpy:9352
translate italian ch8hasd_b708ce91:

    # mc "Yes, but I prefer having three days off instead of two."
    mc "Sì, ma preferisco avere tre giorni liberi invece di due."

# game/ch8eng.rpy:9353
translate italian ch8hasd_5943d70a:

    # d "Have you met your boss yet?"
    d "Hai già incontrato il tuo capo?"

# game/ch8eng.rpy:9354
translate italian ch8hasd_f800bed0:

    # mc "Yes."
    mc "SÌ."

# game/ch8eng.rpy:9355
translate italian ch8hasd_91c9c883:

    # d "And how was it?"
    d "E com'è andata?"

# game/ch8eng.rpy:9356
translate italian ch8hasd_9d6c079f:

    # mc "I don't know, he didn't seem like a bad person."
    mc "Non lo so, non sembrava una persona cattiva."

# game/ch8eng.rpy:9358
translate italian ch8hasd_ea86265e:

    # d "One advice, don't let anyone boss you around."
    d "Un consiglio: non permettere a nessuno di comandarti."

# game/ch8eng.rpy:9359
translate italian ch8hasd_6d4166a3:

    # d "Your dignity comes before anything else."
    d "La tua dignità viene prima di ogni altra cosa."

# game/ch8eng.rpy:9360
translate italian ch8hasd_b6067be5:

    # d "When I was a laborer in my first job, those who let themselves be manipulated never got anywhere."
    d "Quando ero operaio al mio primo lavoro, chi si lasciava manipolare non arrivava mai da nessuna parte."

# game/ch8eng.rpy:9361
translate italian ch8hasd_479d3310:

    # d "Of course you have to work hard, but always show character, autonomy, and leadership. Those are the things that owners look for."
    d "Ovviamente devi lavorare sodo, ma mostrare sempre carattere, autonomia e leadership. Queste sono le cose che i proprietari cercano."

# game/ch8eng.rpy:9363
translate italian ch8hasd_a1083b07:

    # mc "Thank you for the advice."
    mc "Grazie per il consiglio."

# game/ch8eng.rpy:9365
translate italian ch8hasd_33d9a4a8:

    # a "[mc], how did it go?"
    a "[mc], com'è andata?"

# game/ch8eng.rpy:9366
translate italian ch8hasd_6d957ea7:

    # a "Did you get the job?"
    a "Hai ottenuto il lavoro?"

# game/ch8eng.rpy:9367
translate italian ch8hasd_c27177f0:

    # mc "Yes, there wasn't even an interview. The hardest part was the drug test."
    mc "Sì, non c'è stata nemmeno un'intervista. La parte più difficile è stata il test antidroga."

# game/ch8eng.rpy:9368
translate italian ch8hasd_aca9c501:

    # a "Drug test?"
    a "Test anti droga?"

# game/ch8eng.rpy:9369
translate italian ch8hasd_0b7b20a0:

    # d "Yes, it's something that companies usually do."
    d "Sì, è qualcosa che di solito fanno le aziende."

# game/ch8eng.rpy:9370
translate italian ch8hasd_580df0b0:

    # a "I see."
    a "Vedo."

# game/ch8eng.rpy:9371
translate italian ch8hasd_d4e323d1:

    # a "You must be hungry, do you want me to prepare something to eat?"
    a "Devi avere fame, vuoi che ti prepari qualcosa da mangiare?"

# game/ch8eng.rpy:9372
translate italian ch8hasd_afdffd0d:

    # mc "Yes, please."
    mc "Sì grazie."

# game/ch8eng.rpy:9374
translate italian ch8hasd_5e784592:

    # d "Hey, and..."
    d "Ehi, e..."

# game/ch8eng.rpy:9375
translate italian ch8hasd_77b2298d:

    # d "If for any reason you don't want to work there anymore because they treat you badly or anything, even if you're just tired, don't worry."
    d "Se per qualsiasi motivo non vuoi più lavorare lì perché ti trattano male o altro, anche se sei solo stanco, non preoccuparti."

# game/ch8eng.rpy:9376
translate italian ch8hasd_c9ff0a88:

    # d "I don't need you to work."
    d "Non ho bisogno che tu lavori."

# game/ch8eng.rpy:9377
translate italian ch8hasd_43fc55b5:

    # d "Soon we'll have what we always dreamed of."
    d "Presto avremo ciò che abbiamo sempre sognato."

# game/ch8eng.rpy:9378
translate italian ch8hasd_1a9a021e:

    # d "As long as I'm here, no one will need to work unless they want to, of course."
    d "Finché sarò qui, nessuno avrà bisogno di lavorare a meno che non lo voglia, ovviamente."

# game/ch8eng.rpy:9379
