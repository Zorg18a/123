
# game/ch11xmaseng.rpy:14
translate italian ch11xmas_c0f62019:

    # d "Alright, let's see how our turkey turned out."
    d "Va bene, vediamo come è venuto il nostro tacchino."

# game/ch11xmaseng.rpy:15
translate italian ch11xmas_5122c897:

    # s "What do you mean our turkey? You didn't help at all. And I know you're about to serve yourself first."
    s "Cosa intendi con il nostro tacchino? Non sei stato d'aiuto per niente. E so che stai per servire te stesso per primo."

# game/ch11xmaseng.rpy:16
translate italian ch11xmas_a746b86c:

    # d "Oh yeah? And who turned on the oven?"
    d "O si? E chi ha acceso il forno?"

# game/ch11xmaseng.rpy:17
translate italian ch11xmas_6d853c17:

    # s "That doesn't count as cooking!"
    s "Questo non conta come cucinare!"

# game/ch11xmaseng.rpy:18
translate italian ch11xmas_e7025123:

    # d "But that's the most dangerous part!"
    d "Ma questa è la parte più pericolosa!"

# game/ch11xmaseng.rpy:19
translate italian ch11xmas_f5f1e92f:

    # mc "The turkey looks really good."
    mc "Il tacchino sembra davvero buono."

# game/ch11xmaseng.rpy:20
translate italian ch11xmas_e28936a3:

    # a "Yeah, I'm surprised myself. Last year it didn't turn out nearly this well."
    a "Sì, anch'io sono sorpreso. L'anno scorso le cose non sono andate così bene."

# game/ch11xmaseng.rpy:21
translate italian ch11xmas_187e6e7a:

    # mc "It wasn't bad, but this year you really nailed it."
    mc "Non è andata male, ma quest'anno ce l'hai fatta davvero."

# game/ch11xmaseng.rpy:22
translate italian ch11xmas_3e7eabc6:

    # k "-We nailed it."
    k "-Ce l'abbiamo fatta."

# game/ch11xmaseng.rpy:23
translate italian ch11xmas_e0a56064:

    # a "That's true, you girls helped me a lot."
    a "È vero, voi ragazze mi avete aiutato molto."

# game/ch11xmaseng.rpy:24
translate italian ch11xmas_cefe216f:

    # a "Alright, shall we eat?"
    a "Va bene, mangiamo?"

# game/ch11xmaseng.rpy:29
translate italian ch11xmas_394e351e:

    # k "I love you, Dad."
    k "Ti amo, papà."

# game/ch11xmaseng.rpy:30
translate italian ch11xmas_41a8bb94:

    # a "Merry Christmas, sweetheart."
    a "Buon Natale, tesoro."

# game/ch11xmaseng.rpy:31
translate italian ch11xmas_cac52510:

    # mc "Merry Christmas."
    mc "Buon Natale."

# game/ch11xmaseng.rpy:32
translate italian ch11xmas_6b39a0cc:

    # s "I wish you could spend more time at home."
    s "Vorrei che potessi passare più tempo a casa."

# game/ch11xmaseng.rpy:33
translate italian ch11xmas_93fee314:

    # d "Merry Christmas, my beautiful girls. That's my plan for the coming year."
    d "Buon Natale, mie bellissime ragazze. Questo è il mio piano per il prossimo anno."

# game/ch11xmaseng.rpy:34
translate italian ch11xmas_0a280ce8:

    # d "I promise I'll spend a lot more time with all of you."
    d "Prometto che passerò molto più tempo con tutti voi."

# game/ch11xmaseng.rpy:39
translate italian ch11xmas_ca4bf8cb:

    # s "Why can't we open the presents already...?"
    s "Perché non possiamo già aprire i regali...?"

# game/ch11xmaseng.rpy:40
translate italian ch11xmas_24d77339:

    # d "Tomorrow morning. Be patient."
    d "Domani mattina. Essere pazientare."

# game/ch11xmaseng.rpy:41
translate italian ch11xmas_7bc48af8:

    # s "But I can't wait..."
    s "Ma non vedo l'ora..."

# game/ch11xmaseng.rpy:42
translate italian ch11xmas_f9eaabcd:

    # s "You did get me what I asked for, right?"
    s "Mi hai dato quello che avevo chiesto, vero?"

# game/ch11xmaseng.rpy:43
translate italian ch11xmas_52f6b28b:

    # d "Me, or Santa?"
    d "Io o Babbo Natale?"

# game/ch11xmaseng.rpy:44
translate italian ch11xmas_b561bc03:

    # s "Um... yeah, Santa..."
    s "Ehm... sì, Babbo Natale..."

# game/ch11xmaseng.rpy:45
translate italian ch11xmas_8b8ebe82:

    # a "It's getting cold. Do you have enough blankets?"
    a "Sta diventando freddo. Hai abbastanza coperte?"

# game/ch11xmaseng.rpy:46
translate italian ch11xmas_e79df68d:

    # mc "I'm fine."
    mc "Sto bene."

# game/ch11xmaseng.rpy:50
translate italian ch11xmas_06cb0470:

    # mc "Ugh, I really need to take a crap. I ate way too much turkey last night..."
    mc "Uffa, ho davvero bisogno di fare una cazzata. Ieri sera ho mangiato troppo tacchino..."

# game/ch11xmaseng.rpy:57
translate italian ch11xmas_19da678e:

    # mc "That's a lot of presents..."
    mc "Sono un sacco di regali..."

# game/ch11xmaseng.rpy:58
translate italian ch11xmas_317d02cc:

    # mc "I wish I could've at least bought them a little gift."
    mc "Vorrei aver potuto almeno comprargli un piccolo regalo."

# game/ch11xmaseng.rpy:59
translate italian ch11xmas_999c9c7c:

    # mc "I told them not to get me anything, but they probably did anyway. I really hope not."
    mc "Ho detto loro di non procurarmi nulla, ma probabilmente lo hanno fatto comunque. Spero davvero di no."

# game/ch11xmaseng.rpy:60
translate italian ch11xmas_ff78fdb7:

    # mc "Damn, I think that one has my name on it..."
    mc "Accidenti, penso che su uno ci sia il mio nome..."

# game/ch11xmaseng.rpy:65
translate italian ch11xmas_1728984f:

    # mc "\"With lots of love, to [mc], from [a], [k], and {size=+20}[s].\""
    mc "\'Con tanto affetto, a [mc], da [a], [k] e {size=+20}[s].\'"

# game/ch11xmaseng.rpy:66
translate italian ch11xmas_d8ba6ad6:

    # mc "It was definitely [s] who wrote this. Her name's huge, haha..."
    mc "È stato sicuramente [s] a scrivere questo. Il suo nome è enorme, ahah..."

# game/ch11xmaseng.rpy:68
translate italian ch11xmas_50d22108:

    # mc "*Sigh*... This is so embarrassing. I didn't get them anything at all..."
    mc "*Sigh*... È così imbarazzante. a loro non ho preso proprio niente..."

# game/ch11xmaseng.rpy:69
translate italian ch11xmas_2b35b6fe:

    # mc "..."
    mc "..."

# game/ch11xmaseng.rpy:71
translate italian ch11xmas_bcffeb51:

    # mc "Wait, maybe I can give them a surprise after all... but where did I leave it?"
    mc "Aspetta, forse posso fargli una sorpresa, dopotutto... ma dove l'ho lasciata?"

# game/ch11xmaseng.rpy:72
translate italian ch11xmas_9393e742:

    # mc "Oh right, I stored it in the garage last year..."
    mc "Oh giusto, l'ho lasciato in garage l'anno scorso..."

# game/ch11xmaseng.rpy:78
translate italian ch11xmas_f7153fcb:

    # mc "Psst..."
    mc "Psst..."

# game/ch11xmaseng.rpy:82
translate italian ch11xmas_ca8a08d5:

    # mc "{i}Good morning..."
    mc "{i}Buongiorno..."

# game/ch11xmaseng.rpy:83
translate italian ch11xmas_f8e5dec3:

    # mc "{i}Ho-ho-ho, Merry Christmas..."
    mc "{i}Ho-ho-ho, buon Natale..."

# game/ch11xmaseng.rpy:87
translate italian ch11xmas_05500ff6:

    # mc "Huh?"
    mc "Eh?"

# game/ch11xmaseng.rpy:90
translate italian ch11xmas_48476d4a:

    # d "WHAAAT THE—?!"
    d "COSA-?!"

# game/ch11xmaseng.rpy:93
translate italian ch11xmas_2a572da8:

    # mc "AAAAAAAHH!!"
    mc "AAAAAAAAHH!!"

# game/ch11xmaseng.rpy:96
translate italian ch11xmas_25a4e134:

    # d "Jesus Christ, [mc] Is that you?"
    d "Gesù Cristo, [mc] Sei tu?"

# game/ch11xmaseng.rpy:97
translate italian ch11xmas_d2f060d4:

    # mc "Sorry, I didn't mean to scare you, I didn't know it was you."
    mc "Scusa, non volevo spaventarti, non sapevo che fossi tu."

# game/ch11xmaseng.rpy:98
translate italian ch11xmas_98969f02:

    # d "You almost scared me to death."
    d "Mi hai quasi spaventato a morte."

# game/ch11xmaseng.rpy:99
translate italian ch11xmas_cb8455bf:

    # mc "I just wanted to surprise the girls."
    mc "Volevo solo fare una sorpresa alle ragazze."

# game/ch11xmaseng.rpy:100
translate italian ch11xmas_2bf70623:

    # d "Jesus, I'm sweating... Just try not to kill them in the proces..."
    d "Gesù, sto sudando... Cerca solo di non ucciderli nel farlo..."

# game/ch11xmaseng.rpy:101
translate italian ch11xmas_00b800e6:

    # mc "Yeah, sorry."
    mc "Sì, mi dispiace."

# game/ch11xmaseng.rpy:102
translate italian ch11xmas_a3f8e8d4:

    # d "Would you mind bringing me some ibuprofen?"
    d "Ti dispiacerebbe portarmi dell'ibuprofene?"

# game/ch11xmaseng.rpy:103
translate italian ch11xmas_4be4f4f6:

    # d "I just drank some wine, and my head’s killing me. Guess I’m getting old."
    d "Ho appena bevuto del vino e la testa mi sta uccidendo. Immagino che sto invecchiando."

# game/ch11xmaseng.rpy:104
translate italian ch11xmas_cf1adef2:

    # mc "Yeah."
    mc "Sì."

# game/ch11xmaseng.rpy:105
translate italian ch11xmas_28b441c1:

    # d "Close the door on your way out."
    d "Chiudi la porta mentre esci."

# game/ch11xmaseng.rpy:109
translate italian ch11xmas_068d08cf:

    # mc "Shit, it's locked. But I don't want to knock. I'd like to surprise her too, haha."
    mc "Merda, è chiuso a chiave. Ma non voglio bussare. Vorrei farle una sorpresa anch'io, ahah."

# game/ch11xmaseng.rpy:110
translate italian ch11xmas_60958bb0:

    # mc "I have an idea..."
    mc "Ho un'idea..."

# game/ch11xmaseng.rpy:114
translate italian ch11xmas_c4367b0e:

    # mc "I hope she doesn't get too scared."
    mc "Spero che non si spaventi troppo."

# game/ch11xmaseng.rpy:116
translate italian ch11xmas_f367cffd:

    # mc "Dressed like this, she might think I'm some crazy guy who broke into the house..."
    mc "Vestita così, potrebbe pensare che sono un pazzo che è entrato in casa..."

# game/ch11xmaseng.rpy:117
translate italian ch11xmas_36ff688d:

    # mc "I'll tap on her window and tell her it's me first, I don't want her to have a heart attack."
    mc "Busserò alla sua finestra e le dirò prima che sono io, non voglio che abbia un infarto."

# game/ch11xmaseng.rpy:120
translate italian ch11xmas_ce5b65bc:

    # mc "Hah!"
    mc "Ah!"

# game/ch11xmaseng.rpy:122
translate italian ch11xmas_b977464d:

    # mc "Aaaahh!"
    mc "Aaaahh!"

# game/ch11xmaseng.rpy:124
translate italian ch11xmas_92a8e487:

    # mc "Oof!"
    mc "Uffa!"

# game/ch11xmaseng.rpy:128
translate italian ch11xmas_37c369a6:

    # mc "Ah... {w=0.75}ugh... {w=0.75}shit..."
    mc "Ah... {w=0.75}ugh... {w=0.75}merda..."

# game/ch11xmaseng.rpy:129
translate italian ch11xmas_55577862:

    # mc "Luckily I managed to grab the ladder before falling, or I'd be dead..."
    mc "Per fortuna sono riuscito ad afferrare la scala prima di cadere, altrimenti sarei morto..."

# game/ch11xmaseng.rpy:130
translate italian ch11xmas_2ec94c60:

    # mc "Shit, I need to hurry! Christmas is almost over and I still have presents to deliver!"
    mc "Merda, devo sbrigarmi! Il Natale è quasi finito e ho ancora i regali da consegnare!"

# game/ch11xmaseng.rpy:132
translate italian ch11xmas_532b1263:

    # mc "[a], wake up. It's Christmas. Come on, wake up."
    mc "[a], svegliati. È Natale. Dai, svegliati."

# game/ch11xmaseng.rpy:134
translate italian ch11xmas_d8d8aa59:

    # mc "It's Christmas, dear."
    mc "È Natale, caro."

# game/ch11xmaseng.rpy:135
translate italian ch11xmas_11192d4a:

    # a "What? Oh—right! Go wake the girls while I get ready."
    a "Che cosa? Oh, giusto! Vai a svegliare le ragazze mentre io mi preparo."

# game/ch11xmaseng.rpy:137
translate italian ch11xmas_89d035e6:

    # mc "Hurry up, it's time."
    mc "Sbrigati, è ora."

# game/ch11xmaseng.rpy:138
translate italian ch11xmas_d207e06f:

    # s "Yes!"
    s "Forchette!"

# game/ch11xmaseng.rpy:141
translate italian ch11xmas_79639719:

    # mc "Wake up, we've got work to do."
    mc "Svegliati, abbiamo del lavoro da fare."

# game/ch11xmaseng.rpy:142
translate italian ch11xmas_7d25b6a3:

    # k "Yeah, I'm coming. Give me a minute."
    k "Sì, sto arrivando. Dammi un minuto."

# game/ch11xmaseng.rpy:144
translate italian ch11xmas_a839cf73:

    # mc "HO-HO-HOOOO! Hurry up, Christmas is almost over and we still have lots of presents to deliver!"
    mc "HO-HO-HOOOO! Affrettatevi, il Natale è quasi finito e abbiamo ancora tanti regali da consegnare!"

# game/ch11xmaseng.rpy:153
translate italian ch11xmas_6ca844a0:

    # mc "HO-HO-HOOOO! There are my beautiful ladies!"
    mc "HO-HO-HOOOO! Ci sono le mie belle signore!"

# game/ch11xmaseng.rpy:154
translate italian ch11xmas_f5bb6ce2:

    # s "HO-HO-HOOO! Merry Christmas!"
    s "HO-HO-HOOO! Buon Natale!"

# game/ch11xmaseng.rpy:156
translate italian ch11xmas_93fa5a92:

    # mc "Haha! My beautiful and sweet Mrs. Claus!"
    mc "Ahah! La mia bella e dolce signora Claus!"

# game/ch11xmaseng.rpy:157
translate italian ch11xmas_1c9a0aa0:

    # s "HO-HO-HOOOO!... Does Mrs. Claus say ho-ho-ho too?"
    s "HO-HO-HOOOO!... Anche la signora Claus dice ho-ho-ho?"

# game/ch11xmaseng.rpy:158
translate italian ch11xmas_a49264c7:

    # mc "I don't know, HO-HO-HOOOO!"
    mc "Non lo so, HO-HO-HOOOO!"

# game/ch11xmaseng.rpy:160
translate italian ch11xmas_1f56feb7:

    # mc "Ready?"
    mc "Pronto?"

# game/ch11xmaseng.rpy:161
translate italian ch11xmas_8bb0af13:

    # a "Ready, Santa."
    a "Pronto, Babbo Natale."

# game/ch11xmaseng.rpy:162
translate italian ch11xmas_b0b243e6:

    # mc "HOO-HOO-HOOO—..."
    mc "HOO-HOO-HOOO—..."

# game/ch11xmaseng.rpy:164
translate italian ch11xmas_5c713e93:

    # mc "Ho..."
    mc "Oh..."

# game/ch11xmaseng.rpy:165
translate italian ch11xmas_a20cefa7:

    # "..."
    "..."

# game/ch11xmaseng.rpy:167
translate italian ch11xmas_bda80f05:

    # k "And the reindeer?"
    k "E le renne?"

# game/ch11xmaseng.rpy:168
translate italian ch11xmas_0bd1a844:

    # mc "Uhm... I don't know."
    mc "Ehm... non lo so."

# game/ch11xmaseng.rpy:172
translate italian ch11xmas_8a6bbc47:

    # mc "Ah, there you are!"
    mc "Ah, eccoti!"

# game/ch11xmaseng.rpy:173
translate italian ch11xmas_54d17daf:

    # mc "Hurry up, Rudolph, we've got a lot of presents to deliver."
    mc "Sbrigati, Rudolph, abbiamo un sacco di regali da consegnare."

# game/ch11xmaseng.rpy:174
translate italian ch11xmas_1ceac618:

    # d "Yeah, sorry for the delay."
    d "Sì, scusa il ritardo."

# game/ch11xmaseng.rpy:176
translate italian ch11xmas_cba524e7:

    # mc "HOOO-HOO-HOOOOOO!"
    mc "HOOO-HOO-HOOOOOOO!"

# game/ch11xmaseng.rpy:180
translate italian ch11xmas_dbe06cf1:

    # centered "After many presents and lumps of coal were delivered..."
    centered "Dopo che furono consegnati molti regali e pezzi di carbone..."

# game/ch11xmaseng.rpy:182
translate italian ch11xmas_934b79f4:

    # mc "Stop here, Rudolph. This is the last house. Three kids."
    mc "Fermati qui, Rodolfo. Questa è l'ultima casa. Tre bambini."

# game/ch11xmaseng.rpy:183
translate italian ch11xmas_4fdbb733:

    # d "Yeah."
    d "Sì."

# game/ch11xmaseng.rpy:185
translate italian ch11xmas_3964b364:

    # mc "Why don't you girls take care of this one? [a] and I aren't as young as we used to be. Well, actually, the only real old guy here is me... {w=0.5}And maybe Rudolph a little."
    mc "Perché voi ragazze non vi occupate di questo? [a] e io non siamo più giovani come una volta. Beh, in realtà l'unico vero vecchio qui sono io... {w=0.5}E forse un po' Rudolph."

# game/ch11xmaseng.rpy:186
translate italian ch11xmas_bdf4c169:

    # d "I'm in my forties..."
    d "Sono nelle mie forze..."

# game/ch11xmaseng.rpy:193
translate italian ch11xmas_2a810a67:

    # k "Alright. Move it, runt."
    k "Bene. Muoviti, idiota."

# game/ch11xmaseng.rpy:194
translate italian ch11xmas_eefea7b5:

    # k "Let's get this done quick. I wanna go home already—I'm starving and I haven't even had breakfast."
    k "Facciamolo velocemente. Voglio già andare a casa, sto morendo di fame e non ho nemmeno fatto colazione."

# game/ch11xmaseng.rpy:202
translate italian ch11xmas_35570018:

    # s "HOOO-HOOO-HOOOO!!"
    s "HOOO-HOOO-HOOOO!!"

# game/ch11xmaseng.rpy:203
translate italian ch11xmas_be89a1a2:

    # k "Shut up, you're gonna wake them up!"
    k "Stai zitto, li sveglierai!"

# game/ch11xmaseng.rpy:206
translate italian ch11xmas_b7a34574:

    # mc "Hmm, let's see..."
    mc "Hmm, vediamo..."

# game/ch11xmaseng.rpy:207
translate italian ch11xmas_bf1de5ef:

    # mc "This gift right here... wait, it has my name on it."
    mc "Questo regalo proprio qui... aspetta, c'è sopra il mio nome."

# game/ch11xmaseng.rpy:208
translate italian ch11xmas_80a7712a:

    # mc "But there's nothing inside. That's strange..."
    mc "Ma non c'è niente dentro. È strano..."

# game/ch11xmaseng.rpy:209
translate italian ch11xmas_f3e5b7ed:

    # a "Yes, that one... that's the gift I kept asking you about. We didn't know what to do with it until I realized..."
    a "Sì, quello... è il regalo di cui continuavo a chiederti. Non sapevamo cosa farne finché non ho capito..."

# game/ch11xmaseng.rpy:216
translate italian ch11xmas_05500ff6_1:

    # mc "Huh?"
    mc "Eh?"

# game/ch11xmaseng.rpy:217
translate italian ch11xmas_4744e76f:

    # a "Your present is something that can't really be wrapped..."
    a "Il tuo regalo è qualcosa che non può essere davvero incartato..."

# game/ch11xmaseng.rpy:218
translate italian ch11xmas_dd8e6a09:

    # mc "I don't remember asking for anything."
    mc "Non ricordo di aver chiesto nulla."

# game/ch11xmaseng.rpy:219
translate italian ch11xmas_205712a6:

    # a "You know... Santa can know what to give you even if you don't write a letter."
    a "Sai... Babbo Natale può sapere cosa regalarti anche se non scrivi una lettera."

# game/ch11xmaseng.rpy:220
translate italian ch11xmas_64718225:

    # a "Santa knows exactly what you want most for Christmas..."
    a "Babbo Natale sa esattamente cosa desideri di più per Natale..."

# game/ch11xmaseng.rpy:221
translate italian ch11xmas_f66e6da4:

    # mc "Oh, really?"
    mc "Oh, davvero?"

# game/ch11xmaseng.rpy:222
translate italian ch11xmas_3c46d3e0:

    # a "Mhm..."
    a "Mhm..."

# game/ch11xmaseng.rpy:223
translate italian ch11xmas_d650b93b:

    # mc "And that gift... what do you say you give it to me when we get home?"
    mc "E quel regalo... che ne dici di darmelo quando torniamo a casa?"

# game/ch11xmaseng.rpy:224
translate italian ch11xmas_712b813e:

    # a "That's the problem. There are only a couple of hours of Christmas left. The delivery might expire by the time we get there..."
    a "Questo è il problema. Mancano solo un paio d'ore al Natale. La consegna potrebbe scadere nel momento in cui arriviamo..."

# game/ch11xmaseng.rpy:225
translate italian ch11xmas_5403b492:

    # mc "R-Rudolph, I need you to go as high as you can."
    mc "R-Rudolph, ho bisogno che tu vada più in alto che puoi."

# game/ch11xmaseng.rpy:226
translate italian ch11xmas_56453ba8:

    # d "To the sky?"
    d "Al cielo?"

# game/ch11xmaseng.rpy:227
translate italian ch11xmas_978eb9cb:

    # mc "Yeah. As high as possible—somewhere no one can see us."
    mc "Sì. Il più in alto possibile, da qualche parte dove nessuno possa vederci."

# game/ch11xmaseng.rpy:228
translate italian ch11xmas_ed52b4d1:

    # d "Alright."
    d "Bene."

# game/ch11xmaseng.rpy:230
translate italian ch11xmas_ae9302ff:

    # mc "HOOOO-HOOOO-HOOOOOOO!!!"
    mc "HOOOO-HOOOO-HOOOOOOO!!!"

# game/ch11xmaseng.rpy:233
translate italian ch11xmas_3552adf6:

    # mc "One more thing, for the next 30 minutes I don’t want you looking over here, Rudolph, that’s an order."
    mc "Ancora una cosa, per i prossimi 30 minuti non voglio che tu guardi qui, Rudolph, è un ordine."

# game/ch11xmaseng.rpy:234
translate italian ch11xmas_7be08048:

    # d "As you say, Santa."
    d "Come dici tu, Babbo Natale."

# game/ch11xmaseng.rpy:239
translate italian ch11xmas_003e6bde:

    # a "Oh, Santa... *muah*"
    a "Oh, Babbo Natale... *muah*"

# game/ch11xmaseng.rpy:240
