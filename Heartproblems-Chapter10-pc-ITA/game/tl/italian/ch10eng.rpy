    # mc "(I’ve got a bad feeling...)" with dissolve
    mc "(Ho un brutto presentimento...)" with dissolve

# game/ch10eng.rpy:9495
translate italian ch10_378asdcont_8c731fa4:

    # d "{i}Your [arelat] told me you barely speak to [k], says it’s because of me."
    d "{i}Il tuo [arelat] mi ha detto che parli a malapena con [k], dice che è per colpa mia."

# game/ch10eng.rpy:9496
