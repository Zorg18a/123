translate italian ch10_243afss_c0c58c6c:

    # mc "*Ngh* Nope."
    mc "*Ngh* No."

# game/ch10eng.rpy:6340
translate italian ch10_243afss_89d59313:

    # mc "(I needed this, I hadn’t worked out all week.)" with dissolve
    mc "(Ne avevo bisogno, non mi ero allenato per tutta la settimana.)" with dissolve

# game/ch10eng.rpy:6341
translate italian ch10_243afss_c23ebed5:

    # mc "(I wonder what my [arelat] [a] is doing?)" with dissolve
    mc "(Mi chiedo cosa stia facendo mio [arelat] [a]?)" with dissolve

# game/ch10eng.rpy:6342
translate italian ch10_243afss_319f5aba:

    # mc "(Might be a good idea to go check on her...)" with dissolve
    mc "(Potrebbe essere una buona idea andare a controllare come sta...)" with dissolve

# game/ch10eng.rpy:6346
translate italian ch10_243afss_05a2f824:

    # d "[a], I’m glad you came with us to the beach yesterday."
    d "[a], Sono contento che tu sia venuto con noi alla spiaggia ieri."

# game/ch10eng.rpy:6347
translate italian ch10_243afss_01c2b885:

    # d "It was a good day, well... except for the end, heh."
    d "È stata una bella giornata, beh... tranne per la fine, eh."

# game/ch10eng.rpy:6348
translate italian ch10_243afss_a31d7a54:

    # d "Opening that bottle was a bad idea."
    d "Aprire quella bottiglia è stata una cattiva idea."

# game/ch10eng.rpy:6349
translate italian ch10_243afss_d8539aed:

    # mc "(Looks like they’re chatting...)" with dissolve
    mc "(Sembra che stiano chiacchierando...)" with dissolve

# game/ch10eng.rpy:6350
translate italian ch10_243afss_c739ca17:

    # d "It was a gift from [k]’s friend, we didn’t want to be rude."
    d "Era un regalo dell'amico di [k], non volevamo essere maleducati."

# game/ch10eng.rpy:6351
translate italian ch10_243afss_44de153d:

    # d "It’s good for us to go out as a family more often, don’t you think?"
    d "Non credi che sia una buona idea uscire più spesso in famiglia?"

# game/ch10eng.rpy:6352
translate italian ch10_243afss_754c541d:

    # d "Especially now that I’ve taken this mini vacation."
    d "Soprattutto ora che mi sono presa questa mini vacanza."

# game/ch10eng.rpy:6353
translate italian ch10_243afss_567b54f1:

    # d "I’ll be back in three or four weeks... {w=0.5}It was hard to get these days off, but I managed."
    d "Tornerò tra tre o quattro settimane... {w=0.5}È stato difficile prendersi questi giorni liberi, ma ce l'ho fatta."

# game/ch10eng.rpy:6354
translate italian ch10_243afss_6b552097:

    # d "I want us to be together, like the family we are!"
    d "Voglio che stiamo insieme, come la famiglia che siamo!"

# game/ch10eng.rpy:6355
translate italian ch10_243afss_97338c2c:

    # d "Hehe... erm..."
    d "Ehehe... ehm..."

# game/ch10eng.rpy:6356
translate italian ch10_243afss_66fc6c0f:

    # a "Sounds good to me."
    a "Mi sembra una buona idea."

# game/ch10eng.rpy:6357
translate italian ch10_243afss_fc6dea88:

    # d "Yeah..."
    d "Sì..."

# game/ch10eng.rpy:6358
translate italian ch10_243afss_39389ea4:

    # d "What are you doing?"
    d "Cosa fai?"

# game/ch10eng.rpy:6359
translate italian ch10_243afss_f7384fff:

    # a "I’m going to clean, erm...{w=0.5} the oven."
    a "Vado a pulire, ehm...{w=0.5} il forno."

# game/ch10eng.rpy:6360
translate italian ch10_243afss_934181ec:

    # a "I’m a little busy, so..."
    a "Sono un po' impegnato, quindi..."

# game/ch10eng.rpy:6361
translate italian ch10_243afss_07ccc392:

    # d "Are you cooking something good today?"
    d "Stai cucinando qualcosa di buono oggi?"

# game/ch10eng.rpy:6362
translate italian ch10_243afss_e7d98c63:

    # a "Maybe."
    a "Forse."

# game/ch10eng.rpy:6363
translate italian ch10_243afss_d65e4e5f:

    # d "Oh, okay."
    d "Va bene."

# game/ch10eng.rpy:6365
translate italian ch10_243afss_1c8151ab:

    # d "Well then..."
    d "Bene allora..."

# game/ch10eng.rpy:6367
translate italian ch10_243afss_c51b73fc:

    # d "I guess I’ll stop bothering you, dear. Uhm, I’m gonna... watch some football."
    d "Immagino che smetterò di disturbarti, cara. Ehm, vado... a guardare un po' di football."

# game/ch10eng.rpy:6369
translate italian ch10_243afss_4e9411cc:

    # d "Hey, [mc], I think we overdid it yesterday."
    d "Ehi, [mc], penso che ieri abbiamo esagerato."

# game/ch10eng.rpy:6370
translate italian ch10_243afss_0fd21bc5:

    # mc "Yeah, we drank a lot."
    mc "Sì, abbiamo bevuto molto."

# game/ch10eng.rpy:6373
translate italian ch10_243afss_192c7ad0:

    # d "{i}{size=-3}Oh my god..."
    d "{i}{size=-3}Oh mio dio..."

# game/ch10eng.rpy:6376
translate italian ch10_243afss_2ed83991:

    # mc "Something wrong?"
    mc "Qualcosa non va?"

# game/ch10eng.rpy:6378
translate italian ch10_243afss_8c671b40:

    # d "N-no, well..."
    d "N-no, beh..."

# game/ch10eng.rpy:6379
translate italian ch10_243afss_e7281b0c:

    # d "Nah, just this damn headache I can’t shake."
    d "No, ho solo questo maledetto mal di testa che non riesco a scrollarmi di dosso."

# game/ch10eng.rpy:6380
translate italian ch10_243afss_070f0564:

    # mc "You should take some ibuprofen."
    mc "Dovresti prendere dell'ibuprofene."

# game/ch10eng.rpy:6382
translate italian ch10_243afss_fc6dea88_1:

    # d "Yeah..."
    d "Sì..."

# game/ch10eng.rpy:6384
translate italian ch10_243afss_ec348418:

    # d "Hey, [mc]."
    d "Ehi, [mc]."

# game/ch10eng.rpy:6385
translate italian ch10_243afss_4a06c9a8:

    # d "How’s life treating you?"
    d "Come ti sta trattando la vita?"

# game/ch10eng.rpy:6386
translate italian ch10_243afss_ff0cec22:

    # mc "Good. And you?"
    mc "Bene e tu?"

# game/ch10eng.rpy:6387
translate italian ch10_243afss_6d039951:

    # d "You know, {i}{size=-5}bad with my family...{/i} but everything else is alright, heh."
    d "Sai, {i}{size=-5}non va bene con la mia famiglia...{/i} ma tutto il resto va bene, eh."

# game/ch10eng.rpy:6389
translate italian ch10_243afss_79df4b26:

    # d "Man, I’m craving a beer, might help this damn hangover."
    d "Cavolo, ho voglia di una birra, potrebbe aiutarmi con questi maledetti postumi della sbornia."

# game/ch10eng.rpy:6390
translate italian ch10_243afss_ad30772c:

    # d "Wanna have one in the patio?"
    d "Ne vuoi uno in terrazza?"

# game/ch10eng.rpy:6391
translate italian ch10_243afss_3e070ba3:

    # mc "Uh, sure, why not."
    mc "Eh, certo, perché no."

# game/ch10eng.rpy:6393
translate italian ch10_243afss_3967b258:

    # d "You guys really did a good job with all this."
    d "Avete fatto davvero un ottimo lavoro con tutto questo."

# game/ch10eng.rpy:6394
translate italian ch10_243afss_67042b5b:

    # d "Was it your idea or [a]’s?"
    d "È stata un'idea tua o di [a]?"

# game/ch10eng.rpy:6395
translate italian ch10_243afss_6909c723:

    # mc "It was [arelat] [a]’s idea. I just helped set it all up."
    mc "L'idea è stata di [arelat][a]. Io ho solo aiutato a organizzare il tutto."

# game/ch10eng.rpy:6397
translate italian ch10_243afss_be60bb4d:

    # d "[mc], this looks really well done."
    d "[mc], sembra davvero ben fatto."

# game/ch10eng.rpy:6398
translate italian ch10_243afss_bddfe5fe:

    # mc "I watched a few videos on how to set it all up."
    mc "Ho guardato alcuni video su come impostare il tutto."

# game/ch10eng.rpy:6399
translate italian ch10_243afss_2f065186:

    # d "Glad you’re not wasting your time. Learning this kind of stuff is useful."
    d "Sono felice che tu non stia perdendo tempo. Imparare questo genere di cose è utile."

# game/ch10eng.rpy:6402
translate italian ch10_243afss_f1e9d3df:

    # d "So, how’s the girlfriend?"
    d "Allora, come sta la tua ragazza?"

# game/ch10eng.rpy:6403
translate italian ch10_243afss_90d84911:

    # mc "Girlfriend? Uhm...{w=0.5} not great, I don’t have one."
    mc "Fidanzata? Uhm...{w=0.5} non è un granché, non ne ho una."

# game/ch10eng.rpy:6404
translate italian ch10_243afss_b30520b5:

    # d "You don’t sound too sure about that."
    d "Non sembri molto sicuro di questo."

# game/ch10eng.rpy:6406
translate italian ch10_243afss_8d32114b:

    # d "Haha, sounds like we’re in the same boat when it comes to love."
    d "Ahah, sembra che siamo sulla stessa barca quando si tratta di amore."

# game/ch10eng.rpy:6407
translate italian ch10_243afss_140bb3a6:

    # mc "Why do you say that?"
    mc "Perché dici questo?"

# game/ch10eng.rpy:6408
translate italian ch10_243afss_8b492570:

    # d "Come on, don’t play dumb. I saw you two at the beach."
    d "Dai, non fare il finto tonto. Vi ho visti in spiaggia."

# game/ch10eng.rpy:6409
translate italian ch10_243afss_2ceb5c68:

    # mc "Ah, I think I know what you mean."
    mc "Ah, credo di aver capito cosa intendi."

# game/ch10eng.rpy:6410
translate italian ch10_243afss_4fdbb733:

    # d "Yeah."
    d "Sì."

# game/ch10eng.rpy:6413
translate italian ch10_243afss_ce01838f:

    # d "That girl, [mia], she has a boyfriend, doesn’t she?"
    d "Quella ragazza, [mia], ha un fidanzato, non è vero?"

# game/ch10eng.rpy:6414
translate italian ch10_243afss_42778659:

    # mc "Y-yeah..."
    mc "S-sì..."

# game/ch10eng.rpy:6416
translate italian ch10_243afss_8df5e36c:

    # mc "Not much to say, love’s complicated."
    mc "Non c'è molto da dire, l'amore è complicato."

# game/ch10eng.rpy:6418
translate italian ch10_243afss_bf95eb4a:

    # d "Haha, ain’t that the truth!"
    d "Ahah, non è la verità?"

# game/ch10eng.rpy:6423
translate italian ch10_243afss_fd586361:

    # d "I really like here."
    d "Mi piace molto questo posto."

# game/ch10eng.rpy:6425
translate italian ch10_243afss_84e27b62:

    # d "Hey, that grill."
    d "Ehi, quella griglia."

# game/ch10eng.rpy:6426
translate italian ch10_243afss_3696ac4a:

    # d "I bought it, but we hardly ever use it. It’s just sitting there rusting."
    d "L'ho comprato, ma lo usiamo pochissimo. È lì ad arrugginire."

# game/ch10eng.rpy:6427
translate italian ch10_243afss_f1a477ac:

    # d "I think there’s charcoal in the garage... {w=0.5}Wanna grill something?"
    d "Penso che ci sia del carbone nel garage... {w=0.5}Vuoi grigliare qualcosa?"

# game/ch10eng.rpy:6428
translate italian ch10_243afss_606e2d02:

    # mc "Sure."
    mc "Sicuro."

# game/ch10eng.rpy:6430
translate italian ch10_243afss_7c0975c3:

    # d "I’ll grab the meat. Be right back."
    d "Prendo la carne. Torno subito."

# game/ch10eng.rpy:6434
translate italian ch10_243afss_af35858b:

    # d "Things are wild nowadays. You just open one of those dating apps and boom."
    d "Oggigiorno le cose vanno alla grande. Basta aprire una di quelle app di incontri e... boom!"

# game/ch10eng.rpy:6435
translate italian ch10_243afss_392cbf01:

    # d "Back then, it was a lot harder."
    d "All'epoca era molto più difficile."

# game/ch10eng.rpy:6436
translate italian ch10_243afss_3681def1:

    # mc "It has downsides too. Sometimes the girl doesn’t even look like her picture."
    mc "Ha anche i suoi lati negativi. A volte la ragazza non assomiglia nemmeno alla sua foto."

# game/ch10eng.rpy:6437
translate italian ch10_243afss_caf33347:

    # mc "And sometimes... it’s not even a girl."
    mc "E a volte... non è nemmeno una ragazza."

# game/ch10eng.rpy:6438
translate italian ch10_243afss_1ac60992:

    # d "Ha! Don’t tell me that actually happened to you!"
    d "Ah! Non dirmi che ti è successo davvero!"

# game/ch10eng.rpy:6439
translate italian ch10_243afss_f8f77085:

    # mc "No, but I’ve heard stories, haha."
    mc "No, ma ho sentito delle storie, haha."

# game/ch10eng.rpy:6441
translate italian ch10_243afss_9ec2669b:

    # d "Here, wave this so the coals catch."
    d "Ecco, agitalo in modo che i carboni prendano fuoco."

# game/ch10eng.rpy:6442
translate italian ch10_243afss_d2cb211b:

    # mc "Back then it was letters, right?"
    mc "Allora si trattava di lettere, giusto?"

# game/ch10eng.rpy:6444
translate italian ch10_243afss_7526d734:

    # d "Letters, my ass. We had to hustle."
    d "Lettere, un cazzo. Dovevamo sbrigarci."

# game/ch10eng.rpy:6445
translate italian ch10_243afss_3a91cfaf:

    # d "You had to show up, be confident, impress the girls face to face."
    d "Dovevi presentarti, essere sicuro di te, impressionare le ragazze faccia a faccia."

# game/ch10eng.rpy:6446
translate italian ch10_243afss_d6fce4e8:

    # d "Those were the days... Wish I could be your age again."
    d "Quei tempi... Vorrei avere di nuovo la tua età."

# game/ch10eng.rpy:6448
translate italian ch10_243afss_31e56ad5:

    # d "That’s why I say, enjoy life. You can leave love for later."
    d "Ecco perché dico: goditi la vita. L'amore puoi lasciarlo per dopo."

# game/ch10eng.rpy:6449
translate italian ch10_243afss_840c6120:

    # d "This girl, [mia]... I don’t see her as someone to get serious with."
    d "Questa ragazza, [mia]... non la vedo come una persona con cui fare sul serio."

# game/ch10eng.rpy:6451
translate italian ch10_243afss_273271ca:

    # d "You’re young. You’ve got plenty of time to mess up."
    d "Sei giovane. Hai un sacco di tempo per sbagliare."

# game/ch10eng.rpy:6453
translate italian ch10_243afss_bafbe606:

    # d "*Cough, cough...* What did you put in there, [mc]?"
    d "*Tosse, tosse...* Cosa ci hai messo dentro, [mc]?"

# game/ch10eng.rpy:6454
translate italian ch10_243afss_ebfaa22e:

    # mc "A piece of cardboard, like you said. *Cough, cough*"
    mc "Un pezzo di cartone, come hai detto. *Tosse, tosse*"

# game/ch10eng.rpy:6455
translate italian ch10_243afss_878bfe39:

    # d "That’s plastic, [mc]. *Cough* Help me move this thing, way too much smoke."
    d "È plastica, [mc]. *Tosse* Aiutami a spostare questa cosa, c'è troppo fumo."

# game/ch10eng.rpy:6462
translate italian ch10a3_1088ba19:

    # a "Is something burning?"
    a "Qualcosa sta bruciando?"

# game/ch10eng.rpy:6463
translate italian ch10a3_7a842b24:

    # d "No, love, it’s just a barbecue attempt. We’re grilling some burgers too."
    d "No, tesoro, è solo un tentativo di barbecue. Stiamo anche grigliando degli hamburger."

# game/ch10eng.rpy:6464
translate italian ch10a3_f645685c:

    # a "I thought the place was on fire, are you grilling meat or tires?"
    a "Pensavo che il posto stesse andando a fuoco, stai grigliando carne o pneumatici?"

# game/ch10eng.rpy:6465
translate italian ch10a3_287adaa2:

    # d "We had a little mishap earlier."
    d "Abbiamo avuto un piccolo incidente prima."

# game/ch10eng.rpy:6466
translate italian ch10a3_eb135638:

    # d "Come on, give it a try."
    d "Forza, provaci."

# game/ch10eng.rpy:6467
translate italian ch10a3_55af7fa3:

    # a "No, I..."
    a "No, io..."

# game/ch10eng.rpy:6468
translate italian ch10a3_b7c721a7:

    # d "[mc] and I made it together."
    d "[mc] e l'ho fatto insieme."

# game/ch10eng.rpy:6469
translate italian ch10a3_fab0e919:

    # mc "We need an opinion."
    mc "Abbiamo bisogno di un'opinione."

# game/ch10eng.rpy:6470
translate italian ch10a3_93118e20:

    # d "Give her that one over there, it’s cooked well."
    d "Daglielo lì, è cucinato bene."

# game/ch10eng.rpy:6475
translate italian ch10a3_8de0d85e:

    # a "This is the one that was cooked well?"
    a "Questo è quello cucinato bene?"

# game/ch10eng.rpy:6476
translate italian ch10a3_0af8f0c4:

    # mc "Why do you ask? Is it raw?"
    mc "Perché lo chiedi? È crudo?"

# game/ch10eng.rpy:6477
translate italian ch10a3_56323fd6:

    # a "It’s... {w=0.5}fine."
    a "Va... {w=0.5}bene."

# game/ch10eng.rpy:6478
translate italian ch10a3_1ac0d33f:

    # d "Score?"
    d "Punto?"

# game/ch10eng.rpy:6479
translate italian ch10a3_3d041921:

    # a "I’d give it... a seven?"
    a "Gli darei... un sette?"

# game/ch10eng.rpy:6481
translate italian ch10a3_11455b53:

    # mc "What?"
    mc "Che cosa?"

# game/ch10eng.rpy:6482
translate italian ch10a3_76232e0d:

    # a "It’s raw on the inside and burned on the outside."
    a "È crudo all'interno e bruciato all'esterno."

# game/ch10eng.rpy:6483
translate italian ch10a3_f9c3caa5:

    # mc "Think you could do better?"
    mc "Pensi che potresti fare di meglio?"

# game/ch10eng.rpy:6484
translate italian ch10a3_a80de888:

    # a "Is that a serious question?"
    a "È una domanda seria?"

# game/ch10eng.rpy:6485
translate italian ch10a3_dd4dc0cb:

    # mc "Is it really that bad?"
    mc "È davvero così grave?"

# game/ch10eng.rpy:6486
translate italian ch10a3_b16b8ef2:

    # a "Give me that..."
    a "Dammi quello..."

# game/ch10eng.rpy:6488
translate italian ch10a3_99864bcc:

    # a "Did you put barbecue sauce on the chicken?"
    a "Hai messo la salsa barbecue sul pollo?"

# game/ch10eng.rpy:6489
translate italian ch10a3_842f7f92:

    # d "Uh, yeah... y-yeah, you can do that, right?"
    d "Uh, sì... s-sì, puoi farlo, vero?"

# game/ch10eng.rpy:6490
translate italian ch10a3_a1345923:

    # d "We just wanted something to go with the beers."
    d "Volevamo solo qualcosa che si abbinasse alle birre."

# game/ch10eng.rpy:6491
translate italian ch10a3_a3a01fed:

    # a "Of course you can."
    a "Certo che puoi."

# game/ch10eng.rpy:6492
translate italian ch10a3_58f9d085:

    # d "Heh, watch and learn from the pro, [mc]."
    d "Ehi, guarda e impara dal professionista, [mc]."

# game/ch10eng.rpy:6494
translate italian ch10a3_47157276:

    # d "Now this is a barbecue."
    d "Ecco, questo sì che è un barbecue."

# game/ch10eng.rpy:6496
translate italian ch10a3_a20cefa7:

    # "..."
    "..."

# game/ch10eng.rpy:6498
translate italian ch10a3_e05f1941:

    # d "We were just talking about how love and relationships used to be way harder."
    d "Stavamo proprio parlando di quanto l'amore e le relazioni fossero un tempo molto più difficili."

# game/ch10eng.rpy:6499
translate italian ch10a3_2a91f1c7:

    # d "Kids today have it easy."
    d "Per i ragazzi di oggi è tutto facile."

# game/ch10eng.rpy:6500
translate italian ch10a3_5d104d8d:

    # d "Now there are even long-distance relationships. Back in our day, that was a real issue."
    d "Ora esistono anche le relazioni a distanza. Ai nostri tempi, questo era un vero problema."

# game/ch10eng.rpy:6501
translate italian ch10a3_64accf0d:

    # d "Letters took days to arrive, right honey?"
    d "Le lettere impiegavano giorni per arrivare, vero tesoro?"

# game/ch10eng.rpy:6503
translate italian ch10a3_e30435db:

    # a "You never sent me any letters, [d]..."
    a "Non mi hai mai mandato lettere, [d]..."

# game/ch10eng.rpy:6504
translate italian ch10a3_119b2cd3:

    # d "I know, love... I’m just talking about how things used to be."
    d "Lo so, amore... sto solo parlando di come erano le cose una volta."

# game/ch10eng.rpy:6505
translate italian ch10a3_2f300439:

    # a "And there were phones too, we’re not that old."
    a "E c'erano anche i telefoni, non siamo poi così vecchi."

# game/ch10eng.rpy:6506
translate italian ch10a3_361aecde:

    # d "R-right, that’s why I didn’t send you letters, hehe..."
    d "R-giusto, ecco perché non ti ho mandato lettere, hehe..."

# game/ch10eng.rpy:6507
translate italian ch10a3_eadd3a1a:

    # d "But they weren’t like today’s. That’s what I meant."
    d "Ma non erano come quelli di oggi. Ecco cosa intendevo."

# game/ch10eng.rpy:6509
translate italian ch10a3_541c9340:

    # mc "Technology evolves, [drelat] [d]. Worry when everything gets harder instead."
    mc "La tecnologia si evolve, [drelat] [d]. Preoccuparsi quando tutto diventa più difficile invece."

