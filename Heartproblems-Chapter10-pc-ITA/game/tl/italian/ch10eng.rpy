translate italian ch10_378asdcont_c4638dbd:

    # d "But, well..."
    d "Ma, beh..."

# game/ch10eng.rpy:9473
translate italian ch10_378asdcont_f451e085:

    # a "Yeah, I think that’s punishment enough."
    a "Sì, penso che sia una punizione sufficiente."

# game/ch10eng.rpy:9475
translate italian ch10_378asdcont_93fd594e:

    # a "I’ve noticed you and [k] barely talk now, this isn’t what we wanted either."
    a "Ho notato che tu e [k] ormai non vi parlate quasi più, non è questo che volevamo."

# game/ch10eng.rpy:9476
translate italian ch10_378asdcont_7a9f51d2:

    # a "Punishment is one thing, but completely cutting each other off is something else."
    a "Punire è una cosa, isolarsi completamente a vicenda è un'altra."

