# game/ch7.rpy:2229
translate italian ch7a1_33823835:

    # mc "(Had to come the [drelat] [d] to ruin the mood...)"
    mc "(Ci volevano le [drelat] [d] per rovinare l'atmosfera...)"

# game/ch7.rpy:2230
translate italian ch7a1_0f8bf3eb:

    # d "[a]..."
    d "[a]..."

# game/ch7.rpy:2238
translate italian ch7a1_912c4019:

    # d "It's work, understand, [a]!"
    d "È un lavoro, capisci, [a]!"

# game/ch7.rpy:2239
translate italian ch7a1_385ec066:

    # d "Aren't you going to say anything?"
    d "Non dici niente?"

# game/ch7.rpy:2240
translate italian ch7a1_da805dc0:

    # d "Say something, anything."
    d "Dì qualcosa, qualsiasi cosa."

# game/ch7.rpy:2241
translate italian ch7a1_35b9bdb5:

    # d "Grow up a little bit please."
    d "Cresci un pochino, per favore."

# game/ch7.rpy:2242
translate italian ch7a1_c6fccb0a:

    # a "I don't have anything to talk to you about."
    a "Non ho niente di cui parlarti."

# game/ch7.rpy:2243
translate italian ch7a1_079de091:

    # d "Come on, this is no time to be angry, can't you be happy for all of us?"
    d "Dai, non è il momento di arrabbiarsi, non potresti essere felice per tutti noi?"

# game/ch7.rpy:2245
translate italian ch7a1_49b417c4:

    # d "You need to tell me what's going on or I won't be able to remedy it."
    d "Devi dirmi cosa sta succedendo, altrimenti non sarò in grado di porvi rimedio."

# game/ch7.rpy:2246
translate italian ch7a1_366e60f2:

    # d "If it's about our anniversary I'll make it up to you, I promise."
    d "Se si tratta del nostro anniversario, ti prometto che ti risarcirò."

# game/ch7.rpy:2247
translate italian ch7a1_d47b8bec:

    # d "That's it, isn't it?"
    d "Tutto qui, non è vero?"

# game/ch7.rpy:2248
translate italian ch7a1_85bc774e:

    # d "You can't get mad over nonsense like that."
    d "Non puoi arrabbiarti per delle sciocchezze del genere."

# game/ch7.rpy:2249
translate italian ch7a1_d8e46895:

    # a "Do you really think I'm that dumb?"
    a "Pensi davvero che io sia così stupido?"

# game/ch7.rpy:2250
translate italian ch7a1_1523fe20:

    # d "..."
    d "..."

# game/ch7.rpy:2251
translate italian ch7a1_13f469b3:

    # d "There you go with that again..."
    d "Eccoci di nuovo lì..."

# game/ch7.rpy:2253
translate italian ch7a1_a4f62783:

    # d "[a], you're making up stories in your head that have nothing to do with reality."
    d "[a], ti stai inventando storie nella tua testa che non hanno nulla a che fare con la realtà."

# game/ch7.rpy:2254
translate italian ch7a1_e2e88553:

    # a "I don't want to talk now, [d]."
    a "Non voglio parlare adesso, [d]."

# game/ch7.rpy:2255
translate italian ch7a1_a8ddbe5e:

    # d "You know what, I don't care. I'm tired of it."
    d "Sai cosa, non mi interessa. Sono stanco di tutto questo."

# game/ch7.rpy:2262
translate italian ch7a1_5a42b074:

    # mc "I see that things are not getting any better."
    mc "Vedo che le cose non stanno migliorando."

# game/ch7.rpy:2263
translate italian ch7a1_9fff7b10:

    # a "I'm tired of this."
    a "Sono stanco di tutto questo."

# game/ch7.rpy:2265
translate italian ch7a1_e1fed88a:

    # a "I've been having that nauseous feeling all day."
    a "Ho avuto quella sensazione di nausea per tutto il giorno."

# game/ch7.rpy:2266
translate italian ch7a1_0d550edf:

    # a "Doing chores and hanging out together made me forget all about this."
    a "Fare le faccende domestiche e trascorrere del tempo insieme mi ha fatto dimenticare tutto questo."

# game/ch7.rpy:2268
translate italian ch7a1_e6f49919:

    # a "But it's seeing [d]'s face and I feel sick again."
    a "Ma quando vedo la faccia di [d] mi sento di nuovo male."

# game/ch7.rpy:2270
translate italian ch7a1_2f81ae4d:

    # mc "Do you want to go for a walk in the park?"
    mc "Vuoi fare una passeggiata al parco?"

# game/ch7.rpy:2271
translate italian ch7a1_3dbce83c:

    # mc "To take your mind off things."
    mc "Per distrarti."

# game/ch7.rpy:2273
translate italian ch7a1_3722dc31:

    # a "Yes, please."
    a "Sì, per favore."

# game/ch7.rpy:2274
translate italian ch7a1_f9943e78:

    # mc "Okay, let's go."
    mc "Ok, andiamo."

# game/ch7.rpy:2290
translate italian ch7a2_3c723fe0:

    # a "I haven't been here in a while."
    a "Non vengo qui da un po'."

# game/ch7.rpy:2291
translate italian ch7a2_c6e06d43:

    # a "They upgraded the place, it's cleaner than before."
    a "Hanno ristrutturato il posto, è più pulito di prima."

# game/ch7.rpy:2292
translate italian ch7a2_bfa8dde4:

    # mc "Yes, they made renovations and increased security because they opened a school near here."
    mc "Sì, hanno fatto dei lavori di ristrutturazione e aumentato la sicurezza perché hanno aperto una scuola qui vicino."

# game/ch7.rpy:2293
translate italian ch7a2_b6cf92d5:

    # a "I remember why we didn't come to this area of the park, there were always people doing drugs and sleeping on the benches."
    a "Ricordo perché non andavamo in questa zona del parco: c'era sempre gente che si drogava e dormiva sulle panchine."

# game/ch7.rpy:2294
translate italian ch7a2_0bcdd430:

    # a "They even put in playground equipment for the kids."
    a "Hanno persino installato delle attrezzature da gioco per i bambini."

# game/ch7.rpy:2296
translate italian ch7a2_ef4bf92f:

    # a "It's a bit unfair, don't you think? there should be park games for adults too."
    a "È un po' ingiusto, non credi? Dovrebbero esserci giochi nei parchi anche per adulti."

# game/ch7.rpy:2297
translate italian ch7a2_38851deb:

    # mc "I don't think it's a good idea, especially since this is a public space."
    mc "Non credo che sia una buona idea, soprattutto perché questo è uno spazio pubblico."

# game/ch7.rpy:2298
translate italian ch7a2_8dabefc6:

    # ".."
    ".."

# game/ch7.rpy:2299
translate italian ch7a2_f6688ccc:

    # a "Uh? Why does it matter that it's a public space? I don't understand."
    a "Eh? Perché dovrebbe importare che sia uno spazio pubblico? Non capisco."

# game/ch7.rpy:2300
translate italian ch7a2_9d908a96:

    # mc "That the children might be traumatized."
    mc "Che i bambini potrebbero rimanere traumatizzati."

# game/ch7.rpy:2301
translate italian ch7a2_a20cefa7:

    # "..."
    "..."

# game/ch7.rpy:2303
translate italian ch7a2_70657c0a:

    # a "I still don't understand."
    a "Continuo a non capire."

# game/ch7.rpy:2304
translate italian ch7a2_a38917e4:

    # mc "Forget it, it was a bad joke."
    mc "Dimenticatelo, era uno scherzo di cattivo gusto."

# game/ch7.rpy:2305
translate italian ch7a2_4fe203b0:

    # mc "We'd better go sit in the shade, the sun is burning me."
    mc "Meglio andare a sederci all'ombra, il sole mi brucia."

# game/ch7.rpy:2306
translate italian ch7a2_0b02a424:

    # a "But can you explain the joke?"
    a "Ma puoi spiegare la barzelletta?"

# game/ch7.rpy:2307
translate italian ch7a2_50afca21:

    # mc "Better not."
    mc "Meglio di no."

# game/ch7.rpy:2309
translate italian ch7a2_8c7b783d:

    # a "You have to explain it to me or I won't be able to sleep well today, haha."
    a "Devi spiegarmelo altrimenti non riuscirò a dormire bene oggi, haha."

# game/ch7.rpy:2311
translate italian ch7a2_a094d770:

    # a "Ahh..."
    a "Ah..."

# game/ch7.rpy:2312
translate italian ch7a2_3ec5421b:

    # a "The weather is cool here."
    a "Qui il clima è fresco."

# game/ch7.rpy:2315
translate italian ch7a2_eb21d033:

    # a "I really needed this."
    a "Ne avevo davvero bisogno."

# game/ch7.rpy:2318
translate italian ch7a2_5c10671f:

    # a "Although this tree isn't very comfortable."
    a "Anche se questo albero non è molto confortevole."

# game/ch7.rpy:2319
translate italian ch7a2_3f37cbfd:

    # mc "I think my side is more comfortable, shall we trade places?"
    mc "Penso che la mia parte sia più comoda, possiamo scambiarci di posto?"

# game/ch7.rpy:2321
translate italian ch7a2_a7f15683:

    # a "And then where will you sit?"
    a "E poi dove ti siederai?"

# game/ch7.rpy:2322
translate italian ch7a2_ced31899:

    # mc "Or you can sit here with me."
    mc "Oppure puoi sederti qui con me."

# game/ch7.rpy:2323
translate italian ch7a2_7bafe9eb:

    # a "I don't think there's room for both of us, is there?"
    a "Non credo che ci sia posto per entrambi, vero?"

# game/ch7.rpy:2324
translate italian ch7a2_e0798f8c:

    # mc "Yes there is."
    mc "Sì, c'è."

# game/ch7.rpy:2330
translate italian ch7a2_b23f2eab:

    # mc "Are you comfortable like this?"
    mc "Ti senti a tuo agio così?"

# game/ch7.rpy:2331
translate italian ch7a2_4af5e8df:

    # a "Very comfortable."
    a "Molto comodo."

# game/ch7.rpy:2334
translate italian ch7a2_167f52ad:

    # a "[mc], don't you think you spoil me too much?"
    a "[mc], non pensi di viziarmi troppo?"

# game/ch7.rpy:2335
translate italian ch7a2_2034c056:

    # mc "Maybe."
    mc "Forse."

# game/ch7.rpy:2336
translate italian ch7a2_3f337202:

    # mc "But I enjoy doing it."
    mc "Ma mi piace farlo."

# game/ch7.rpy:2337
translate italian ch7a2_ee5e6723:

    # a "[mc], you're a sweetheart."
    a "[mc], sei un tesoro."

# game/ch7.rpy:2341
translate italian ch7a2_fc286106:

    # a "Sometimes you don't realize how lucky you are."
    a "A volte non ti rendi conto di quanto sei fortunato."

# game/ch7.rpy:2342
translate italian ch7a2_54451fc3:

    # a "Just being able to see the sunlight, feel the grass. It's something so normalized that you forget how good it does your body and mind."
    a "Anche solo riuscire a vedere la luce del sole, sentire l'erba. È qualcosa di così normale che ti dimentichi di quanto faccia bene al tuo corpo e alla tua mente."

# game/ch7.rpy:2343
translate italian ch7a2_f800bed0:

    # mc "Yes."
    mc "SÌ."

# game/ch7.rpy:2346
translate italian ch7a2_0718d3a3:

    # mc "Or being able to give your loved ones a hug."
    mc "Oppure poter abbracciare i propri cari."

# game/ch7.rpy:2353
translate italian ch7a2_4f7c20a7:

    # mc "And give a kiss to the one you love the most."
    mc "E dai un bacio alla persona che ami di più."

# game/ch7.rpy:2359
translate italian ch7a2_6be4606d:

    # a "Does this mean I'm the one you love the most?"
    a "Vuol dire che sono la persona che ami di più?"

# game/ch7.rpy:2360
translate italian ch7a2_7f791efb:

    # mc "Yes, I think that's clear, isn't it?"
    mc "Sì, credo che sia chiaro, non è vero?"

# game/ch7.rpy:2362
translate italian ch7a2_8a33bd9a:

    # a "I didn't know that."
    a "Non lo sapevo."

# game/ch7.rpy:2364
translate italian ch7a2_5b1ad533:

    # mc "Who, if not you, deserves all my love the most?"
    mc "Chi, se non tu, merita di più tutto il mio amore?"

# game/ch7.rpy:2366
translate italian ch7a2_c0b3d913:

    # a "Thank you, [mc]. I love you too."
    a "Grazie, [mc]. Ti amo anch'io."

# game/ch7.rpy:2367
translate italian ch7a2_8139fe1e:

    # mc "Can I give you another kiss?"
    mc "Posso darti un altro bacio?"

# game/ch7.rpy:2369
translate italian ch7a2_ebb2afb6:

    # a "Sure."
    a "Sicuro."

# game/ch7.rpy:2377
translate italian ch7a2_e7654188:

    # a "Hmm, [mc]..."
    a "Mmm, [mc]..."

# game/ch7.rpy:2380
translate italian ch7a2_559b7537:

    # a "Hmm..."
    a "Hmm..."

# game/ch7.rpy:2383
translate italian ch7a2_da0e4d46:

    # a "[mc]..."
    a "[mc]..."

# game/ch7.rpy:2384
translate italian ch7a2_bc823c61:

    # a "People see us."
    a "La gente ci vede."

# game/ch7.rpy:2386
translate italian ch7a2_5f0fd0c3:

    # a "They might misinterpret this."
    a "Potrebbero fraintenderlo."

# game/ch7.rpy:2388
translate italian ch7a2_8be0f28c:

    # mc "(To misinterpret would be to think this is a simple kiss.)"
    mc "(Un'interpretazione errata equivarrebbe a pensare che si tratti di un semplice bacio.)"

# game/ch7.rpy:2391
translate italian ch7a2_d88837bc:

    # a "The children who were occupying the swings have just left."
    a "I bambini che occupavano le altalene se ne sono appena andati."

# game/ch7.rpy:2392
translate italian ch7a2_512a8846:

    # mc "Let's get on."
    mc "Andiamo avanti."

# game/ch7.rpy:2394
translate italian ch7a2_6d7b0f7a:

    # a "Do you think the janitor will say something to us if he sees us using the children's playground?"
    a "Pensi che il bidello ci dirà qualcosa se ci vede usare il parco giochi dei bambini?"

# game/ch7.rpy:2395
translate italian ch7a2_1fe5fc2b:

    # mc "I don't think so."
    mc "Non credo proprio."

# game/ch7.rpy:2396
translate italian ch7a2_135afd34:

    # mc "Besides, there's no sign that says an age limit or anything."
    mc "Inoltre, non c'è nessun cartello che indichi un limite di età o qualcosa del genere."

# game/ch7.rpy:2398
translate italian ch7a2_fbf9baa8:

    # a "We'd better avoid trouble."
    a "Meglio evitare guai."

# game/ch7.rpy:2399
translate italian ch7a2_5ee9eaa1:

    # mc "Let's go."
    mc "Andiamo."

# game/ch7.rpy:2401
translate italian ch7a2_f4ce14d6:

    # a "If the janitor scolds us I'll die of embarrassment."
    a "Se il bidello ci sgrida, morirò di vergogna."

# game/ch7.rpy:2402
translate italian ch7a2_b547b375:

    # mc "Nobody's going to scold us, come on."
    mc "Nessuno ci sgriderà, dai."

# game/ch7.rpy:2404
translate italian ch7a2_9f9cdfa8:

    # mc "Up."
    mc "Su."

# game/ch7.rpy:2420
translate italian ch7a2_98e15d11:

    # a "I see you're having fun."
    a "Vedo che ti stai divertendo."

# game/ch7.rpy:2421
translate italian ch7a2_af119cea:

    # mc "Like a kid, haha."
    mc "Come un bambino, ahah."

# game/ch7.rpy:2423
translate italian ch7a2_a472a424:

    # mc "Life is too short to be embarrassed about silly things."
    mc "La vita è troppo breve per vergognarsi di cose stupide."

# game/ch7.rpy:2425
translate italian ch7a2_f7192048:

    # a "You're having fun as a child while talking like an old man."
    a "Ti diverti come un bambino mentre parli come un vecchio."

# game/ch7.rpy:2426
translate italian ch7a2_3b2b0445:

    # mc "hahaha."
    mc "ahahaha."

# game/ch7.rpy:2427
translate italian ch7a2_a820589f:

    # mc "You're not going to swing?"
    mc "Non hai intenzione di dondolarti?"

# game/ch7.rpy:2428
translate italian ch7a2_0310332d:

    # a "I already am, don't you see?"
    a "Lo sono già, non vedi?"

# game/ch7.rpy:2429
translate italian ch7a2_af2d17e2:

    # mc "But you're just swinging with your feet."
    mc "Ma tu stai solo dondolando con i piedi."

# game/ch7.rpy:2430
translate italian ch7a2_7e388ec2:

    # a "I don't know how to do it."
    a "Non so come farlo."

# game/ch7.rpy:2432
translate italian ch7a2_085722e2:

    # mc "What?!"
    mc "Che cosa?!"

# game/ch7.rpy:2433
translate italian ch7a2_611e9701:

    # a "I don't know how to swing, not that high."
    a "Non so come dondolare, non così in alto."

# game/ch7.rpy:2435
translate italian ch7a2_f8ede985:

    # mc "This can't be.."
    mc "Questo non può essere."

# game/ch7.rpy:2436
translate italian ch7a2_c3786cda:

    # a "What's wrong?"
    a "Cosa c'è che non va?"

# game/ch7.rpy:2437
translate italian ch7a2_967a603b:

    # mc "You really don't know how to swing?"
    mc "Davvero non sai come dondolare?"

# game/ch7.rpy:2438
translate italian ch7a2_10db5c8d:

    # a "I didn't know it was a sin not to know how to use a swing."
    a "Non sapevo che fosse un peccato non saper usare un'altalena."

# game/ch7.rpy:2439
translate italian ch7a2_ff19b38a:

    # mc "You never got on a swing as a child?"
    mc "Da bambino non sei mai salito sull'altalena?"

# game/ch7.rpy:2440
translate italian ch7a2_601a455f:

    # a "No, but swinging that high certainly doesn't appeal to me either."
    a "No, ma neanche a me attrae l'idea di arrivare così in alto."

# game/ch7.rpy:2441
translate italian ch7a2_197d035c:

    # mc "Don't worry, you'll learn in a moment."
    mc "Non preoccuparti, imparerai in un attimo."

# game/ch7.rpy:2443
translate italian ch7a2_1a79256d:

    # a "I mean, I know I can do it."
    a "Voglio dire, so che posso farcela."

# game/ch7.rpy:2444
translate italian ch7a2_31644dc5:

    # mc "Yes, and you will."
    mc "Sì, e lo farai."

# game/ch7.rpy:2447
translate italian ch7a2_585d2d75:

    # a "Yes, like I told you, I know I can do it, I just don't do it because-"
    a "Sì, come ti ho detto, so che posso farlo, solo che non lo faccio perché-"

# game/ch7.rpy:2448
translate italian ch7a2_d9993729:

    # mc "Now we'll see if that's true."
    mc "Ora vedremo se è vero."

# game/ch7.rpy:2449
translate italian ch7a2_efc6c5dd:

    # a "I really don't like-"
    a "Non mi piace davvero-"

# game/ch7.rpy:2451
translate italian ch7a2_16912d63:

    # a "[mc]!!!"
    a "[mc]!!!"

# game/ch7.rpy:2452
translate italian ch7a2_2b17caba:

    # mc "Hold on tight."
    mc "Tieni duro."

# game/ch7.rpy:2453
translate italian ch7a2_6da3c05a:

    # a "{size=+5}Just don't push me so-"
    a "{size=+5}Non spingermi così-"

# game/ch7.rpy:2455
translate italian ch7a2_8e0ceb63:

    # a "{size=+6}High!!!"
    a "{size=+6}Alto!!!"

# game/ch7.rpy:2460
translate italian ch7a2_153b04e4:

    # a "That was fun."
    a "È stato divertente."

# game/ch7.rpy:2461
translate italian ch7a2_7b46ef71:

    # mc "I told you so."
    mc "Te l'avevo detto."

# game/ch7.rpy:2462
translate italian ch7a2_018f644a:

    # a "I think I've even gotten over my fear of heights a little bit."
    a "Penso di aver superato anche un po' la mia paura dell'altezza."

# game/ch7.rpy:2463
translate italian ch7a2_db96c5cf:

    # mc "Are you afraid of heights?"
    mc "Hai paura dell'altezza?"

# game/ch7.rpy:2464
translate italian ch7a2_f5c8d33a:

    # a "Yes!"
    a "SÌ!"

# game/ch7.rpy:2465
translate italian ch7a2_66496db6:

    # mc "Why didn't you tell me that!"
    mc "Perché non me l'hai detto!"

# game/ch7.rpy:2466
translate italian ch7a2_596ea0f0:

    # a "I tried to tell you, silly, I did but you didn't listen!"
    a "Ho provato a dirtelo, stupido, l'ho fatto ma tu non mi hai ascoltato!"

# game/ch7.rpy:2467
translate italian ch7a2_918fea83:

    # mc "I'm sorry."
    mc "Mi dispiace."

# game/ch7.rpy:2468
translate italian ch7a2_889774c6:

    # a "It was fun."
    a "È stato divertente."

# game/ch7.rpy:2469
translate italian ch7a2_807a1336:

    # mc "Look, the slide is unoccupied now."
    mc "Guarda, ora la diapositiva è vuota."

# game/ch7.rpy:2471
translate italian ch7a2_5b1d503c:

    # mc "Shall we slide?"
    mc "Vogliamo scivolare?"

# game/ch7.rpy:2472
translate italian ch7a2_444a74d3:

    # a "Hmm, I don't know, it doesn't look very chewy."
    a "Mmm, non lo so, non sembra molto gommoso."

# game/ch7.rpy:2473
translate italian ch7a2_63ad5d45:

    # a "I don't think it'll hold us."
    a "Non credo che ci tratterrà."

# game/ch7.rpy:2475
translate italian ch7a2_212ad1a2:

    # mc "Yes it will, these sets are designed to support the weight of several children at once."
    mc "Sì, certo, questi set sono progettati per sostenere il peso di più bambini contemporaneamente."

# game/ch7.rpy:2476
translate italian ch7a2_33251efb:

    # a "Swings are one thing, but this is too much."
    a "Le altalene sono una cosa, ma questo è troppo."

# game/ch7.rpy:2478
translate italian ch7a2_a788d3a3:

    # a "Although I've never been on one of these, with the little house and all..."
    a "Anche se non ci sono mai stato, con la casetta e tutto il resto..."

# game/ch7.rpy:2480
translate italian ch7a2_8f723594:

    # mc "Let's just go up to the top, without sliding, do you think?"
    mc "Che ne dici, saliamo fino in cima, senza scivolare?"

# game/ch7.rpy:2481
translate italian ch7a2_a09a393d:

    # a "I don't know..."
    a "Non lo so..."

# game/ch7.rpy:2483
translate italian ch7a2_119177e1:

    # a "What if the janitor comes and scolds us... that would be super embarrassing..."
    a "E se il bidello venisse a sgridarci... sarebbe davvero imbarazzante..."

# game/ch7.rpy:2484
translate italian ch7a2_9d24d234:

    # mc "Come on, nothing will happen, drug addicts hang out up there all the time."
    mc "Dai, non succederà niente, lì sopra ci sono sempre dei tossicodipendenti."

# game/ch7.rpy:2485
translate italian ch7a2_f1ffb46e:

    # a "Yeah, but..."
    a "Sì, ma..."

# game/ch7.rpy:2487
translate italian ch7a2_bbb51c4f:

    # a "If the janitor tells us something you'll take the blame, got it?"
    a "Se il bidello ci dice qualcosa, la colpa sarà tua, capito?"

# game/ch7.rpy:2488
translate italian ch7a2_014d78ee:

    # mc "Yes, yes, I will."
    mc "Sì, sì, lo farò."

# game/ch7.rpy:2492
translate italian ch7a2_760cc2c1:

    # mc "(Yummy...)"
    mc "(Delizioso...)"

# game/ch7.rpy:2495
translate italian ch7a2_02fcc311:

    # mc "So, did you change your mind?"
    mc "Quindi hai cambiato idea?"

# game/ch7.rpy:2496
translate italian ch7a2_d7ee22f5:

    # a "On the contrary, look how fragile it looks, this thing is going to break as soon as I sit down."
    a "Al contrario, guarda quanto sembra fragile, questa cosa si romperà non appena mi siederò."

# game/ch7.rpy:2497
translate italian ch7a2_77f93690:

    # a "Why don't you slide over and show me?"
    a "Perché non ti avvicini e me lo fai vedere?"

# game/ch7.rpy:2498
translate italian ch7a2_7661c675:

    # mc "I won't if you won't."
    mc "Non lo farò se non lo farai tu."

# game/ch7.rpy:2500
translate italian ch7a2_0a5250be:

    # a "You're not up to something, are you?"
    a "Non stai combinando niente, vero?"

# game/ch7.rpy:2501
translate italian ch7a2_3d0549b5:

    # mc "I'm up to something?"
    mc "Sto combinando qualcosa?"

# game/ch7.rpy:2502
translate italian ch7a2_300ee45e:

    # a "Yeah, like forcefully throwing me down the slide or something?"
    a "Sì, tipo buttarmi giù dallo scivolo con la forza o qualcosa del genere?"

# game/ch7.rpy:2503
translate italian ch7a2_2b35b6fe:

    # mc "..."
    mc "..."

# game/ch7.rpy:2504
translate italian ch7a2_e34911ac:

    # a "Don't even think about it!"
    a "Non pensarci nemmeno!"

# game/ch7.rpy:2505
translate italian ch7a2_23aec5c6:

    # mc "Haha, I won't."
    mc "Ahah, non lo farò."

# game/ch7.rpy:2509
translate italian ch7a2_58ba1940:

    # a "Places like this bring back a lot of nostalgia for me."
    a "Luoghi come questo mi suscitano molta nostalgia."

# game/ch7.rpy:2510
translate italian ch7a2_5daf79d5:

    # a "A lot of memories of my mother come to mind."
    a "Mi vengono in mente tanti ricordi di mia madre."

# game/ch7.rpy:2512
translate italian ch7a2_28bc9893:

    # mc "What was she like?"
    mc "Com'era?"

# game/ch7.rpy:2513
translate italian ch7a2_1a2bbb1d:

    # a "She was a good person, somewhat strict but very loving."
    a "Era una brava persona, un po' severa ma molto affettuosa."

# game/ch7.rpy:2514
translate italian ch7a2_1d9a6563:

    # a "A model mother of the time."
    a "Una madre modello dell'epoca."

# game/ch7.rpy:2515
translate italian ch7a2_5af14d60:

    # a "She suffered a lot before she died."
    a "Ha sofferto molto prima di morire."

# game/ch7.rpy:2516
translate italian ch7a2_e7b2aed0:

    # a "And when she did, it was a relief for both her and us."
    a "E quando lo fece, fu un sollievo sia per lei che per noi."

# game/ch7.rpy:2518
translate italian ch7a2_8709d0a7:

    # mc "Still, it had to be tough."
    mc "Tuttavia, dev'essere stata dura."

# game/ch7.rpy:2519
translate italian ch7a2_aab2bc03:

    # a "At first, because we all had hope that she would be cured."
    a "All'inizio perché tutti speravamo che guarisse."

# game/ch7.rpy:2520
translate italian ch7a2_1cdc062a:

    # a "She was diagnosed with stomach cancer. The hardest part was the journey to his passing."
    a "Le è stato diagnosticato un cancro allo stomaco. La parte più dura è stato il viaggio fino alla sua scomparsa."

# game/ch7.rpy:2521
translate italian ch7a2_8d8f2ac4:

    # a "And the day he died I felt a lot of relief really."
    a "E il giorno in cui morì provai davvero un grande sollievo."

# game/ch7.rpy:2523
translate italian ch7a2_38584c5d:

    # a "And after she died it was hard too, with no father or mother to take care of me my aunt had to take care of me."
    a "E dopo la sua morte è stato difficile anche per me, senza un padre o una madre che si prendessero cura di me, ma è stata mia zia a doversi occupare di me."

# game/ch7.rpy:2524
translate italian ch7a2_04d7d0b0:

    # mc "And your siblings?"
    mc "E i tuoi fratelli?"

# game/ch7.rpy:2525
translate italian ch7a2_a149f108:

    # a "They went with my father before that."
    a "Prima erano andati con mio padre."

# game/ch7.rpy:2526
translate italian ch7a2_054c5ee0:

    # mc "I see."
    mc "Vedo."

# game/ch7.rpy:2528
translate italian ch7a2_86af78be:

    # mc "What was your aunt like?"
    mc "Com'era tua zia?"

# game/ch7.rpy:2529
translate italian ch7a2_d448c792:

    # a "She wasn't very nice really."
    a "In realtà non era molto gentile."

# game/ch7.rpy:2530
translate italian ch7a2_3b8ff0b2:

    # a "She was hard to live with, not that she didn't love me, I don't think she even loved her own children, heh.."
    a "Era difficile vivere con lei, non che non mi amasse, credo che non amasse nemmeno i suoi figli, eh..."

# game/ch7.rpy:2531
translate italian ch7a2_4e69c4da:

    # a "That was one more reason to leave."
    a "Questo era un motivo in più per andarsene."

# game/ch7.rpy:2532
translate italian ch7a2_fae6a5b3:

    # mc "Leave where?"
    mc "Andare dove?"

# game/ch7.rpy:2534
translate italian ch7a2_2f27a1f8:

    # a "Let's leave that topic aside, I don't want to bore you with my stories."
    a "Lasciamo da parte questo argomento, non voglio annoiarvi con i miei racconti."

# game/ch7.rpy:2535
translate italian ch7a2_403cbb1d:

    # mc "No, no, I'm interested to know."
    mc "No, no, mi interessa saperlo."

# game/ch7.rpy:2536
translate italian ch7a2_8e429574:

    # a "Well."
    a "BENE."

# game/ch7.rpy:2539
translate italian ch7a2_cea806e1:

    # a "One day he came [d], asked me to marry him, and that same day I ran away with him."
    a "Un giorno è arrivato [d], mi ha chiesto di sposarlo e quello stesso giorno sono scappata con lui."

# game/ch7.rpy:2540
translate italian ch7a2_88ecd19d:

    # mc "How, did he come in through the window and steal you?"
    mc "Come è entrato dalla finestra e ti ha rubato?"

# game/ch7.rpy:2542
translate italian ch7a2_9993da03:

    # a "*Haha*, something like that."
    a "*Haha*, qualcosa del genere."

# game/ch7.rpy:2545
translate italian ch7a2_db1dc28b:

    # a "And we came to live in this town."
    a "E siamo venuti a vivere in questa città."

# game/ch7.rpy:2546
translate italian ch7a2_be3bbc00:

    # a "It was nice at the time, I was fulfilling my dream of having a husband, a house, a car..."
    a "All'epoca era bello, stavo realizzando il mio sogno di avere un marito, una casa, una macchina..."

# game/ch7.rpy:2547
translate italian ch7a2_715e1af1:

    # a "Later I had [k] and [s]."
    a "Più tardi ho avuto [k] e [s]."

# game/ch7.rpy:2548
translate italian ch7a2_935809b3:

    # a "And my life was already perfect, or so I thought."
    a "E la mia vita era già perfetta, o almeno così pensavo."

# game/ch7.rpy:2549
translate italian ch7a2_db6c2464:

    # mc "I see. So the [drelat] [d] was sort of an escape for you, at least at the time."
    mc "Capisco. Quindi [drelat] [d] era una specie di via di fuga per te, almeno all'epoca."

# game/ch7.rpy:2550
translate italian ch7a2_c47e038a:

    # a "That's right... Plus I really was in love."
    a "Esatto... E poi ero davvero innamorato."

# game/ch7.rpy:2551
translate italian ch7a2_f7189ab5:

    # a "But gradually everything deteriorated."
    a "Ma gradualmente tutto peggiorò."

# game/ch7.rpy:2552
translate italian ch7a2_bb8e4b4e:

    # a "..."
    a "..."

# game/ch7.rpy:2554
translate italian ch7a2_2aa21a92:

    # a "I stepped out of one cage into another, one with intangible bars that I built myself."
    a "Sono uscito da una gabbia ed sono entrato in un'altra, una gabbia con sbarre intangibili che avevo costruito io stesso."

# game/ch7.rpy:2555
translate italian ch7a2_b2b9e19d:

    # mc "What do you mean?"
    mc "Cosa intendi?"

# game/ch7.rpy:2559
translate italian ch7a2_69ba7e8c:

    # a "Since I was 17 years old I have dedicated myself to being a housewife and nothing else."
    a "Da quando avevo 17 anni mi sono dedicata esclusivamente alla vita casalinga."

# game/ch7.rpy:2560
translate italian ch7a2_bbbeb1f0:

    # a "I didn't finish high school, I don't have any work experience of any kind..."
    a "Non ho finito la scuola superiore, non ho alcuna esperienza lavorativa di alcun tipo..."

# game/ch7.rpy:2561
translate italian ch7a2_8ae15474:

    # a "Now I feel as if...{w=0.5} I am limiting myself because of my ineptitude."
    a "Adesso mi sento come se...{w=0.5} mi stessi limitando a causa della mia inettitudine."

# game/ch7.rpy:2562
translate italian ch7a2_81fa70de:

    # a "I feel incompetent, you know what I mean?"
    a "Mi sento incompetente, capisci cosa intendo?"

# game/ch7.rpy:2564
translate italian ch7a2_9659a314:

    # mc "There are a lot of people who don't even have a basic educational degree."
    mc "Ci sono molte persone che non hanno nemmeno un titolo di studio di base."

# game/ch7.rpy:2565
translate italian ch7a2_1344184b:

    # a "I know. But I can't help feeling that way."
    a "Lo so. Ma non posso fare a meno di sentirmi così."

# game/ch7.rpy:2566
translate italian ch7a2_fb127180:

    # a "I married [d] too young thinking this would never end."
    a "Ho sposato [d] troppo giovane, pensando che questa cosa non sarebbe mai finita."

# game/ch7.rpy:2568
translate italian ch7a2_62701a14:

    # a "I feel like I've somehow wasted my life."
    a "Mi sento come se avessi sprecato la mia vita."

# game/ch7.rpy:2569
translate italian ch7a2_2101db12:

    # a "If it weren't for my two daughters and you, I'd be sure of it."
    a "Se non fosse per le mie due figlie e per te, ne sarei certo."

# game/ch7.rpy:2572
translate italian ch7a2_38d92aee:

    # mc "Don't say that."
    mc "Non dire così."

# game/ch7.rpy:2573
translate italian ch7a2_1039e2de:

    # a "It's the truth."
    a "È la verità."

# game/ch7.rpy:2574
translate italian ch7a2_732ece62:

    # a "I've wasted my life being a kept woman, by a man who sees me as some kind of pet he just has to feed."
    a "Ho sprecato la mia vita come mantenuta da un uomo che mi vede come una specie di animale domestico da sfamare."

# game/ch7.rpy:2575
translate italian ch7a2_d8a032d6:

    # a "The worst thing is that I've been the one who decided to make it that way myself."
    a "La cosa peggiore è che sono stata io stessa a decidere di fare in modo che le cose andassero in questo modo."

# game/ch7.rpy:2577
translate italian ch7a2_ae7de870:

    # mc "That's not true."
    mc "Non è vero."

# game/ch7.rpy:2578
translate italian ch7a2_46bebd77:

    # mc "You don't stay married to him [drelat] [d] because you need him."
    mc "Non resti sposata con lui [drelat] [d] perché hai bisogno di lui."

# game/ch7.rpy:2579
translate italian ch7a2_340203da:

    # mc "You do it for your daughters, because you want to give them everything and that they don't lack a father, it's very different."
    mc "Lo fai per le tue figlie, perché vuoi dare loro tutto e perché non manchi loro un padre, è molto diverso."

# game/ch7.rpy:2581
translate italian ch7a2_d0c475d5:

    # mc "About wasting your life...{w=0.5} I don't really know the true meaning of that."
    mc "A proposito di sprecare la tua vita...{w=0.5} Non capisco davvero il vero significato di ciò."

# game/ch7.rpy:2582
translate italian ch7a2_30fd2d12:

    # mc "I just know that a little piece of that life that you wasted, you wasted on me."
    mc "So solo che un pezzettino di quella vita che hai sprecato, l'hai sprecato con me."

# game/ch7.rpy:2583
translate italian ch7a2_740055c7:

    # mc "When I got out of the hospital that day, no one believed I was going to recover from the aftermath."
    mc "Quando quel giorno uscii dall'ospedale, nessuno credeva che mi sarei ripreso dalle conseguenze."

# game/ch7.rpy:2584
translate italian ch7a2_bbc872e2:

    # mc "But you didn't give up, you took me to all my therapies."
    mc "Ma tu non ti sei arreso, mi hai portato a tutte le mie terapie."

# game/ch7.rpy:2585
translate italian ch7a2_0cee68ce:

    # mc "And now look at me, I'm fine because of you."
    mc "E ora guardami, sto bene grazie a te."

# game/ch7.rpy:2587
translate italian ch7a2_2a18efa2:

    # mc "That's why I'll do my best to make sure you don't feel like you've wasted your life from now on."
    mc "Ecco perché farò del mio meglio per assicurarmi che da ora in poi tu non abbia la sensazione di aver sprecato la tua vita."

# game/ch7.rpy:2590
translate italian ch7a2_0e1d1735:

    # a "Thank you, sweetheart."
    a "Grazie, tesoro."

# game/ch7.rpy:2618
translate italian ch7a2_61b34e93:

    # mc "When the day comes that you decide to divorce..."
    mc "Quando arriverà il giorno in cui deciderai di divorziare..."

# game/ch7.rpy:2619
translate italian ch7a2_96240060:

    # mc "If you let me...{w=0.5} I could take the role of [d]."
    mc "Se mi lasci...{w=0.5} potrei assumere il ruolo di [d]."

# game/ch7.rpy:2620
translate italian ch7a2_a20cefa7_1:

    # "..."
    "..."

# game/ch7.rpy:2623
translate italian ch7a2_e9560d6a:

    # a "What are you saying, [mc]?"
    a "Cosa stai dicendo, [mc]?"

# game/ch7.rpy:2625
translate italian ch7a2_b8b084bc:

    # mc "I'm serious."
    mc "Dico sul serio."

# game/ch7.rpy:2626
translate italian ch7a2_ed0f5653:

    # mc "I'll get a job, and I'll support you in any way I can."
    mc "Troverò un lavoro e ti sosterrò in ogni modo possibile."

# game/ch7.rpy:2629
translate italian ch7a2_747f076e:

    # a "Thank you, l-{w=0.5} I'll take it under advisement."
    a "Grazie, l-{w=0.5} Lo prenderò in considerazione."

# game/ch7.rpy:2630
translate italian ch7a2_bb8e4b4e_1:

    # a "..."
    a "..."

# game/ch7.rpy:2632
translate italian ch7a2_ffa75bfb:

    # a "Well... let's go back home, I have to get dinner ready."
    a "Bene... torniamo a casa, devo preparare la cena."

# game/ch7.rpy:2633
translate italian ch7a2_84d9991b:

    # mc "Yes..."
    mc "SÌ..."

# game/ch7.rpy:2636
translate italian ch7a2_a15b8be9:

    # a "I'm going to make potato stew today, do you want to help me?"
    a "Oggi preparerò uno stufato di patate, vuoi aiutarmi?"

# game/ch7.rpy:2637
translate italian ch7a2_606e2d02:

    # mc "Sure."
    mc "Sicuro."

# game/ch7.rpy:2647
translate italian ch7a3_b499a65e:

    # a "First cut it in half and{w=1} -No, not like that, lengthwise."
    a "Per prima cosa tagliatela a metà e {w=1} - No, non così, nel senso della lunghezza."

# game/ch7.rpy:2648
translate italian ch7a3_050de2a9:

    # mc "Hell, I've already stuck the knife in it."
    mc "Cavolo, ci ho già piantato il coltello dentro."

# game/ch7.rpy:2650
translate italian ch7a3_82b9c435:

    # a "Don't worry, what's important is that it's in medium-sized cubes."
    a "Non preoccuparti, l'importante è che siano cubetti di medie dimensioni."

# game/ch7.rpy:2651
translate italian ch7a3_c14c584c:

    # mc "Well..."
    mc "BENE..."

# game/ch7.rpy:2654
translate italian ch7a3_8114a09f:

    # mc "Uh..."
    mc "Ehm..."

# game/ch7.rpy:2655
translate italian ch7a3_4848bdd6:

    # mc "(Fuck, she's pressing her breasts against me...)"
    mc "(Cazzo, mi preme il seno contro...)"

# game/ch7.rpy:2656
translate italian ch7a3_f2a96a20:

    # mc "(I wonder if she's doing it on purpose.)"
    mc "(Mi chiedo se lo stia facendo apposta.)"

# game/ch7.rpy:2657
translate italian ch7a3_30350112:

    # a "No fear, [mc], it doesn't have to be so perfect either."
    a "Niente paura, [mc], non deve essere per forza perfetto."

# game/ch7.rpy:2659
translate italian ch7a3_dde1d44e:

    # mc "It makes me nervous that you're watching closely as I do it."
    mc "Mi innervosisce il fatto che tu mi osservi attentamente mentre lo faccio."

# game/ch7.rpy:2660
translate italian ch7a3_697ae4e2:

    # a "Are you afraid of a couple of potatoes?"
    a "Hai paura di un paio di patate?"

# game/ch7.rpy:2661
translate italian ch7a3_16a285d3:

    # mc "No, haha. {w=1} (I'm nervous about another pair...)"
    mc "No, haha. {w=1} (Sono nervoso per un altro paio...)"

# game/ch7.rpy:2664
translate italian ch7a3_d817568a:

    # mc "I think one of the best things a person can learn is how to cook."
    mc "Penso che una delle cose migliori che una persona possa imparare sia cucinare."

# game/ch7.rpy:2665
translate italian ch7a3_54210bcc:

    # mc "People who know how to cook well are always surrounded by friends."
    mc "Le persone che sanno cucinare bene sono sempre circondate da amici."

# game/ch7.rpy:2666
translate italian ch7a3_01385d0d:

    # a "Sure, because the parties are always at their house, because they're the ones who cook."
    a "Certo, perché le feste sono sempre a casa loro, perché sono loro che cucinano."

# game/ch7.rpy:2667
translate italian ch7a3_10d310ed:

    # mc "That's true, I hadn't thought of that."
    mc "È vero, non ci avevo pensato."

# game/ch7.rpy:2669
translate italian ch7a3_f56cbb1b:

    # a "Still, not relying on fast food and all that junk is good."
    a "Tuttavia, non affidarsi al fast food e a tutta quella robaccia è una buona idea."

# game/ch7.rpy:2670
translate italian ch7a3_861d41b1:

    # a "Besides, a man who cooks wins a lot of points."
    a "Inoltre, un uomo che cucina guadagna molti punti."

# game/ch7.rpy:2671
translate italian ch7a3_aee509ff:

    # mc "Oh, you think?"
    mc "Ah, cosa ne pensi?"

# game/ch7.rpy:2672
translate italian ch7a3_1984dd23:

    # a "Definitely. Imagine waking up and having breakfast brought to you in bed, *uff*..."
    a "Sicuramente. Immagina di svegliarti e di farti portare la colazione a letto,*uff*..."

# game/ch7.rpy:2673
translate italian ch7a3_7b50cb2a:

    # mc "I could bring you cereal and milk one of these days if you want."
    mc "Se vuoi, potrei portarti dei cereali e del latte uno di questi giorni."

# game/ch7.rpy:2674
translate italian ch7a3_94b0329e:

    # a "*laughs*, I'd love that."
    a "*ride*, mi piacerebbe molto."

# game/ch7.rpy:2677
translate italian ch7a3_81f15835:

    # a "Do you want to clean the veal?"
    a "Vuoi pulire il vitello?"

# game/ch7.rpy:2678
translate italian ch7a3_9a0b39db:

    # mc "No, I'll leave that to you."
    mc "No, lascio a te la decisione."

# game/ch7.rpy:2679
translate italian ch7a3_45428a68:

    # mc "I think that's a little more complicated."
    mc "Penso che sia un po' più complicato."

# game/ch7.rpy:2680
translate italian ch7a3_9584b653:

    # a "Not at all, you'll see."
    a "Niente affatto, vedrai."

# game/ch7.rpy:2682
translate italian ch7a3_20b8bcdb:

    # a "Pay attention, this is the most important part of the recipe."
    a "Fate attenzione, questa è la parte più importante della ricetta."

# game/ch7.rpy:2685
translate italian ch7a3_c1dff962:

    # mc "Oh..."
    mc "OH..."

