    d "Chef, di' al capitano di riportarci indietro, per favore, partiamo."

# game/ch7.rpy:3622
translate italian ch7_bj_k_afterpov_fa687c8e:

    # chef "Sure."
    chef "Sicuro."

# game/ch7.rpy:3626
translate italian ch7_bj_k_afterpov_66387a70:

    # d "I hope you guys had fun at least."
    d "Spero che almeno vi siate divertiti."

# game/ch7.rpy:3627
translate italian ch7_bj_k_afterpov_3c071c3a:

    # s "You did great, Dad."
    s "Sei stato bravissimo, papà."

# game/ch7.rpy:3628
translate italian ch7_bj_k_afterpov_cc038c40:

    # k "Yeah..."
    k "Sì..."

# game/ch7.rpy:3629
translate italian ch7_bj_k_afterpov_2f8025a8:

    # d "Thanks girls, at least you guys enjoyed yourselves."
    d "Grazie ragazze, almeno voi vi siete divertite."

# game/ch7.rpy:3630
translate italian ch7_bj_k_afterpov_e30c639c:

    # s "Don't you?"
    s "Tu no?"

# game/ch7.rpy:3631
translate italian ch7_bj_k_afterpov_b3352b9f:

    # d "I'm afraid not, honey..."
    d "Temo di no, tesoro..."

# game/ch7.rpy:3633
translate italian ch7_bj_k_afterpov_ca61bdc9:

    # s "You said you were going to take us somewhere more fun."
    s "Avevi detto che ci avresti portato in un posto più divertente."

# game/ch7.rpy:3634
translate italian ch7_bj_k_afterpov_edf21f60:

    # d "That was the plan, but I'm kind of discouraged already."
    d "Questo era il piano, ma sono già un po' scoraggiato."

# game/ch7.rpy:3635
translate italian ch7_bj_k_afterpov_2772e2e6_1:

    # s "Why?"
    s "Perché?"

# game/ch7.rpy:3636
translate italian ch7_bj_k_afterpov_64fdbca1:

    # d "Because someone doesn't appreciate me in the house, honey."
    d "Perché qualcuno in casa non mi apprezza, tesoro."

# game/ch7.rpy:3637
translate italian ch7_bj_k_afterpov_a4a75166:

    # d "And she only sees the bad things I do."
    d "E vede solo le cose brutte che faccio."

# game/ch7.rpy:3638
translate italian ch7_bj_k_afterpov_de97c3c6:

    # d "I keep going from trip to trip away from home so I can give you a better life, and what do I get?"
    d "Continuo ad andare di viaggio in viaggio lontano da casa così posso darti una vita migliore, e cosa ottengo?"

# game/ch7.rpy:3639
translate italian ch7_bj_k_afterpov_0cb4c11d:

    # d "Only reproaches and complaints."
    d "Solo rimproveri e lamentele."

# game/ch7.rpy:3640
translate italian ch7_bj_k_afterpov_4b742df6:

    # s "I do not reproach and complain."
    s "Non rimprovero e non mi lamento."

# game/ch7.rpy:3641
translate italian ch7_bj_k_afterpov_3866afc2:

    # d "I'm not talking about you, honey."
    d "Non sto parlando di te, tesoro."

# game/ch7.rpy:3642
translate italian ch7_bj_k_afterpov_41497a9b:

    # d "Don't you realize, [a], that you are tearing the family apart with your childishness?"
    d "Non ti rendi conto, [a], che con il tuo infantilismo stai facendo a pezzi la famiglia?"

# game/ch7.rpy:3643
translate italian ch7_bj_k_afterpov_23854fe4:

    # a "So I'm the one who is separating the family?"
    a "Quindi sono io che sto separando la famiglia?"

# game/ch7.rpy:3644
translate italian ch7_bj_k_afterpov_066250a4:

    # d "Yes, YOU are separating the family!"
    d "Sì, stai separando la famiglia!"

# game/ch7.rpy:3646
translate italian ch7_bj_k_afterpov_82eb813c:

    # a "[d], don't make me say things I don't want to!"
    a "[d], non farmi dire cose che non voglio!"

# game/ch7.rpy:3647
translate italian ch7_bj_k_afterpov_fd504806:

    # d "Speak, say what you have to say, I don't care."
    d "Parla, di' quello che hai da dire, non mi interessa."

# game/ch7.rpy:3648
translate italian ch7_bj_k_afterpov_6d3ac1f1:

    # d "The only thing you will do is prove me right."
    d "L'unica cosa che farai sarà dimostrarmi che ho ragione."

# game/ch7.rpy:3649
translate italian ch7_bj_k_afterpov_1c53595d:

    # a "You're a..."
    a "Sei un..."

# game/ch7.rpy:3652
translate italian ch7_bj_k_afterpov_ce321ccd:

    # d "Yeah, keep proving me right!"
    d "Sì, continua a dimostrarmi che ho ragione!"

# game/ch7.rpy:3653
translate italian ch7_bj_k_afterpov_21f51f89:

    # d "Keep proving how childish you are!"
    d "Continua a dimostrare quanto sei infantile!"

# game/ch7.rpy:3654
translate italian ch7_bj_k_afterpov_e77ccf4a:

    # d "Don't make this difficult, please, will you?"
    d "Non renderlo difficile, per favore, ok?"

# game/ch7.rpy:3655
translate italian ch7_bj_k_afterpov_d873bb54:

    # d "Whatever, we're leaving!"
    d "Comunque, ce ne andiamo!"

# game/ch7.rpy:3657
translate italian ch7_bj_k_afterpov_7779327e:

    # mc "(I have to go with her.)"
    mc "(Devo andare con lei.)"

# game/ch7.rpy:3658
translate italian ch7_bj_k_afterpov_e281435f:

    # d "[mc]."
    d "[mc]."

# game/ch7.rpy:3660
translate italian ch7_bj_k_afterpov_30751d53:

    # d "Go with her."
    d "Vai con lei."

# game/ch7.rpy:3661
translate italian ch7_bj_k_afterpov_77a0cecc:

    # mc "That's what I was going to do."
    mc "Questo è quello che stavo per fare."

# game/ch7.rpy:3662
translate italian ch7_bj_k_afterpov_8aa1b830:

    # d "Make sure she doesn't do anything foolish."
    d "Assicurati che non faccia nulla di stupido."

# game/ch7.rpy:3663
translate italian ch7_bj_k_afterpov_587a2d5b:

    # d "I'll take the girls back home, you guys take a cab."
    d "Io riporto le ragazze a casa, voi prendete un taxi."

# game/ch7.rpy:3667
translate italian ch7_bj_k_afterpov_bfb18c4c:

    # mc "[a], wait."
    mc "[a], aspetta."

# game/ch7.rpy:3670
translate italian ch7_bj_k_afterpov_b580629c:

    # a "Go back with them, I'll take a cab."
    a "Torna con loro, io prendo un taxi."

# game/ch7.rpy:3671
translate italian ch7_bj_k_afterpov_e380a80a:

    # mc "I came to keep you company."
    mc "Sono venuto a tenerti compagnia."

# game/ch7.rpy:3674
translate italian ch7_bj_k_afterpov_c1d220e9:

    # a "You were right, we should have stayed home."
    a "Avevi ragione, saremmo dovuti rimanere a casa."

# game/ch7.rpy:3676
translate italian ch7_bj_k_afterpov_6ab4a2b0:

    # a "Sorry for ruining our day, I didn't mean to."
    a "Scusa per averci rovinato la giornata, non volevo."

# game/ch7.rpy:3677
translate italian ch7_bj_k_afterpov_ce330cfb:

    # mc "No worries."
    mc "Nessun problema."

# game/ch7.rpy:3679
translate italian ch7_bj_k_afterpov_4c4cb12b:

    # a "I feel sadness and anger at the same time."
    a "Provo tristezza e rabbia allo stesso tempo."

# game/ch7.rpy:3681
translate italian ch7_bj_k_afterpov_ef714820:

    # a "Really, that man just keeps getting lower and lower."
    a "Davvero, quell'uomo continua ad abbassarsi sempre di più."

# game/ch7.rpy:3682
translate italian ch7_bj_k_afterpov_fcc6ec83:

    # a "I hate him with all my being right now."
    a "Lo odio con tutta me stessa in questo momento."

# game/ch7.rpy:3684
translate italian ch7_bj_k_afterpov_b00c694c:

    # a "I tried my hardest to act in a good way."
    a "Ho fatto del mio meglio per comportarmi bene."

# game/ch7.rpy:3685
translate italian ch7_bj_k_afterpov_4dc1485a:

    # a "But I couldn't."
    a "Ma non potevo."

# game/ch7.rpy:3686
translate italian ch7_bj_k_afterpov_45342695:

    # a "Seeing his hypocritical face makes me nauseous."
    a "Vedere la sua faccia ipocrita mi fa venire la nausea."

# game/ch7.rpy:3687
translate italian ch7_bj_k_afterpov_8f73b495:

    # a "I look forward to him going back to his ''business'' just not to see him."
    a "Non vedo l'ora che torni ai suoi 'affari' solo per non vederlo."

# game/ch7.rpy:3688
translate italian ch7_bj_k_afterpov_e23fb855:

    # a "What a despicable being..."
    a "Che essere spregevole..."

# game/ch7.rpy:3691
translate italian ch7_bj_k_afterpov_3eb0f521:

    # a "Sorry, he's still your [drelat]."
    a "Mi dispiace, è ancora il tuo [drelat]."

# game/ch7.rpy:3692
translate italian ch7_bj_k_afterpov_9e3483f2:

    # a "I shouldn't talk about him like that in front of you."
    a "Non dovrei parlare di lui in quel modo davanti a te."

# game/ch7.rpy:3693
translate italian ch7_bj_k_afterpov_0b15d407:

    # mc "Don't worry about it."
    mc "Non preoccuparti."

# game/ch7.rpy:3694
translate italian ch7_bj_k_afterpov_cac3d42f:

    # mc "Besides, you're right."
    mc "Inoltre, hai ragione."

# game/ch7.rpy:3695
translate italian ch7_bj_k_afterpov_3f8046ba:

    # mc "What he's doing to you I can't respect."
    mc "Quello che ti sta facendo non posso rispettarlo."

# game/ch7.rpy:3697
translate italian ch7_bj_k_afterpov_c2382201:

    # a "Promise me, [mc], that you're not going to be like him."
    a "Promettimi, [mc], che non sarai come lui."

# game/ch7.rpy:3699
translate italian ch7_bj_k_afterpov_e6de945e:

    # a "What am I saying?"
    a "Cosa sto dicendo?"

# game/ch7.rpy:3700
translate italian ch7_bj_k_afterpov_bf62af4c:

    # a "Obviously you would never be like that."
    a "Ovviamente non saresti mai così."

# game/ch7.rpy:3701
translate italian ch7_bj_k_afterpov_171a1c06:

    # a "You're a totally different man than he is."
    a "Sei un uomo totalmente diverso da lui."

# game/ch7.rpy:3704
translate italian ch7_bj_k_afterpov_43397045:

    # mc "You deserve so much more than this, [a]."
    mc "Meriti molto di più, [a]."

# game/ch7.rpy:3705
translate italian ch7_bj_k_afterpov_99a25882:

    # mc "You are an amazing woman."
    mc "Sei una donna straordinaria."

# game/ch7.rpy:3708
translate italian ch7_bj_k_afterpov_457e3e7a:

    # mc "He, [drelat] [d], doesn't realize how much he's missing."
    mc "Lui, [drelat] [d], non si rende conto di quanto gli manca."

# game/ch7.rpy:3709
translate italian ch7_bj_k_afterpov_69ee6ff3:

    # mc "I can't believe he's so stupid."
    mc "Non posso credere che sia così stupido."

# game/ch7.rpy:3710
translate italian ch7_bj_k_afterpov_82257322:

    # mc "It makes me furious."
    mc "Mi fa arrabbiare."

# game/ch7.rpy:3713
translate italian ch7_bj_k_afterpov_da0e4d46_5:

    # a "[mc]..."
    a "[mc]..."

# game/ch7.rpy:3714
translate italian ch7_bj_k_afterpov_0a279b43:

    # mc "I'm sorry, it's just..."
    mc "Mi dispiace, è solo che..."

# game/ch7.rpy:3715
translate italian ch7_bj_k_afterpov_b7248e79:

    # mc "You're so beautiful, faithful, loving.... There are not enough adjectives to describe you."
    mc "Sei così bella, fedele, amorevole.... Non ci sono abbastanza aggettivi per descriverti."

# game/ch7.rpy:3716
translate italian ch7_bj_k_afterpov_197e0f49:

    # mc "He's being an idiot to let a woman like you go."
    mc "È un idiota a lasciare andare una donna come te."

# game/ch7.rpy:3719
translate italian ch7_bj_k_afterpov_6f91f27e:

    # mc "If I were him, I would never forgive myself for losing you."
    mc "Se fossi in lui, non mi perdonerei mai di averti perso."

# game/ch7.rpy:3721
translate italian ch7_bj_k_afterpov_933ee837:

    # a "Thank you, dear."
    a "Grazie caro."

# game/ch7.rpy:3723
translate italian ch7_bj_k_afterpov_0330009e:

    # mc "By the way, I didn't see you eat on the yacht, aren't you hungry?"
    mc "A proposito, non ti ho visto mangiare sullo yacht, non hai fame?"

# game/ch7.rpy:3724
translate italian ch7_bj_k_afterpov_f0e944f8:

    # a "No, this whole thing left me with an upset stomach."
    a "No, tutta questa faccenda mi ha lasciato con il mal di stomaco."

# game/ch7.rpy:3725
translate italian ch7_bj_k_afterpov_23b38cfe:

    # a "When we get home I'll make myself something to eat."
    a "Quando arriviamo a casa mi preparo qualcosa da mangiare."

# game/ch7.rpy:3726
translate italian ch7_bj_k_afterpov_c32dcc06:

    # mc "We can take our time."
    mc "Possiamo prenderci il nostro tempo."

# game/ch7.rpy:3727
translate italian ch7_bj_k_afterpov_7153d6f8:

    # mc "What do you say we make time by walking around until we get hungry again and then go to one of these local restaurants?"
    mc "Che ne dici di trovare il tempo passeggiando finché non ci viene di nuovo fame e poi andiamo in uno di questi ristoranti locali?"

# game/ch7.rpy:3728
translate italian ch7_bj_k_afterpov_e5a76e3e:

    # a "That sounds good."
    a "Ottima idea."

# game/ch7.rpy:3730
translate italian ch7_bj_k_afterpov_cdb0555d:

    # a "I've never been around here before, it's a nice place."
    a "Non ero mai stata da queste parti prima, è un bel posto."

# game/ch7.rpy:3731
translate italian ch7_bj_k_afterpov_30413546:

    # mc "It's nice, yeah."
    mc "È bello, sì."

# game/ch7.rpy:3736
translate italian ch7_bj_k_afterpov_c8bf88ea:

    # mc "Really? you're lying to me."
    mc "Veramente? Mi stai mentendo."

# game/ch7.rpy:3737
translate italian ch7_bj_k_afterpov_a3ba49eb:

    # a "Really, I was rather ugly in my youth."
    a "In realtà da giovane ero piuttosto brutto."

# game/ch7.rpy:3738
translate italian ch7_bj_k_afterpov_67b8ab9c:

    # mc "Impossible."
    mc "Impossibile."

# game/ch7.rpy:3739
translate italian ch7_bj_k_afterpov_33c4c929:

    # a "At home I'll show you the pictures, but you can't show them to anyone else, you hear?"
    a "A casa ti faccio vedere le foto, ma tu non puoi mostrarle a nessun altro, capito?"

# game/ch7.rpy:3740
translate italian ch7_bj_k_afterpov_3f93714c:

    # mc "I won't, haha. I still think you're lying to me, though."
    mc "Non lo farò, ahah. Penso ancora che mi stai mentendo, però."

# game/ch7.rpy:3741
translate italian ch7_bj_k_afterpov_1228a72f:

    # a "I have to admit I have my charms now, but that doesn't mean I've always been beautiful."
    a "Devo ammettere che adesso ho il mio fascino, ma questo non significa che sono sempre stata bella."

# game/ch7.rpy:3742
translate italian ch7_bj_k_afterpov_41f54226:

    # mc "And modest have you always been?"
    mc "E modesto sei sempre stato?"

# game/ch7.rpy:3743
translate italian ch7_bj_k_afterpov_7a983106:

    # a "*laughs* You keep saying it so much that you ended up making me believe it."
    a "*ride* Continui a dirlo così tanto che alla fine me lo hai fatto credere."

# game/ch7.rpy:3744
translate italian ch7_bj_k_afterpov_4c7e2cbb:

    # mc "Haha, because you are."
    mc "Ahah, perché lo sei."

# game/ch7.rpy:3746
translate italian ch7_bj_k_afterpov_1b72979d:

    # a "Here's to us and to this afternoon that started out a little bad but ended up being really nice."
    a "Brindiamo a noi e a questo pomeriggio che è iniziato un po' male ma che alla fine si è rivelato davvero carino."

# game/ch7.rpy:3747
translate italian ch7_bj_k_afterpov_ee8e5ec0:

    # mc "And to your current beauty."
    mc "E alla tua attuale bellezza."

# game/ch7.rpy:3748
translate italian ch7_bj_k_afterpov_9fd71660:

    # a "And to my current beauty, *giggles*."
    a "E alla mia attuale bellezza, *ridacchia*."

# game/ch7.rpy:3753
translate italian ch7_bj_k_afterpov_7f1f1288:

    # a "[mc], why are you spending so much time with me lately? be honest."
    a "[mc], perché passi così tanto tempo con me ultimamente? essere onesti."

# game/ch7.rpy:3754
translate italian ch7_bj_k_afterpov_90a9480e:

    # a "Is it that you don't have any friends or something?"
    a "È perché non hai amici o qualcosa del genere?"

# game/ch7.rpy:3755
translate italian ch7_bj_k_afterpov_18c35432:

    # mc "What? I can't go out and have fun with my [arelat]?"
    mc "Che cosa? Non posso uscire e divertirmi con mio [arelat]?"

# game/ch7.rpy:3756
translate italian ch7_bj_k_afterpov_845e18d8:

    # a "I didn't mean it like that, you know what I mean."
    a "Non intendevo questo, sai cosa intendo."

# game/ch7.rpy:3757
translate italian ch7_bj_k_afterpov_35a70c11:

    # mc "I have friends, they usually invite me to hang out, but meh... lately I haven't felt like going out with them."
    mc "Ho degli amici, di solito mi invitano ad uscire, ma mah... ultimamente non ho voglia di uscire con loro."

# game/ch7.rpy:3758
translate italian ch7_bj_k_afterpov_080449aa:

    # a "And female friends?"
    a "E le amiche?"

# game/ch7.rpy:3759
translate italian ch7_bj_k_afterpov_8114a09f_3:

    # mc "Uh..."
    mc "Ehm..."

# game/ch7.rpy:3760
translate italian ch7_bj_k_afterpov_718cca2d:

    # mc "Hmm, ruling out [k], uh.."
    mc "Hmm, escludo [k], ehm..."

# game/ch7.rpy:3761
translate italian ch7_bj_k_afterpov_69d4a425:

    # mc "My last female friend ended up being my 'girlfriend' and when we broke up we stopped talking to each other."
    mc "La mia ultima amica è diventata la mia 'fidanzata' e quando ci siamo lasciati abbiamo smesso di parlarci."

# game/ch7.rpy:3762
translate italian ch7_bj_k_afterpov_18a4dc9f:

    # a "Your last female friend?"
    a "La tua ultima amica?"

# game/ch7.rpy:3763
translate italian ch7_bj_k_afterpov_6a9dcbaf:

    # a "So there have been more."
    a "Quindi ce ne sono stati di più."

# game/ch7.rpy:3764
translate italian ch7_bj_k_afterpov_00542135:

    # a "Did they become your girlfriends too and stopped talking to each other?"
    a "Sono diventate anche le tue amiche e hanno smesso di parlarsi?"

# game/ch7.rpy:3765
translate italian ch7_bj_k_afterpov_e334e13f:

    # mc "Something like that."
    mc "Qualcosa del genere."

# game/ch7.rpy:3766
translate italian ch7_bj_k_afterpov_c05a03f5:

    # a "Have all your girlfriends fallen in love with you?"
    a "Tutte le tue amiche si sono innamorate di te?"

# game/ch7.rpy:3767
translate italian ch7_bj_k_afterpov_09ac4223:

    # mc "Well... what can I say, I'm very attractive."
    mc "Beh... che dire, sono molto attraente."

# game/ch7.rpy:3768
translate italian ch7_bj_k_afterpov_922cf39b:

    # a "*laughs* You are."
    a "*ride* Lo sei."

# game/ch7.rpy:3769
translate italian ch7_bj_k_afterpov_1958156a:

    # a "We seem to be very much alike, at least in modesty."
    a "Sembriamo molto simili, almeno nella modestia."

# game/ch7.rpy:3770
translate italian ch7_bj_k_afterpov_01da0d11:

    # mc "*Haha* Yeah."
    mc "*Ahah* Già."

# game/ch7.rpy:3771
translate italian ch7_bj_k_afterpov_c98e5257:

    # a "It's normal, I mean, you're quite a catch."
    a "È normale, voglio dire, sei una vera cattura."

# game/ch7.rpy:3774
translate italian ch7_bj_k_afterpov_ca882876:

    # mc "Look, these lights I was telling you about. I think they'd look good at home."
    mc "Guarda, queste luci di cui ti parlavo. Penso che starebbero bene a casa."

# game/ch7.rpy:3775
translate italian ch7_bj_k_afterpov_788f8bde:

    # a "In our ''special place''?"
    a "Nel nostro ''posto speciale''?"

# game/ch7.rpy:3776
translate italian ch7_bj_k_afterpov_cf1adef2:

    # mc "Yeah."
    mc "Sì."

# game/ch7.rpy:3777
translate italian ch7_bj_k_afterpov_8707e636:

    # a "They're nice."
    a "Sono carini."

# game/ch7.rpy:3779
translate italian ch7_bj_k_afterpov_3e8979c3:

    # a "Let's go buy them tomorrow."
    a "Andiamo a comprarli domani."

# game/ch7.rpy:3780
translate italian ch7_bj_k_afterpov_5a5f8a70:

    # mc "That's what I was going to tell you, I know where they sell them."
    mc "E' quello che volevo dirti, so dove li vendono."

# game/ch7.rpy:3781
translate italian ch7_bj_k_afterpov_b8a7705e:

    # "*Beep*"
    "*Bip*"

# game/ch7.rpy:3784
translate italian ch7_bj_k_afterpov_54e01354:

    # a "Honey, we forgot to tell the girls we were spending the afternoon here."
    a "Tesoro, ci siamo dimenticati di dire alle ragazze che avremmo passato il pomeriggio qui."

# game/ch7.rpy:3785
