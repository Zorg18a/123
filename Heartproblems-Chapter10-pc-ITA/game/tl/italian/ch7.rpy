translate italian ch7s1_8eb59568:

    # d "No, no."
    d "No, no."

# game/ch7.rpy:3537
translate italian ch7s1_1e45280e:

    # d "The food they prepare here is five-star."
    d "Il cibo che preparano qui è a cinque stelle."

# game/ch7.rpy:3538
translate italian ch7s1_8d863439:

    # s "Five-star?"
    s "Cinque stelle?"

# game/ch7.rpy:3540
translate italian ch7s1_93faad3b:

    # d "Enough questions, the food will be amazing and after this we'll go somewhere fun, how about that."
    d "Basta con le domande, il cibo sarà fantastico e dopo andremo in qualche posto divertente, che ne dici?"

# game/ch7.rpy:3541
translate italian ch7s1_294e842a:

    # s "Yes!!!"
    s "SÌ!!!"

# game/ch7.rpy:3543
translate italian ch7s1_0d8eb35c:

    # mc "It's a nice place."
    mc "È un bel posto."

# game/ch7.rpy:3544
translate italian ch7s1_210c06eb:

    # a "Yes."
    a "SÌ."

# game/ch7.rpy:3550
translate italian ch7s1_8c786bb8:

    # chef "All set."
    chef "Tutto pronto."

# game/ch7.rpy:3552
translate italian ch7s1_96f22f30:

    # d "Great."
    d "Grande."

# game/ch7.rpy:3553
translate italian ch7s1_123adbf2:

    # chef "If you would be so kind as to accompany me please?"
    chef "Potreste essere così gentili da accompagnarmi, per favore?"

# game/ch7.rpy:3554
translate italian ch7s1_77ee7366:

    # s "Huh?"
    s "Cosa?"

# game/ch7.rpy:3555
translate italian ch7s1_67b8240d:

    # k "We're not eating here?"
    k "Non mangiamo qui?"

# game/ch7.rpy:3556
translate italian ch7s1_8f1d377f:

    # chef "Mr. [d] prepared something more special for you."
    chef "Il signor [d] ha preparato qualcosa di ancora più speciale per te."

# game/ch7.rpy:3557
translate italian ch7s1_7700a859:

    # chef "Please follow me."
    chef "Per favore seguitemi."

# game/ch7.rpy:3564
translate italian ch7s1_21e6960d:

    # s "Woah!!!"
    s "Oddio!!!"

# game/ch7.rpy:3565
translate italian ch7s1_007022ba:

    # s "I can barely make out the town, we're super far away!"
    s "Riesco a malapena a distinguere la città, siamo lontanissimi!"

# game/ch7.rpy:3566
translate italian ch7s1_c0f2f09b:

    # a "Be careful, [s]."
    a "Fai attenzione, [s]."

# game/ch7.rpy:3567
translate italian ch7s1_519a856a:

    # d "Come back here, the chef just served the food."
    d "Torna qui, lo chef ha appena servito il cibo."

# game/ch7.rpy:3569
translate italian ch7s1_000d2c87:

    # mc "Woah..."
    mc "Oddio..."

# game/ch7.rpy:3570
translate italian ch7s1_d4bff263:

    # d "Bon appetit."
    d "Buon appetito."

# game/ch7.rpy:3571
translate italian ch7s1_d0c05bfe:

    # k "Come now, [s]!"
    k "Forza, [s]!"

# game/ch7.rpy:3573
translate italian ch7s1_5ce503c7:

    # chef "I'll be in the cabins."
    chef "Sarò nelle cabine."

# game/ch7.rpy:3574
translate italian ch7s1_af420dd0:

    # chef "At your disposal for anything you need."
    chef "A tua disposizione per qualsiasi necessità."

# game/ch7.rpy:3575
translate italian ch7s1_49ec1d9c:

    # d "Thank you, Chef."
    d "Grazie, Chef."

# game/ch7.rpy:3580
translate italian ch7s1_87e4d4a4:

    # s "{i}Uhh... my tummy hurts."
    s "{i}Uhh... mi fa male la pancia."

# game/ch7.rpy:3581
translate italian ch7s1_ae2b64af:

    # a "You ate too much."
    a "Hai mangiato troppo."

# game/ch7.rpy:3582
translate italian ch7s1_9f992b3e:

    # s "{i}I can't move... uhh."
    s "{i}Non riesco a muovermi... uhh."

# game/ch7.rpy:3585
translate italian ch7s1_b40d36b9:

    # d "I want to toast to us, to the health and joy we are experiencing."
    d "Voglio brindare a noi, alla salute e alla gioia che stiamo vivendo."

# game/ch7.rpy:3586
translate italian ch7s1_c1f0d8dc:

    # d "And because, even though I'm not home most of the time for different work reasons, we're still a family."
    d "E perché, anche se per vari motivi di lavoro non sono a casa la maggior parte del tempo, siamo pur sempre una famiglia."

# game/ch7.rpy:3587
translate italian ch7s1_879ce4f1:

    # d "[a], I ask your forgiveness for not being around during our anniversary, nor during other special times when I should have been."
    d "[a], ti chiedo perdono per non essere stato presente durante il nostro anniversario, né in altri momenti speciali in cui avrei dovuto esserci."

# game/ch7.rpy:3588
translate italian ch7s1_fb77d8fa:

    # d "I don't expect this to pay for my mistake, I just want you to know how much I still love you even though sometimes I don't show it...{w=0.5} with actions."
    d "Non mi aspetto che questo paghi per il mio errore, voglio solo che tu sappia quanto ti amo ancora anche se a volte non lo dimostro... {w=0.5} con i fatti."

# game/ch7.rpy:3589
translate italian ch7s1_bb8e4b4e:

    # a "..."
    a "..."

# game/ch7.rpy:3592
translate italian ch7s1_3994461d:

    # d "[a], do you hear that?"
    d "[a], senti?"

# game/ch7.rpy:3593
translate italian ch7s1_bfc5ece7:

    # d "May I have this piece?"
    d "Posso avere questo pezzo?"

# game/ch7.rpy:3594
translate italian ch7s1_ddca982d:

    # k "Wow, Dad."
    k "Cavolo, papà."

# game/ch7.rpy:3595
translate italian ch7s1_bb8e4b4e_1:

    # a "..."
    a "..."

# game/ch7.rpy:3596
translate italian ch7s1_d49424f5:

    # a "Better not, I'm a little dizzy and I've just eaten.."
    a "Meglio di no, sono un po' frastornato e ho appena mangiato."

# game/ch7.rpy:3597
translate italian ch7s1_69bff48f:

    # d "It will only take a moment, I would like to have a photo like the one we have at home, where we danced when we were young.."
    d "Ci vorrà solo un attimo, vorrei avere una foto come quella che abbiamo a casa, dove ballavamo quando eravamo piccoli."

# game/ch7.rpy:3598
translate italian ch7s1_01368c9d:

    # a "I don't feel like it..."
    a "Non ne ho voglia..."

# game/ch7.rpy:3601
translate italian ch7s1_d485f36a:

    # d "Uh.."
    d "Ehm..."

# game/ch7.rpy:3602
translate italian ch7s1_25d1aa33:

    # d "Well... ok."
    d "Bene... ok."

# game/ch7.rpy:3605
translate italian ch7s1_b4fb6f9b:

    # k "What's the matter, [arelatks]?"
    k "Cosa c'è che non va, [arelatks]?"

# game/ch7.rpy:3606
translate italian ch7s1_4a7ee4da:

    # a "Nothing, I'm just not feeling very well today."
    a "Niente, è solo che oggi non mi sento molto bene."

# game/ch7.rpy:3607
translate italian ch7s1_1d371af6:

    # k "But [arelatks], today is a special day..."
    k "Ma [arelatks], oggi è un giorno speciale..."

# game/ch7.rpy:3608
translate italian ch7s1_35eb651e:

    # d "It's okay, [k]."
    d "Va bene, [k]."

# game/ch7.rpy:3610
translate italian ch7s1_9c3f8f2a:

    # d "I'd like to have a picture of us all together, can you at least grant me that, [a]?"
    d "Vorrei avere una foto di noi tutti insieme, puoi almeno concedermelo, [a]?"

# game/ch7.rpy:3611
translate italian ch7s1_8b482900:

    # d "[k], can you ask the chef to take the picture?"
    d "[k], puoi chiedere allo chef di scattare la foto?"

# game/ch7.rpy:3612
translate italian ch7s1_64ac4548:

    # k "Yes."
    k "SÌ."

# game/ch7.rpy:3615
translate italian ch7s1_09715049:

    # chef "Say 'cheese'."
    chef "Dì 'cheese'."

# game/ch7.rpy:3616
translate italian ch7s1_5474970e:

    # chef "One moment..."
    chef "Un attimo..."

# game/ch7.rpy:3619
translate italian ch7s1_4038a1c9:

    # chef "She won't be in the photo?"
    chef "Non sarà nella foto?"

# game/ch7.rpy:3620
translate italian ch7s1_003baee7:

    # d "Oh! [s], honey, wake up."
    d "Oh! [s], tesoro, svegliati."

# game/ch7.rpy:3622
translate italian ch7s1_1934262c:

    # chef "Say 'cheese'!"
    chef "Dite 'cheese'!"

# game/ch7.rpy:3626
translate italian ch7s1_7de91d17:

    # mc "Wait, [s] covered my face."
    mc "Aspetta, [s] mi ha coperto la faccia."

# game/ch7.rpy:3627
translate italian ch7s1_9f48527b:

    # s "*hahaha*"
    s "*ahahaha*"

# game/ch7.rpy:3628
translate italian ch7s1_4f5b255c:

    # a "[s], can you stop doing that?"
    a "[s], puoi smetterla di fare così?"

# game/ch7.rpy:3629
translate italian ch7s1_cc3d7a98:

    # s "Sorry, *haha*."
    s "Scusa,*haha*."

# game/ch7.rpy:3631
translate italian ch7s1_20e3b980:

    # d "Chef, can you take another one?"
    d "Chef, puoi prenderne un altro?"

# game/ch7.rpy:3632
translate italian ch7s1_cd774054:

    # d "I'd like to have a picture with my beautiful wife."
    d "Vorrei fare una foto con la mia bellissima moglie."

# game/ch7.rpy:3633
translate italian ch7s1_195c2d6c:

    # chef "Of course."
    chef "Ovviamente."

# game/ch7.rpy:3635
translate italian ch7s1_489b8613:

    # chef "Uhm.. excuse me, ma'am. can you turn to the camera for a second?"
    chef "Ehm... mi scusi, signora. Può girarsi verso la telecamera per un secondo?"

# game/ch7.rpy:3636
translate italian ch7s1_b7ecfc18:

    # chef "..."
    chef "..."

# game/ch7.rpy:3638
translate italian ch7s1_f4dfa35b:

    # d "[a], please can you put on a good face, at least for the photo?"
    d "[a], per favore, potresti assumere un atteggiamento positivo, almeno per la foto?"

# game/ch7.rpy:3639
translate italian ch7s1_a20cefa7_1:

    # "..."
    "..."

# game/ch7.rpy:3642
translate italian ch7s1_e714206e:

    # d "Forget it."
    d "Lasci perdere."

# game/ch7.rpy:3643
translate italian ch7s1_d81e22cf:

    # d "You've been making that same disgusted face all damn day, I'm sick of it."
    d "Hai fatto sempre la stessa faccia disgustata per tutto il giorno, ne ho abbastanza."

# game/ch7.rpy:3644
translate italian ch7s1_d82bd2d8:

    # d "If you were going to be with that attitude, what the hell are you coming here for?"
    d "Se avessi questo atteggiamento, perché diavolo saresti venuto a fare qui?"

# game/ch7.rpy:3645
translate italian ch7s1_dcf8cac3:

    # d "Chef, tell the captain to take us back, please, we're leaving."
    d "Chef, per favore, di' al capitano di riportarci indietro, stiamo partendo."

# game/ch7.rpy:3646
translate italian ch7s1_fa687c8e:

    # chef "Sure."
    chef "Sicuro."

# game/ch7.rpy:3650
translate italian ch7s1_66387a70:

    # d "I hope you guys had fun at least."
    d "Spero almeno che vi siate divertiti."

# game/ch7.rpy:3651
translate italian ch7s1_3c071c3a:

    # s "You did great, Dad."
    s "Hai fatto benissimo, papà."

# game/ch7.rpy:3652
translate italian ch7s1_cc038c40:

    # k "Yeah..."
    k "Sì..."

# game/ch7.rpy:3653
translate italian ch7s1_2f8025a8:

    # d "Thanks girls, at least you guys enjoyed yourselves."
    d "Grazie ragazze, almeno vi siete divertite."

# game/ch7.rpy:3654
translate italian ch7s1_e30c639c:

    # s "Don't you?"
    s "Non è vero?"

# game/ch7.rpy:3655
translate italian ch7s1_b3352b9f:

    # d "I'm afraid not, honey..."
    d "Temo di no, tesoro..."

# game/ch7.rpy:3657
translate italian ch7s1_ca61bdc9:

    # s "You said you were going to take us somewhere more fun."
    s "Avevi detto che ci avresti portato in un posto più divertente."

# game/ch7.rpy:3658
translate italian ch7s1_edf21f60:

    # d "That was the plan, but I'm kind of discouraged already."
    d "Questo era il piano, ma sono già un po' scoraggiato."

# game/ch7.rpy:3659
translate italian ch7s1_2772e2e6_1:

    # s "Why?"
    s "Perché?"

# game/ch7.rpy:3660
translate italian ch7s1_64fdbca1:

    # d "Because someone doesn't appreciate me in the house, honey."
    d "Perché in casa c'è qualcuno che non mi apprezza, tesoro."

# game/ch7.rpy:3661
translate italian ch7s1_a4a75166:

    # d "And she only sees the bad things I do."
    d "E lei vede solo le cose cattive che faccio."

# game/ch7.rpy:3662
translate italian ch7s1_de97c3c6:

    # d "I keep going from trip to trip away from home so I can give you a better life, and what do I get?"
    d "Continuo a viaggiare lontano da casa in viaggio per offrirti una vita migliore, e cosa ottengo?"

# game/ch7.rpy:3663
translate italian ch7s1_0cb4c11d:

    # d "Only reproaches and complaints."
    d "Solo rimproveri e lamentele."

# game/ch7.rpy:3664
translate italian ch7s1_4b742df6:

    # s "I do not reproach and complain."
    s "Non rimprovero e non mi lamento."

# game/ch7.rpy:3665
translate italian ch7s1_3866afc2:

    # d "I'm not talking about you, honey."
    d "Non sto parlando di te, tesoro."

# game/ch7.rpy:3666
translate italian ch7s1_41497a9b:

    # d "Don't you realize, [a], that you are tearing the family apart with your childishness?"
    d "Non ti rendi conto, [a], che stai distruggendo la famiglia con il tuo infantilismo?"

# game/ch7.rpy:3667
translate italian ch7s1_23854fe4:

    # a "So I'm the one who is separating the family?"
    a "Quindi sono io quello che separa la famiglia?"

# game/ch7.rpy:3668
translate italian ch7s1_066250a4:

    # d "Yes, YOU are separating the family!"
    d "Sì, TU stai separando la famiglia!"

# game/ch7.rpy:3670
translate italian ch7s1_82eb813c:

    # a "[d], don't make me say things I don't want to!"
    a "[d], non farmi dire cose che non voglio!"

# game/ch7.rpy:3671
translate italian ch7s1_fd504806:

    # d "Speak, say what you have to say, I don't care."
    d "Parla, di' quello che hai da dire, non mi interessa."

# game/ch7.rpy:3672
translate italian ch7s1_6d3ac1f1:

    # d "The only thing you will do is prove me right."
    d "L'unica cosa che farai sarà darmi ragione."

# game/ch7.rpy:3673
translate italian ch7s1_1c53595d:

    # a "You're a..."
    a "Tu sei un..."

# game/ch7.rpy:3676
translate italian ch7s1_ce321ccd:

    # d "Yeah, keep proving me right!"
    d "Sì, continua a darmi ragione!"

# game/ch7.rpy:3677
translate italian ch7s1_21f51f89:

    # d "Keep proving how childish you are!"
    d "Continua a dimostrare quanto sei infantile!"

# game/ch7.rpy:3678
translate italian ch7s1_e77ccf4a:

    # d "Don't make this difficult, please, will you?"
    d "Per favore, non rendere le cose difficili, ok?"

# game/ch7.rpy:3679
translate italian ch7s1_d873bb54:

    # d "Whatever, we're leaving!"
    d "Comunque, ce ne andiamo!"

# game/ch7.rpy:3681
translate italian ch7s1_7779327e:

    # mc "(I have to go with her.)"
    mc "(Devo andare con lei.)"

# game/ch7.rpy:3682
translate italian ch7s1_e281435f:

    # d "[mc]."
    d "[mc]."

# game/ch7.rpy:3684
translate italian ch7s1_30751d53:

    # d "Go with her."
    d "Vai con lei."

# game/ch7.rpy:3685
translate italian ch7s1_77a0cecc:

    # mc "That's what I was going to do."
    mc "Ecco cosa avevo intenzione di fare."

# game/ch7.rpy:3686
translate italian ch7s1_8aa1b830:

    # d "Make sure she doesn't do anything foolish."
    d "Assicuratevi che non faccia nulla di stupido."

# game/ch7.rpy:3687
translate italian ch7s1_587a2d5b:

    # d "I'll take the girls back home, you guys take a cab."
    d "Io riaccompagno le ragazze a casa, voi prendete un taxi."

# game/ch7.rpy:3691
translate italian ch7s1_bfb18c4c:

    # mc "[a], wait."
    mc "[a], aspetta."

# game/ch7.rpy:3694
translate italian ch7s1_b580629c:

    # a "Go back with them, I'll take a cab."
    a "Torna indietro con loro, prenderò un taxi."

# game/ch7.rpy:3695
translate italian ch7s1_e380a80a:

    # mc "I came to keep you company."
    mc "Sono venuto per tenerti compagnia."

# game/ch7.rpy:3698
translate italian ch7s1_c1d220e9:

    # a "You were right, we should have stayed home."
    a "Avevi ragione, avremmo dovuto restare a casa."

# game/ch7.rpy:3700
translate italian ch7s1_6ab4a2b0:

    # a "Sorry for ruining our day, I didn't mean to."
    a "Mi dispiace di averci rovinato la giornata, non volevo."

# game/ch7.rpy:3701
translate italian ch7s1_ce330cfb:

    # mc "No worries."
    mc "Nessun problema."

# game/ch7.rpy:3703
translate italian ch7s1_4c4cb12b:

    # a "I feel sadness and anger at the same time."
    a "Provo tristezza e rabbia allo stesso tempo."

# game/ch7.rpy:3705
translate italian ch7s1_ef714820:

    # a "Really, that man just keeps getting lower and lower."
    a "Davvero, quell'uomo continua a scendere sempre più in basso."

# game/ch7.rpy:3706
translate italian ch7s1_fcc6ec83:

    # a "I hate him with all my being right now."
    a "In questo momento lo odio con tutto il mio essere."

# game/ch7.rpy:3708
translate italian ch7s1_b00c694c:

    # a "I tried my hardest to act in a good way."
    a "Ho fatto del mio meglio per comportarmi in modo corretto."

# game/ch7.rpy:3709
translate italian ch7s1_4dc1485a:

    # a "But I couldn't."
    a "Ma non ci sono riuscito."

# game/ch7.rpy:3710
translate italian ch7s1_45342695:

    # a "Seeing his hypocritical face makes me nauseous."
    a "Vedere la sua faccia ipocrita mi fa venire la nausea."

# game/ch7.rpy:3711
translate italian ch7s1_8f73b495:

    # a "I look forward to him going back to his ''business'' just not to see him."
    a "Non vedo l'ora che torni ai suoi 'affari', solo per non vederlo più."

# game/ch7.rpy:3712
translate italian ch7s1_e23fb855:

    # a "What a despicable being..."
    a "Che essere spregevole..."

# game/ch7.rpy:3715
translate italian ch7s1_3eb0f521:

    # a "Sorry, he's still your [drelat]."
    a "Mi dispiace, è ancora il tuo [drelat]."

# game/ch7.rpy:3716
translate italian ch7s1_9e3483f2:

    # a "I shouldn't talk about him like that in front of you."
    a "Non dovrei parlare di lui in quel modo davanti a te."

# game/ch7.rpy:3717
translate italian ch7s1_0b15d407:

    # mc "Don't worry about it."
    mc "Non preoccuparti."

# game/ch7.rpy:3718
translate italian ch7s1_cac3d42f:

    # mc "Besides, you're right."
    mc "Inoltre hai ragione."

# game/ch7.rpy:3719
translate italian ch7s1_3f8046ba:

    # mc "What he's doing to you I can't respect."
    mc "Ciò che ti sta facendo non posso rispettarlo."

# game/ch7.rpy:3721
translate italian ch7s1_c2382201:

    # a "Promise me, [mc], that you're not going to be like him."
    a "Promettimi, [mc], che non sarai come lui."

# game/ch7.rpy:3723
translate italian ch7s1_e6de945e:

    # a "What am I saying?"
    a "Cosa sto dicendo?"

# game/ch7.rpy:3724
translate italian ch7s1_bf62af4c:

    # a "Obviously you would never be like that."
    a "Ovviamente non saresti mai così."

# game/ch7.rpy:3725
translate italian ch7s1_171a1c06:

    # a "You're a totally different man than he is."
    a "Tu sei un uomo completamente diverso da lui."

# game/ch7.rpy:3728
translate italian ch7s1_43397045:

    # mc "You deserve so much more than this, [a]."
    mc "Meriti molto di più, [a]."

# game/ch7.rpy:3729
translate italian ch7s1_99a25882:

    # mc "You are an amazing woman."
    mc "Sei una donna straordinaria."

# game/ch7.rpy:3732
translate italian ch7s1_457e3e7a:

    # mc "He, [drelat] [d], doesn't realize how much he's missing."
    mc "Lui, [drelat] [d], non si rende conto di quanto si sta perdendo."

# game/ch7.rpy:3733
translate italian ch7s1_69ee6ff3:

    # mc "I can't believe he's so stupid."
    mc "Non riesco a credere che sia così stupido."

# game/ch7.rpy:3734
translate italian ch7s1_82257322:

    # mc "It makes me furious."
    mc "Mi fa infuriare."

# game/ch7.rpy:3737
translate italian ch7s1_da0e4d46:

    # a "[mc]..."
    a "[mc]..."

# game/ch7.rpy:3738
translate italian ch7s1_0a279b43:

    # mc "I'm sorry, it's just..."
    mc "Mi dispiace, è solo che..."

