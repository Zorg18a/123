translate italian ch7_bj_k_afterpov_c6fccb0a:

    # a "I don't have anything to talk to you about."
    a "Non ho niente di cui parlarti."

# game/ch7.rpy:2236
translate italian ch7_bj_k_afterpov_079de091:

    # d "Come on, this is no time to be angry, can't you be happy for all of us?"
    d "Andiamo, non è il momento di arrabbiarsi, non puoi essere felice per tutti noi?"

# game/ch7.rpy:2238
translate italian ch7_bj_k_afterpov_49b417c4:

    # d "You need to tell me what's going on or I won't be able to remedy it."
    d "Devi dirmi cosa sta succedendo altrimenti non sarò in grado di rimediare."

# game/ch7.rpy:2239
translate italian ch7_bj_k_afterpov_366e60f2:

    # d "If it's about our anniversary I'll make it up to you, I promise."
    d "Se si tratta del nostro anniversario mi farò perdonare, te lo prometto."

# game/ch7.rpy:2240
translate italian ch7_bj_k_afterpov_d47b8bec:

    # d "That's it, isn't it?"
    d "Questo è tutto, non è vero?"

# game/ch7.rpy:2241
translate italian ch7_bj_k_afterpov_85bc774e:

    # d "You can't get mad over nonsense like that."
    d "Non puoi arrabbiarti per sciocchezze del genere."

# game/ch7.rpy:2242
translate italian ch7_bj_k_afterpov_d8e46895:

    # a "Do you really think I'm that dumb?"
    a "Pensi davvero che io sia così stupido?"

# game/ch7.rpy:2243
translate italian ch7_bj_k_afterpov_1523fe20_1:

    # d "..."
    d "..."

# game/ch7.rpy:2244
translate italian ch7_bj_k_afterpov_13f469b3:

    # d "There you go with that again..."
    d "Eccoci di nuovo con quello..."

# game/ch7.rpy:2246
translate italian ch7_bj_k_afterpov_a4f62783:

    # d "[a], you're making up stories in your head that have nothing to do with reality."
    d "[a], stai inventando storie nella tua testa che non hanno nulla a che fare con la realtà."

# game/ch7.rpy:2247
translate italian ch7_bj_k_afterpov_e2e88553:

    # a "I don't want to talk now, [d]."
    a "Non voglio parlare adesso, [d]."

# game/ch7.rpy:2248
translate italian ch7_bj_k_afterpov_a8ddbe5e:

    # d "You know what, I don't care. I'm tired of it."
    d "Sai una cosa, non mi interessa. Sono stanco di ciò."

# game/ch7.rpy:2255
translate italian ch7_bj_k_afterpov_5a42b074:

    # mc "I see that things are not getting any better."
    mc "Vedo che le cose non migliorano."

# game/ch7.rpy:2256
translate italian ch7_bj_k_afterpov_9fff7b10:

    # a "I'm tired of this."
    a "Sono stanco di questo."

# game/ch7.rpy:2258
translate italian ch7_bj_k_afterpov_e1fed88a:

    # a "I've been having that nauseous feeling all day."
    a "Ho avuto quella sensazione di nausea tutto il giorno."

# game/ch7.rpy:2259
translate italian ch7_bj_k_afterpov_0d550edf:

    # a "Doing chores and hanging out together made me forget all about this."
    a "Fare le faccende domestiche e uscire insieme mi ha fatto dimenticare tutto questo."

# game/ch7.rpy:2261
translate italian ch7_bj_k_afterpov_e6f49919:

    # a "But it's seeing [d]'s face and I feel sick again."
    a "Ma è vedere la faccia di [d] e mi viene di nuovo la nausea."

# game/ch7.rpy:2263
translate italian ch7_bj_k_afterpov_2f81ae4d:

    # mc "Do you want to go for a walk in the park?"
    mc "Vuoi fare una passeggiata nel parco?"

# game/ch7.rpy:2264
translate italian ch7_bj_k_afterpov_3dbce83c:

    # mc "To take your mind off things."
    mc "Per distrarti dalle cose."

# game/ch7.rpy:2266
translate italian ch7_bj_k_afterpov_3722dc31:

    # a "Yes, please."
    a "Sì grazie."

# game/ch7.rpy:2267
translate italian ch7_bj_k_afterpov_f9943e78:

    # mc "Okay, let's go."
    mc "Ok andiamo."

# game/ch7.rpy:2280
translate italian ch7_bj_k_afterpov_3c723fe0:

    # a "I haven't been here in a while."
    a "È da un po' che non vengo qui."

# game/ch7.rpy:2281
translate italian ch7_bj_k_afterpov_c6e06d43:

    # a "They upgraded the place, it's cleaner than before."
    a "Hanno aggiornato il posto, è più pulito di prima."

# game/ch7.rpy:2282
translate italian ch7_bj_k_afterpov_bfa8dde4:

    # mc "Yes, they made renovations and increased security because they opened a school near here."
    mc "Sì, hanno fatto dei lavori di ristrutturazione e hanno aumentato la sicurezza perché hanno aperto una scuola qui vicino."

# game/ch7.rpy:2283
translate italian ch7_bj_k_afterpov_b6cf92d5:

    # a "I remember why we didn't come to this area of the park, there were always people doing drugs and sleeping on the benches."
    a "Ricordo perché non venivamo in questa zona del parco, c'era sempre gente che si drogava e dormiva sulle panchine."

# game/ch7.rpy:2284
translate italian ch7_bj_k_afterpov_0bcdd430:

    # a "They even put in playground equipment for the kids."
    a "Hanno anche messo delle attrezzature da gioco per i bambini."

# game/ch7.rpy:2286
translate italian ch7_bj_k_afterpov_ef4bf92f:

    # a "It's a bit unfair, don't you think? there should be park games for adults too."
    a "È un po' ingiusto, non credi? dovrebbero esserci giochi da parco anche per adulti."

# game/ch7.rpy:2287
translate italian ch7_bj_k_afterpov_38851deb:

    # mc "I don't think it's a good idea, especially since this is a public space."
    mc "Non penso che sia una buona idea, soprattutto perché si tratta di uno spazio pubblico."

# game/ch7.rpy:2288
translate italian ch7_bj_k_afterpov_8dabefc6:

    # ".."
    ".."

# game/ch7.rpy:2289
translate italian ch7_bj_k_afterpov_f6688ccc:

    # a "Uh? Why does it matter that it's a public space? I don't understand."
    a "Eh? Perché è importante che sia uno spazio pubblico? Non capisco."

# game/ch7.rpy:2290
translate italian ch7_bj_k_afterpov_9d908a96:

    # mc "That the children might be traumatized."
    mc "Che i bambini potrebbero essere traumatizzati."

# game/ch7.rpy:2291
translate italian ch7_bj_k_afterpov_a20cefa7_2:

    # "..."
    "..."

# game/ch7.rpy:2293
translate italian ch7_bj_k_afterpov_70657c0a:

    # a "I still don't understand."
    a "Ancora non capisco."

# game/ch7.rpy:2294
translate italian ch7_bj_k_afterpov_a38917e4:

    # mc "Forget it, it was a bad joke."
    mc "Lascia perdere, era un brutto scherzo."

# game/ch7.rpy:2295
translate italian ch7_bj_k_afterpov_4fe203b0:

    # mc "We'd better go sit in the shade, the sun is burning me."
    mc "Sarà meglio andare a sederci all'ombra, il sole mi brucia."

# game/ch7.rpy:2296
translate italian ch7_bj_k_afterpov_0b02a424:

    # a "But can you explain the joke?"
    a "Ma potete spiegare la battuta?"

# game/ch7.rpy:2297
translate italian ch7_bj_k_afterpov_50afca21:

    # mc "Better not."
    mc "Meglio di no."

# game/ch7.rpy:2299
translate italian ch7_bj_k_afterpov_8c7b783d:

    # a "You have to explain it to me or I won't be able to sleep well today, haha."
    a "Devi spiegarmelo altrimenti non riuscirò a dormire bene oggi, ahah."

# game/ch7.rpy:2301
translate italian ch7_bj_k_afterpov_a094d770:

    # a "Ahh..."
    a "Ahh..."

# game/ch7.rpy:2302
translate italian ch7_bj_k_afterpov_3ec5421b:

    # a "The weather is cool here."
    a "Il tempo è bello qui."

# game/ch7.rpy:2305
translate italian ch7_bj_k_afterpov_eb21d033:

    # a "I really needed this."
    a "Ne avevo davvero bisogno."

# game/ch7.rpy:2308
translate italian ch7_bj_k_afterpov_5c10671f:

    # a "Although this tree isn't very comfortable."
    a "Anche se quest'albero non è molto comodo."

# game/ch7.rpy:2309
translate italian ch7_bj_k_afterpov_3f37cbfd:

    # mc "I think my side is more comfortable, shall we trade places?"
    mc "Penso che la mia parte sia più a suo agio, vogliamo scambiarci di posto?"

# game/ch7.rpy:2311
translate italian ch7_bj_k_afterpov_a7f15683:

    # a "And then where will you sit?"
    a "E poi dove ti siederai?"

# game/ch7.rpy:2312
translate italian ch7_bj_k_afterpov_ced31899:

    # mc "Or you can sit here with me."
    mc "Oppure puoi sederti qui con me."

# game/ch7.rpy:2313
translate italian ch7_bj_k_afterpov_7bafe9eb:

    # a "I don't think there's room for both of us, is there?"
    a "Non penso che ci sia spazio per entrambi, vero?"

# game/ch7.rpy:2314
translate italian ch7_bj_k_afterpov_e0798f8c:

    # mc "Yes there is."
    mc "Si C'è."

# game/ch7.rpy:2320
translate italian ch7_bj_k_afterpov_b23f2eab:

    # mc "Are you comfortable like this?"
    mc "Ti senti a tuo agio così?"

# game/ch7.rpy:2321
translate italian ch7_bj_k_afterpov_4af5e8df:

    # a "Very comfortable."
    a "Molto comodo."

# game/ch7.rpy:2324
translate italian ch7_bj_k_afterpov_167f52ad:

    # a "[mc], don't you think you spoil me too much?"
    a "[mc], non pensi di viziarmi troppo?"

# game/ch7.rpy:2325
translate italian ch7_bj_k_afterpov_2034c056:

    # mc "Maybe."
    mc "Forse."

# game/ch7.rpy:2326
translate italian ch7_bj_k_afterpov_3f337202:

    # mc "But I enjoy doing it."
    mc "Ma mi piace farlo."

# game/ch7.rpy:2327
translate italian ch7_bj_k_afterpov_ee5e6723:

    # a "[mc], you're a sweetheart."
    a "[mc], sei un tesoro."

# game/ch7.rpy:2331
translate italian ch7_bj_k_afterpov_fc286106:

    # a "Sometimes you don't realize how lucky you are."
    a "A volte non ti rendi conto di quanto sei fortunato."

# game/ch7.rpy:2332
translate italian ch7_bj_k_afterpov_54451fc3:

    # a "Just being able to see the sunlight, feel the grass. It's something so normalized that you forget how good it does your body and mind."
    a "Il solo fatto di poter vedere la luce del sole, sentire l'erba. È qualcosa di così normalizzato che dimentichi quanto fa bene al tuo corpo e alla tua mente."

# game/ch7.rpy:2333
translate italian ch7_bj_k_afterpov_f800bed0:

    # mc "Yes."
    mc "SÌ."

# game/ch7.rpy:2336
translate italian ch7_bj_k_afterpov_0718d3a3:

    # mc "Or being able to give your loved ones a hug."
    mc "O poter abbracciare i tuoi cari."

# game/ch7.rpy:2343
translate italian ch7_bj_k_afterpov_4f7c20a7:

    # mc "And give a kiss to the one you love the most."
    mc "E dai un bacio a chi ami di più."

# game/ch7.rpy:2349
translate italian ch7_bj_k_afterpov_6be4606d:

    # a "Does this mean I'm the one you love the most?"
    a "Questo significa che sono la persona che ami di più?"

# game/ch7.rpy:2350
translate italian ch7_bj_k_afterpov_7f791efb:

    # mc "Yes, I think that's clear, isn't it?"
    mc "Sì, penso che sia chiaro, no?"

# game/ch7.rpy:2352
translate italian ch7_bj_k_afterpov_8a33bd9a:

    # a "I didn't know that."
    a "Non lo sapevo."

# game/ch7.rpy:2354
translate italian ch7_bj_k_afterpov_5b1ad533:

    # mc "Who, if not you, deserves all my love the most?"
    mc "Chi, se non tu, merita di più tutto il mio amore?"

# game/ch7.rpy:2356
translate italian ch7_bj_k_afterpov_c0b3d913:

    # a "Thank you, [mc]. I love you too."
    a "Grazie, [mc]. Anch'io ti amo."

# game/ch7.rpy:2357
translate italian ch7_bj_k_afterpov_8139fe1e:

    # mc "Can I give you another kiss?"
    mc "Posso darti un altro bacio?"

# game/ch7.rpy:2359
translate italian ch7_bj_k_afterpov_ebb2afb6:

    # a "Sure."
    a "Sicuro."

# game/ch7.rpy:2367
translate italian ch7_bj_k_afterpov_e7654188:

    # a "Hmm, [mc]..."
    a "Uhm, [mc]..."

# game/ch7.rpy:2370
translate italian ch7_bj_k_afterpov_559b7537:

    # a "Hmm..."
    a "Hmm..."

# game/ch7.rpy:2373
translate italian ch7_bj_k_afterpov_da0e4d46:

    # a "[mc]..."
    a "[mc]..."

# game/ch7.rpy:2374
translate italian ch7_bj_k_afterpov_bc823c61:

    # a "People see us."
    a "La gente ci vede."

# game/ch7.rpy:2376
translate italian ch7_bj_k_afterpov_5f0fd0c3:

    # a "They might misinterpret this."
    a "Potrebbero interpretarlo male."

# game/ch7.rpy:2378
translate italian ch7_bj_k_afterpov_8be0f28c:

    # mc "(To misinterpret would be to think this is a simple kiss.)"
    mc "(Interpretare male significherebbe pensare che si tratti di un semplice bacio.)"

# game/ch7.rpy:2381
translate italian ch7_bj_k_afterpov_d88837bc:

    # a "The children who were occupying the swings have just left."
    a "I bambini che occupavano le altalene se ne sono appena andati."

# game/ch7.rpy:2382
translate italian ch7_bj_k_afterpov_512a8846:

    # mc "Let's get on."
    mc "Andiamo avanti."

# game/ch7.rpy:2384
translate italian ch7_bj_k_afterpov_6d7b0f7a:

    # a "Do you think the janitor will say something to us if he sees us using the children's playground?"
    a "Pensi che il custode ci dirà qualcosa se ci vede usare il parco giochi per bambini?"

# game/ch7.rpy:2385
translate italian ch7_bj_k_afterpov_1fe5fc2b:

    # mc "I don't think so."
    mc "Non credo."

# game/ch7.rpy:2386
translate italian ch7_bj_k_afterpov_135afd34:

    # mc "Besides, there's no sign that says an age limit or anything."
    mc "Oltretutto non c'è nessun cartello che indichi limiti di età o altro."

# game/ch7.rpy:2388
translate italian ch7_bj_k_afterpov_fbf9baa8:

    # a "We'd better avoid trouble."
    a "Faremo meglio a evitare guai."

# game/ch7.rpy:2389
translate italian ch7_bj_k_afterpov_5ee9eaa1:

    # mc "Let's go."
    mc "Andiamo."

# game/ch7.rpy:2391
translate italian ch7_bj_k_afterpov_f4ce14d6:

    # a "If the janitor scolds us I'll die of embarrassment."
    a "Se il custode ci sgrida muoio di imbarazzo."

# game/ch7.rpy:2392
translate italian ch7_bj_k_afterpov_b547b375:

    # mc "Nobody's going to scold us, come on."
    mc "Nessuno ci sgriderà, andiamo."

# game/ch7.rpy:2394
translate italian ch7_bj_k_afterpov_9f9cdfa8:

    # mc "Up."
    mc "Su."

# game/ch7.rpy:2410
translate italian ch7_bj_k_afterpov_98e15d11:

    # a "I see you're having fun."
    a "Vedo che ti stai divertendo."

# game/ch7.rpy:2411
translate italian ch7_bj_k_afterpov_af119cea:

    # mc "Like a kid, haha."
    mc "Come un bambino, ahah."

# game/ch7.rpy:2413
translate italian ch7_bj_k_afterpov_a472a424:

    # mc "Life is too short to be embarrassed about silly things."
    mc "La vita è troppo breve per vergognarsi di cose stupide."

# game/ch7.rpy:2415
translate italian ch7_bj_k_afterpov_f7192048:

    # a "You're having fun as a child while talking like an old man."
    a "Ti diverti come un bambino mentre parli come un vecchio."

# game/ch7.rpy:2416
translate italian ch7_bj_k_afterpov_3b2b0445:

    # mc "hahaha."
    mc "Hahaha."

# game/ch7.rpy:2417
translate italian ch7_bj_k_afterpov_a820589f:

    # mc "You're not going to swing?"
    mc "Non oscillerai?"

# game/ch7.rpy:2418
translate italian ch7_bj_k_afterpov_0310332d:

    # a "I already am, don't you see?"
    a "Lo sono già, non vedi?"

# game/ch7.rpy:2419
translate italian ch7_bj_k_afterpov_af2d17e2:

    # mc "But you're just swinging with your feet."
    mc "Ma stai semplicemente oscillando con i piedi."

# game/ch7.rpy:2420
translate italian ch7_bj_k_afterpov_7e388ec2:

    # a "I don't know how to do it."
    a "Non so come farlo."

# game/ch7.rpy:2422
translate italian ch7_bj_k_afterpov_085722e2_1:

    # mc "What?!"
    mc "Che cosa?!"

# game/ch7.rpy:2423
translate italian ch7_bj_k_afterpov_611e9701:

    # a "I don't know how to swing, not that high."
    a "Non so come oscillare, non così in alto."

# game/ch7.rpy:2425
translate italian ch7_bj_k_afterpov_f8ede985:

    # mc "This can't be.."
    mc "Questo non può essere.."

# game/ch7.rpy:2426
translate italian ch7_bj_k_afterpov_c3786cda:

    # a "What's wrong?"
    a "Cosa c'è che non va?"

# game/ch7.rpy:2427
translate italian ch7_bj_k_afterpov_967a603b:

    # mc "You really don't know how to swing?"
    mc "Davvero non sai come oscillare?"

# game/ch7.rpy:2428
translate italian ch7_bj_k_afterpov_10db5c8d:

    # a "I didn't know it was a sin not to know how to use a swing."
    a "Non sapevo che fosse un peccato non sapere come usare un'altalena."

# game/ch7.rpy:2429
translate italian ch7_bj_k_afterpov_ff19b38a:

    # mc "You never got on a swing as a child?"
    mc "Da bambino non sei mai salito su un'altalena?"

# game/ch7.rpy:2430
translate italian ch7_bj_k_afterpov_601a455f:

    # a "No, but swinging that high certainly doesn't appeal to me either."
    a "No, ma oscillare così in alto di certo non attira neanche me."

# game/ch7.rpy:2431
translate italian ch7_bj_k_afterpov_197d035c:

    # mc "Don't worry, you'll learn in a moment."
    mc "Non preoccuparti, imparerai tra un attimo."

# game/ch7.rpy:2433
translate italian ch7_bj_k_afterpov_1a79256d:

    # a "I mean, I know I can do it."
    a "Voglio dire, so che posso farcela."

# game/ch7.rpy:2434
translate italian ch7_bj_k_afterpov_31644dc5:

    # mc "Yes, and you will."
    mc "Sì, e lo farai."

# game/ch7.rpy:2437
translate italian ch7_bj_k_afterpov_585d2d75:

    # a "Yes, like I told you, I know I can do it, I just don't do it because-"
    a "Sì, come ti ho detto, so che posso farlo, solo che non lo faccio perché..."

# game/ch7.rpy:2438
translate italian ch7_bj_k_afterpov_d9993729:

    # mc "Now we'll see if that's true."
    mc "Ora vedremo se è vero."

# game/ch7.rpy:2439
translate italian ch7_bj_k_afterpov_efc6c5dd:

    # a "I really don't like-"
    a "Davvero non mi piace-"

# game/ch7.rpy:2441
translate italian ch7_bj_k_afterpov_16912d63:

    # a "[mc]!!!"
    a "[mc]!!!"

# game/ch7.rpy:2442
translate italian ch7_bj_k_afterpov_2b17caba:

    # mc "Hold on tight."
    mc "Tieni duro."

# game/ch7.rpy:2443
translate italian ch7_bj_k_afterpov_6da3c05a:

    # a "{size=+5}Just don't push me so-"
    a "{size=+5}Semplicemente non spingermi così-"

# game/ch7.rpy:2445
translate italian ch7_bj_k_afterpov_8e0ceb63:

    # a "{size=+6}High!!!"
    a "{size=+6}Alto!!!"

# game/ch7.rpy:2450
translate italian ch7_bj_k_afterpov_153b04e4:

    # a "That was fun."
    a "È stato divertente."

# game/ch7.rpy:2451
translate italian ch7_bj_k_afterpov_7b46ef71:

    # mc "I told you so."
    mc "Te l'avevo detto."

# game/ch7.rpy:2452
translate italian ch7_bj_k_afterpov_018f644a:

    # a "I think I've even gotten over my fear of heights a little bit."
    a "Penso di aver superato un po' anche la mia paura dell'altezza."

# game/ch7.rpy:2453
translate italian ch7_bj_k_afterpov_db96c5cf:

    # mc "Are you afraid of heights?"
    mc "hai paura delle altezze?"

# game/ch7.rpy:2454
translate italian ch7_bj_k_afterpov_f5c8d33a:

    # a "Yes!"
    a "SÌ!"

# game/ch7.rpy:2455
translate italian ch7_bj_k_afterpov_66496db6:

    # mc "Why didn't you tell me that!"
    mc "Perché non me lo hai detto!"

# game/ch7.rpy:2456
translate italian ch7_bj_k_afterpov_596ea0f0:

    # a "I tried to tell you, silly, I did but you didn't listen!"
    a "Ho provato a dirtelo, stupido, l'ho fatto ma non mi hai ascoltato!"

# game/ch7.rpy:2457
translate italian ch7_bj_k_afterpov_918fea83:

    # mc "I'm sorry."
    mc "Mi dispiace."

# game/ch7.rpy:2458
translate italian ch7_bj_k_afterpov_889774c6:

    # a "It was fun."
    a "È stato divertente."

# game/ch7.rpy:2459
translate italian ch7_bj_k_afterpov_807a1336:

    # mc "Look, the slide is unoccupied now."
    mc "Guarda, lo scivolo adesso non è occupato."

# game/ch7.rpy:2461
translate italian ch7_bj_k_afterpov_5b1d503c:

    # mc "Shall we slide?"
    mc "Scivoliamo?"

# game/ch7.rpy:2462
translate italian ch7_bj_k_afterpov_444a74d3:

    # a "Hmm, I don't know, it doesn't look very chewy."
    a "Hmm, non lo so, non sembra molto gommoso."

# game/ch7.rpy:2463
translate italian ch7_bj_k_afterpov_63ad5d45:

    # a "I don't think it'll hold us."
    a "Non penso che ci reggerà."

# game/ch7.rpy:2465
translate italian ch7_bj_k_afterpov_212ad1a2:

    # mc "Yes it will, these sets are designed to support the weight of several children at once."
    mc "Sì, questi set sono progettati per sostenere il peso di più bambini contemporaneamente."

# game/ch7.rpy:2466
translate italian ch7_bj_k_afterpov_33251efb:

    # a "Swings are one thing, but this is too much."
    a "Le altalene sono una cosa, ma questo è troppo."

# game/ch7.rpy:2468
translate italian ch7_bj_k_afterpov_a788d3a3:

    # a "Although I've never been on one of these, with the little house and all..."
    a "Anche se non sono mai stata su uno di questi, con la casetta e tutto il resto..."

# game/ch7.rpy:2470
translate italian ch7_bj_k_afterpov_8f723594:

    # mc "Let's just go up to the top, without sliding, do you think?"
    mc "Andiamo fino in cima, senza scivolare, che ne dici?"

# game/ch7.rpy:2471
translate italian ch7_bj_k_afterpov_a09a393d:

    # a "I don't know..."
    a "Non lo so..."

# game/ch7.rpy:2473
translate italian ch7_bj_k_afterpov_119177e1:

    # a "What if the janitor comes and scolds us... that would be super embarrassing..."
    a "E se arrivasse il custode e ci rimproverasse... sarebbe davvero imbarazzante..."

# game/ch7.rpy:2474
translate italian ch7_bj_k_afterpov_9d24d234:

    # mc "Come on, nothing will happen, drug addicts hang out up there all the time."
    mc "Andiamo, non succederà nulla, i tossicodipendenti stanno lì tutto il tempo."

# game/ch7.rpy:2475
translate italian ch7_bj_k_afterpov_f1ffb46e:

    # a "Yeah, but..."
    a "Si ma..."

# game/ch7.rpy:2477
translate italian ch7_bj_k_afterpov_bbb51c4f:

    # a "If the janitor tells us something you'll take the blame, got it?"
    a "Se il custode ci dice qualcosa ti prenderai la colpa, capito?"

# game/ch7.rpy:2478
translate italian ch7_bj_k_afterpov_014d78ee:

    # mc "Yes, yes, I will."
    mc "Sì, sì, lo farò."

# game/ch7.rpy:2482
translate italian ch7_bj_k_afterpov_760cc2c1:

    # mc "(Yummy...)"
    mc "(Delizioso...)"

# game/ch7.rpy:2485
translate italian ch7_bj_k_afterpov_02fcc311:

    # mc "So, did you change your mind?"
    mc "Allora, hai cambiato idea?"

# game/ch7.rpy:2486
translate italian ch7_bj_k_afterpov_d7ee22f5:

    # a "On the contrary, look how fragile it looks, this thing is going to break as soon as I sit down."
    a "Al contrario, guarda quanto sembra fragile, questa cosa si romperà non appena mi siedo."

# game/ch7.rpy:2487
translate italian ch7_bj_k_afterpov_77f93690:

    # a "Why don't you slide over and show me?"
    a "Perché non ti avvicini e me lo mostri?"

# game/ch7.rpy:2488
translate italian ch7_bj_k_afterpov_7661c675:

    # mc "I won't if you won't."
    mc "Non lo farò se non lo farai tu."

# game/ch7.rpy:2490
translate italian ch7_bj_k_afterpov_0a5250be:

    # a "You're not up to something, are you?"
    a "Non hai intenzione di fare qualcosa, vero?"

# game/ch7.rpy:2491
translate italian ch7_bj_k_afterpov_3d0549b5:

    # mc "I'm up to something?"
    mc "Ho qualcosa in mente?"

# game/ch7.rpy:2492
translate italian ch7_bj_k_afterpov_300ee45e:

    # a "Yeah, like forcefully throwing me down the slide or something?"
    a "Sì, come buttarmi con la forza giù dallo scivolo o qualcosa del genere?"

# game/ch7.rpy:2493
translate italian ch7_bj_k_afterpov_2b35b6fe_3:

    # mc "..."
    mc "..."

# game/ch7.rpy:2494
translate italian ch7_bj_k_afterpov_e34911ac:

    # a "Don't even think about it!"
    a "Non pensarci nemmeno!"

# game/ch7.rpy:2495
translate italian ch7_bj_k_afterpov_23aec5c6:

    # mc "Haha, I won't."
    mc "Ahah, non lo farò."

# game/ch7.rpy:2499
translate italian ch7_bj_k_afterpov_58ba1940:

    # a "Places like this bring back a lot of nostalgia for me."
    a "Posti come questo mi fanno tornare molta nostalgia."

# game/ch7.rpy:2500
translate italian ch7_bj_k_afterpov_5daf79d5:

    # a "A lot of memories of my mother come to mind."
    a "Mi vengono in mente tanti ricordi di mia madre."

# game/ch7.rpy:2502
translate italian ch7_bj_k_afterpov_28bc9893:

    # mc "What was she like?"
    mc "Com'era?"

# game/ch7.rpy:2503
translate italian ch7_bj_k_afterpov_1a2bbb1d:

    # a "She was a good person, somewhat strict but very loving."
    a "Era una brava persona, un po' severa ma molto affettuosa."

# game/ch7.rpy:2504
translate italian ch7_bj_k_afterpov_1d9a6563:

    # a "A model mother of the time."
    a "Una mamma modello dell'epoca."

# game/ch7.rpy:2505
translate italian ch7_bj_k_afterpov_5af14d60:

    # a "She suffered a lot before she died."
    a "Ha sofferto molto prima di morire."

# game/ch7.rpy:2506
translate italian ch7_bj_k_afterpov_e7b2aed0:

    # a "And when she did, it was a relief for both her and us."
    a "E quando lo fece, fu un sollievo sia per lei che per noi."

# game/ch7.rpy:2508
translate italian ch7_bj_k_afterpov_8709d0a7:

    # mc "Still, it had to be tough."
    mc "Tuttavia, doveva essere dura."

# game/ch7.rpy:2509
translate italian ch7_bj_k_afterpov_aab2bc03:

    # a "At first, because we all had hope that she would be cured."
    a "All'inizio perché tutti speravamo che guarisse."

# game/ch7.rpy:2510
translate italian ch7_bj_k_afterpov_1cdc062a:

    # a "She was diagnosed with stomach cancer. The hardest part was the journey to his passing."
    a "Le è stato diagnosticato un cancro allo stomaco. La parte più difficile è stato il viaggio verso la sua morte."

# game/ch7.rpy:2511
translate italian ch7_bj_k_afterpov_8d8f2ac4:

    # a "And the day he died I felt a lot of relief really."
    a "E il giorno in cui è morto ho provato davvero molto sollievo."

# game/ch7.rpy:2513
translate italian ch7_bj_k_afterpov_38584c5d:

    # a "And after she died it was hard too, with no father or mother to take care of me my aunt had to take care of me."
    a "E anche dopo la sua morte è stato difficile, senza padre o madre che si prendessero cura di me, mia zia ha dovuto prendersi cura di me."

# game/ch7.rpy:2514
translate italian ch7_bj_k_afterpov_04d7d0b0:

    # mc "And your siblings?"
    mc "E i tuoi fratelli?"

# game/ch7.rpy:2515
translate italian ch7_bj_k_afterpov_a149f108:

    # a "They went with my father before that."
    a "Sono andati con mio padre prima."

# game/ch7.rpy:2516
translate italian ch7_bj_k_afterpov_054c5ee0:

    # mc "I see."
    mc "Vedo."

# game/ch7.rpy:2518
translate italian ch7_bj_k_afterpov_86af78be:

    # mc "What was your aunt like?"
    mc "Com'era tua zia?"

# game/ch7.rpy:2519
translate italian ch7_bj_k_afterpov_d448c792:

    # a "She wasn't very nice really."
    a "Non era molto carina, davvero."

# game/ch7.rpy:2520
translate italian ch7_bj_k_afterpov_3b8ff0b2:

    # a "She was hard to live with, not that she didn't love me, I don't think she even loved her own children, heh.."
    a "Era difficile convivere con lei, non che non mi amasse, non credo che amasse nemmeno i suoi figli, eh..."

# game/ch7.rpy:2521
translate italian ch7_bj_k_afterpov_4e69c4da:

    # a "That was one more reason to leave."
    a "Era un motivo in più per partire."

# game/ch7.rpy:2522
translate italian ch7_bj_k_afterpov_fae6a5b3:

    # mc "Leave where?"
    mc "Partire dove?"

# game/ch7.rpy:2524
translate italian ch7_bj_k_afterpov_2f27a1f8:

    # a "Let's leave that topic aside, I don't want to bore you with my stories."
    a "Lasciamo da parte l'argomento, non voglio annoiarvi con i miei racconti."

# game/ch7.rpy:2525
translate italian ch7_bj_k_afterpov_403cbb1d:

    # mc "No, no, I'm interested to know."
    mc "No, no, mi interessa saperlo."

# game/ch7.rpy:2526
translate italian ch7_bj_k_afterpov_8e429574:

    # a "Well."
    a "BENE."

# game/ch7.rpy:2529
translate italian ch7_bj_k_afterpov_cea806e1:

    # a "One day he came [d], asked me to marry him, and that same day I ran away with him."
    a "Un giorno venne [d], mi chiese di sposarlo, e quello stesso giorno scappai con lui."

# game/ch7.rpy:2530
translate italian ch7_bj_k_afterpov_88ecd19d:

    # mc "How, did he come in through the window and steal you?"
    mc "Come è entrato dalla finestra e ti ha rapito?"

# game/ch7.rpy:2532
translate italian ch7_bj_k_afterpov_9993da03:

    # a "*Haha*, something like that."
    a "*Haha*, qualcosa del genere."

# game/ch7.rpy:2535
translate italian ch7_bj_k_afterpov_db1dc28b:

    # a "And we came to live in this town."
    a "E siamo venuti a vivere in questa città."

# game/ch7.rpy:2536
translate italian ch7_bj_k_afterpov_be3bbc00:

    # a "It was nice at the time, I was fulfilling my dream of having a husband, a house, a car..."
    a "Era bello in quel momento, stavo realizzando il mio sogno di avere un marito, una casa, un'auto..."

# game/ch7.rpy:2537
translate italian ch7_bj_k_afterpov_715e1af1:

    # a "Later I had [k] and [s]."
    a "Successivamente ho avuto [k] e [s]."

# game/ch7.rpy:2538
translate italian ch7_bj_k_afterpov_935809b3:

    # a "And my life was already perfect, or so I thought."
    a "E la mia vita era già perfetta, o almeno così pensavo."

# game/ch7.rpy:2539
translate italian ch7_bj_k_afterpov_db6c2464:

    # mc "I see. So the [drelat] [d] was sort of an escape for you, at least at the time."
    mc "Vedo. Quindi il [drelat] [d] è stato una sorta di via di fuga per te, almeno in quel momento."

# game/ch7.rpy:2540
translate italian ch7_bj_k_afterpov_c47e038a:

    # a "That's right... Plus I really was in love."
    a "Esatto... Inoltre ero davvero innamorato."

# game/ch7.rpy:2541
translate italian ch7_bj_k_afterpov_f7189ab5:

    # a "But gradually everything deteriorated."
    a "Ma gradualmente tutto è peggiorato."

# game/ch7.rpy:2542
translate italian ch7_bj_k_afterpov_bb8e4b4e_1:

    # a "..."
    a "..."

# game/ch7.rpy:2544
translate italian ch7_bj_k_afterpov_2aa21a92:

    # a "I stepped out of one cage into another, one with intangible bars that I built myself."
    a "Sono uscito da una gabbia in un'altra, una con sbarre immateriali che ho costruito io stesso."

# game/ch7.rpy:2545
translate italian ch7_bj_k_afterpov_b2b9e19d_1:

    # mc "What do you mean?"
    mc "Cosa intendi?"

# game/ch7.rpy:2549
translate italian ch7_bj_k_afterpov_69ba7e8c:

    # a "Since I was 17 years old I have dedicated myself to being a housewife and nothing else."
    a "Da quando avevo 17 anni mi sono dedicata a fare la casalinga e nient'altro."

# game/ch7.rpy:2550
translate italian ch7_bj_k_afterpov_bbbeb1f0:

    # a "I didn't finish high school, I don't have any work experience of any kind..."
    a "Non ho finito le scuole superiori, non ho alcuna esperienza lavorativa di alcun tipo..."

# game/ch7.rpy:2551
translate italian ch7_bj_k_afterpov_8ae15474:

    # a "Now I feel as if...{w=0.5} I am limiting myself because of my ineptitude."
    a "Ora mi sento come se...{w=0.5} Mi stessi limitando a causa della mia inettitudine."

# game/ch7.rpy:2552
translate italian ch7_bj_k_afterpov_81fa70de:

    # a "I feel incompetent, you know what I mean?"
    a "Mi sento un incompetente, capisci cosa intendo?"

# game/ch7.rpy:2554
translate italian ch7_bj_k_afterpov_9659a314:

    # mc "There are a lot of people who don't even have a basic educational degree."
    mc "Ci sono molte persone che non hanno nemmeno un titolo di studio di base."

# game/ch7.rpy:2555
translate italian ch7_bj_k_afterpov_1344184b:

    # a "I know. But I can't help feeling that way."
    a "Lo so. Ma non posso fare a meno di sentirmi così."

# game/ch7.rpy:2556
translate italian ch7_bj_k_afterpov_fb127180:

    # a "I married [d] too young thinking this would never end."
    a "Mi sono sposato [d] troppo giovane pensando che tutto questo non sarebbe mai finito."

# game/ch7.rpy:2558
translate italian ch7_bj_k_afterpov_62701a14:

    # a "I feel like I've somehow wasted my life."
    a "Mi sento come se in qualche modo avessi sprecato la mia vita."

# game/ch7.rpy:2559
translate italian ch7_bj_k_afterpov_2101db12:

    # a "If it weren't for my two daughters and you, I'd be sure of it."
    a "Se non fosse per te e le mie due figlie, ne sarei sicuro."

# game/ch7.rpy:2562
translate italian ch7_bj_k_afterpov_38d92aee:

    # mc "Don't say that."
    mc "Non dirlo."

# game/ch7.rpy:2563
translate italian ch7_bj_k_afterpov_1039e2de:

    # a "It's the truth."
    a "È la verità."

# game/ch7.rpy:2564
translate italian ch7_bj_k_afterpov_732ece62:

    # a "I've wasted my life being a kept woman, by a man who sees me as some kind of pet he just has to feed."
    a "Ho sprecato la mia vita essendo una donna mantenuta, da un uomo che mi vede come una specie di animale domestico a cui deve solo dare da mangiare."

# game/ch7.rpy:2565
translate italian ch7_bj_k_afterpov_d8a032d6:

    # a "The worst thing is that I've been the one who decided to make it that way myself."
    a "La cosa peggiore è che sono stato io a decidere di farlo da solo."

# game/ch7.rpy:2567
translate italian ch7_bj_k_afterpov_ae7de870:

    # mc "That's not true."
    mc "Non è vero."

# game/ch7.rpy:2568
translate italian ch7_bj_k_afterpov_46bebd77:

    # mc "You don't stay married to him [drelat] [d] because you need him."
    mc "Non rimani sposata con lui [drelat] [d] perché hai bisogno di lui."

# game/ch7.rpy:2569
translate italian ch7_bj_k_afterpov_340203da:

    # mc "You do it for your daughters, because you want to give them everything and that they don't lack a father, it's very different."
    mc "Lo fai per le tue figlie, perché vuoi dare loro tutto e che non manchi loro un padre, è molto diverso."

# game/ch7.rpy:2571
translate italian ch7_bj_k_afterpov_d0c475d5:

    # mc "About wasting your life...{w=0.5} I don't really know the true meaning of that."
    mc "A proposito di sprecare la tua vita...{w=0.5} Non ne conosco il vero significato."

# game/ch7.rpy:2572
translate italian ch7_bj_k_afterpov_30fd2d12:

    # mc "I just know that a little piece of that life that you wasted, you wasted on me."
    mc "So solo che un pezzettino di quella vita che hai sprecato, l'hai sprecato per me."

# game/ch7.rpy:2573
translate italian ch7_bj_k_afterpov_740055c7:

    # mc "When I got out of the hospital that day, no one believed I was going to recover from the aftermath."
    mc "Quando uscii dall'ospedale quel giorno, nessuno credeva che mi sarei ripreso dalle conseguenze."

# game/ch7.rpy:2574
translate italian ch7_bj_k_afterpov_bbc872e2:

    # mc "But you didn't give up, you took me to all my therapies."
    mc "Ma tu non ti sei arreso, mi hai portato a fare tutte le mie terapie."

# game/ch7.rpy:2575
translate italian ch7_bj_k_afterpov_0cee68ce:

    # mc "And now look at me, I'm fine because of you."
    mc "E ora guardami, sto bene grazie a te."

# game/ch7.rpy:2577
translate italian ch7_bj_k_afterpov_2a18efa2:

    # mc "That's why I'll do my best to make sure you don't feel like you've wasted your life from now on."
    mc "Ecco perché farò del mio meglio per assicurarmi che da ora in poi non ti senta come se avessi sprecato la tua vita."

# game/ch7.rpy:2580
translate italian ch7_bj_k_afterpov_0e1d1735:

    # a "Thank you, sweetheart."
    a "Grazie Tesoro."

# game/ch7.rpy:2608
translate italian ch7_bj_k_afterpov_61b34e93:

    # mc "When the day comes that you decide to divorce..."
    mc "Quando arriverà il giorno in cui deciderai di divorziare..."

# game/ch7.rpy:2609
translate italian ch7_bj_k_afterpov_96240060:

    # mc "If you let me...{w=0.5} I could take the role of [d]."
    mc "Se mi permetti...{w=0.5} potrei assumere il ruolo di [d]."

# game/ch7.rpy:2610
translate italian ch7_bj_k_afterpov_a20cefa7_3:

    # "..."
    "..."

# game/ch7.rpy:2613
translate italian ch7_bj_k_afterpov_e9560d6a:

    # a "What are you saying, [mc]?"
    a "Che cosa stai dicendo, [mc]?"

# game/ch7.rpy:2615
translate italian ch7_bj_k_afterpov_b8b084bc:

    # mc "I'm serious."
    mc "Dico sul serio."

# game/ch7.rpy:2616
translate italian ch7_bj_k_afterpov_ed0f5653:

    # mc "I'll get a job, and I'll support you in any way I can."
    mc "Troverò un lavoro e ti sosterrò in ogni modo possibile."

# game/ch7.rpy:2619
translate italian ch7_bj_k_afterpov_747f076e:

    # a "Thank you, l-{w=0.5} I'll take it under advisement."
    a "Grazie, l-{w=0.5} Lo prenderò in considerazione."

# game/ch7.rpy:2620
translate italian ch7_bj_k_afterpov_bb8e4b4e_2:

    # a "..."
    a "..."

# game/ch7.rpy:2622
translate italian ch7_bj_k_afterpov_ffa75bfb:

    # a "Well... let's go back home, I have to get dinner ready."
    a "Bene... torniamo a casa, devo preparare la cena."

# game/ch7.rpy:2623
translate italian ch7_bj_k_afterpov_84d9991b:

    # mc "Yes..."
    mc "SÌ..."

# game/ch7.rpy:2626
translate italian ch7_bj_k_afterpov_a15b8be9:

    # a "I'm going to make potato stew today, do you want to help me?"
    a "Oggi farò lo stufato di patate, vuoi aiutarmi?"

# game/ch7.rpy:2627
translate italian ch7_bj_k_afterpov_606e2d02:

    # mc "Sure."
    mc "Sicuro."

# game/ch7.rpy:2633
translate italian ch7_bj_k_afterpov_b499a65e:

    # a "First cut it in half and{w=1} -No, not like that, lengthwise."
    a "Prima taglialo a metà e{w=1} -No, non così, nel senso della lunghezza."

# game/ch7.rpy:2634
translate italian ch7_bj_k_afterpov_050de2a9:

    # mc "Hell, I've already stuck the knife in it."
    mc "Diavolo, ci ho già infilato il coltello."

# game/ch7.rpy:2636
translate italian ch7_bj_k_afterpov_82b9c435:

    # a "Don't worry, what's important is that it's in medium-sized cubes."
    a "Non preoccupatevi, l'importante è che sia a cubetti di media grandezza."

# game/ch7.rpy:2637
translate italian ch7_bj_k_afterpov_c14c584c:

    # mc "Well..."
    mc "BENE..."

# game/ch7.rpy:2640
translate italian ch7_bj_k_afterpov_8114a09f:

    # mc "Uh..."
    mc "Ehm..."

# game/ch7.rpy:2641
translate italian ch7_bj_k_afterpov_4848bdd6:

    # mc "(Fuck, she's pressing her breasts against me...)"
    mc "(Cazzo, sta premendo il seno contro di me...)"

# game/ch7.rpy:2642
translate italian ch7_bj_k_afterpov_f2a96a20:

    # mc "(I wonder if she's doing it on purpose.)"
    mc "(Mi chiedo se lo stia facendo apposta.)"

# game/ch7.rpy:2643
translate italian ch7_bj_k_afterpov_30350112:

    # a "No fear, [mc], it doesn't have to be so perfect either."
    a "Niente paura, [mc], non deve nemmeno essere così perfetto."

# game/ch7.rpy:2645
translate italian ch7_bj_k_afterpov_dde1d44e:

    # mc "It makes me nervous that you're watching closely as I do it."
    mc "Mi rende nervoso il fatto che tu mi osservi da vicino mentre lo faccio."

# game/ch7.rpy:2646
translate italian ch7_bj_k_afterpov_697ae4e2:

    # a "Are you afraid of a couple of potatoes?"
    a "Hai paura di un paio di patate?"

# game/ch7.rpy:2647
translate italian ch7_bj_k_afterpov_16a285d3:

    # mc "No, haha. {w=1} (I'm nervous about another pair...)"
    mc "No, ahah. {w=1} (Sono nervoso per un altro paio...)"

# game/ch7.rpy:2650
translate italian ch7_bj_k_afterpov_d817568a:

    # mc "I think one of the best things a person can learn is how to cook."
    mc "Penso che una delle cose migliori che una persona possa imparare sia cucinare."

# game/ch7.rpy:2651
translate italian ch7_bj_k_afterpov_54210bcc:

    # mc "People who know how to cook well are always surrounded by friends."
    mc "Le persone che sanno cucinare bene sono sempre circondate da amici."

